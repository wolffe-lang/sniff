//! member: false
// How the session names what gdb names: a line table's file as shown and as read.
use session

fn file_shown_row() {
    // DWARF 4, directory entry 0 (the compilation's own directory): the name as recorded, relative or not, as the
    // pinned gdb prints it (PAX's kernel: `./kmain_console.lu`, compiled in /pax/kernel)
    assert(session.line_file_shown(4, 0, "./kmain_console.lu", "", "/pax/kernel") == "./kmain_console.lu")
    assert(session.line_file_shown(4, 0, "/work/fixtures/wolf/nested/main.lu", "", "/work") == "/work/fixtures/wolf/nested/main.lu")
    // DWARF 5's directory 0 is an entry of its own, the compilation directory, joined as the others are
    assert(session.line_file_shown(5, 0, "main.c", "", "/work/fixtures/session/c/calls") == "/work/fixtures/session/c/calls/main.c")
    // a directory entry that is a path of its own
    assert(session.line_file_shown(4, 1, "stdio.h", "/usr/include", "/work") == "/usr/include/stdio.h")
    assert(session.line_file_shown(5, 2, "stdio.h", "/usr/include", "/work") == "/usr/include/stdio.h")
    print("PASS session-file-shown")
}

fn file_path_row() {
    // the source is read where the compilation's directory puts it
    assert(session.line_file_path(4, 0, "./kmain_console.lu", "", "/pax/kernel") == "/pax/kernel/./kmain_console.lu")
    assert(session.line_file_path(4, 0, "/work/fixtures/wolf/nested/main.lu", "", "/work") == "/work/fixtures/wolf/nested/main.lu")
    assert(session.line_file_path(5, 0, "main.c", "", "/work/c") == "/work/c/main.c")
    assert(session.line_file_path(4, 1, "stdio.h", "/usr/include", "/work") == "/usr/include/stdio.h")
    print("PASS session-file-path")
}

fn code_symbols_row() {
    // st_info is the binding << 4 | the type: FUNC 2, OBJECT 1, NOTYPE 0; GLOBAL 1, LOCAL 0
    let func_global: u64 = 18
    let notype_global: u64 = 16
    let notype_local: u64 = 0
    let object_global: u64 = 17
    let at: u64 = 18446744071562067968
    assert(session.elf_code_symbol(func_global, at, 1, true))
    assert(!session.elf_code_symbol(func_global, 0, 1, true))
    assert(!session.elf_code_symbol(func_global, at, 0, true))
    assert(!session.elf_code_symbol(object_global, at, 3, false))
    // a global symbol with no type in a section of code (PAX's kernel's `_start`): the pinned gdb names
    // frames and addresses past it by it (`in _start ()`, `<_start>`)
    assert(session.elf_code_symbol(notype_global, at, 1, true))
    assert(!session.elf_code_symbol(notype_global, at, 3, false))
    assert(!session.elf_code_symbol(notype_local, at, 1, true))
    print("PASS session-code-symbols")
}

fn file_address_row() {
    // a position-independent program loaded at 0x555555554000 (the pinned gdb's, with randomisation off)
    let base: u64 = 93824992231424
    let (ok, file) = session.file_address(base + 4509, base)
    assert(ok && file == 4509)
    // an address below the program, as `x/2xg 0` names: no file address, and no trap (sniff's own crash, measured)
    let (low, _) = session.file_address(0, base)
    assert(!low)
    let (at_base, zero) = session.file_address(base, base)
    assert(at_base && zero == 0)
    // a program not moved (a static one, PAX's kernel): every address is its own
    let (k, same) = session.file_address(18446744071562067968, 0)
    assert(k && same == 18446744071562067968)
    print("PASS session-file-address")
}

fn main() {
    file_shown_row()
    file_path_row()
    code_symbols_row()
    file_address_row()
}
