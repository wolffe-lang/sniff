//! member: false

use readers

fn dwarf_put(mut data: List[byte], value: u64, width: int) {
    var i: int = 0
    while i < width {
        let octet = (value >> (i * 8) as u64 & 255) as int as byte
        (mut data).push(octet)
        i += 1
    }
}

fn dwarf_fixture(version: int, wide: bool, address_size: int, kind: int) -> List[byte] {
    var data: List[byte] = []
    let offset_size = if wide { 8 } else { 4 }
    let body_length = if version == 4 { 4 + offset_size } else { 5 + offset_size }
    if wide {
        dwarf_put(mut data, 4294967295, 4)
        dwarf_put(mut data, body_length as u64, 8)
    } else {
        dwarf_put(mut data, body_length as u64, 4)
    }
    dwarf_put(mut data, version as u64, 2)
    if version == 4 {
        dwarf_put(mut data, 12, offset_size)
        dwarf_put(mut data, address_size as u64, 1)
    } else {
        dwarf_put(mut data, kind as u64, 1)
        dwarf_put(mut data, address_size as u64, 1)
        dwarf_put(mut data, 12, offset_size)
    }
    dwarf_put(mut data, 0, 1)
    data
}

fn dwarf_headers() {
    for version in [4, 5] {
        for wide in [false, true] {
            for address_size in [4, 8] {
                let data = dwarf_fixture(version, wide, address_size, 1)
                var c = readers.cursor(0, data.len, 100)
                let unit = readers.dwarf_unit_header(data, mut c) else { assert(false); return }
                assert(unit.start == 0 && unit.end == data.len)
                assert(unit.body == c.pos && unit.body == data.len - 1)
                assert(unit.version == version && unit.address_size == address_size)
                assert(unit.offset_size == if wide { 8 } else { 4 })
                assert(unit.abbrev == 12)
            }
        }
    }
    print("PASS dwarf-unit-widths")
}

fn dwarf_header_refusals() {
    let short: List[byte] = [255 as byte, 255 as byte, 255 as byte, 255 as byte]
    var a = readers.cursor(0, short.len, 100)
    let a_result = readers.dwarf_unit_header(short, mut a)
    assert("{a_result}" == "truncated")
    let reserved: List[byte] = [240 as byte, 255 as byte, 255 as byte, 255 as byte]
    var b = readers.cursor(0, reserved.len, 100)
    let b_result = readers.dwarf_unit_header(reserved, mut b)
    assert("{b_result}" == "reserved_dwarf_length")
    var oversized: List[byte] = []
    dwarf_put(mut oversized, 4294967295, 4)
    dwarf_put(mut oversized, 18446744073709551615, 8)
    var c = readers.cursor(0, oversized.len, 100)
    let c_result = readers.dwarf_unit_header(oversized, mut c)
    assert("{c_result}" == "truncated")
    let version = dwarf_fixture(3, false, 8, 1)
    var d = readers.cursor(0, version.len, 100)
    let d_result = readers.dwarf_unit_header(version, mut d)
    assert("{d_result}" == "unsupported_dwarf_version")
    let split = dwarf_fixture(5, false, 8, 5)
    var e = readers.cursor(0, split.len, 100)
    let e_result = readers.dwarf_unit_header(split, mut e)
    assert("{e_result}" == "unsupported_split_dwarf")
    let size = dwarf_fixture(5, false, 16, 1)
    var f = readers.cursor(0, size.len, 100)
    let f_result = readers.dwarf_unit_header(size, mut f)
    assert("{f_result}" == "unsupported_address_size")
    print("PASS dwarf-unit-refusals")
}

fn dwarf_abbreviation_rows() {
    let data: List[byte] = [
        1 as byte,
        17 as byte,
        1 as byte,
        3 as byte,
        8 as byte,
        19 as byte,
        33 as byte,
        127 as byte,
        0 as byte,
        0 as byte,
        0 as byte,
    ]
    var c = readers.cursor(0, data.len, 100)
    let table = readers.dwarf_abbrevs(data, mut c, 10, 10) else { assert(false); return }
    assert(table.len == 1 && c.pos == data.len)
    assert(table[0].code == 1 && table[0].tag == 17 && table[0].children)
    assert(table[0].attrs.len == 2)
    assert(table[0].attrs[1].form == 33 && table[0].attrs[1].implicit == -1)
    var limited = readers.cursor(0, data.len, 100)
    let limit_result = readers.dwarf_abbrevs(data, mut limited, 0, 10)
    assert("{limit_result}" == "resource_limit")
    let duplicate: List[byte] = [
        1 as byte,
        17 as byte,
        0 as byte,
        0 as byte,
        0 as byte,
        1 as byte,
        17 as byte,
        0 as byte,
        0 as byte,
        0 as byte,
        0 as byte,
    ]
    var d = readers.cursor(0, duplicate.len, 100)
    let d_result = readers.dwarf_abbrevs(duplicate, mut d, 10, 10)
    assert("{d_result}" == "duplicate_abbreviation")
    let invalid: List[byte] = [1 as byte, 17 as byte, 2 as byte, 0 as byte, 0 as byte, 0 as byte]
    var i = readers.cursor(0, invalid.len, 100)
    let i_result = readers.dwarf_abbrevs(invalid, mut i, 10, 10)
    assert("{i_result}" == "invalid_abbreviation")
    print("PASS dwarf-abbreviations")
}

fn main() {
    dwarf_headers()
    dwarf_header_refusals()
    dwarf_abbreviation_rows()
}
