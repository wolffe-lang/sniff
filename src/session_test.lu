//! member: false
use session

fn main() -> int {
    let args = env_args()
    let p = session.prog_load(args[0])
    print("err={p.err} units={p.units.len} files={p.files.len} lines={p.lines.len} funcs={p.funcs.len} syms={p.syms.len}")
    var i = 0
    while i < p.funcs.len {
        print("func {p.funcs[i].name} {p.funcs[i].low:x}-{p.funcs[i].high:x} line {p.funcs[i].line}")
        i += 1
    }
    i = 0
    while i < p.files.len { print("file {i} {p.files[i]}"); i += 1 }
    0
}
