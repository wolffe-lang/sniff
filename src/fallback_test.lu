//! member: false
// The frame-pointer fallback (x86-64): which rule a frame with no call frame information takes.
use session

fn rules_row() {
    // in code the session knows: a ret and a function's first instruction take the return address at the stack
    // pointer, the instruction after `push %rbp` finds it one slot up, and anywhere else the frame pointer's chain
    assert(session.fallback_rule(true, true, false, false) == session.unwind_at_entry)
    assert(session.fallback_rule(true, false, true, false) == session.unwind_at_entry)
    assert(session.fallback_rule(true, false, false, true) == session.unwind_after_push)
    assert(session.fallback_rule(true, false, false, false) == session.unwind_frame_pointer)
    print("PASS session-fallback-rules")
}

fn nowhere_row() {
    // a pc in no code (a call through a null pointer stops at 0): the call has just pushed the return address and
    // the frame pointer is still the caller's, so the caller is read from the top of the stack (measured: the
    // pinned gdb names apply, the function that made the call, as frame 1)
    assert(session.fallback_rule(false, false, false, false) == session.unwind_at_entry)
    assert(session.fallback_rule(false, false, false, true) == session.unwind_at_entry)
    print("PASS session-fallback-nowhere")
}

fn after_frame_row() {
    // after a frame, gdb's rules (the GDB manual's backtrace past-main and past-entry, both off by default): stop at
    // main, and at the function holding the program's entry point, before any caller
    assert(session.unwind_after(true, false, true, 4096, true) == session.unwind_stop)
    assert(session.unwind_after(false, true, true, 4096, true) == session.unwind_stop)
    // no caller: stop
    assert(session.unwind_after(false, false, false, 4096, true) == session.unwind_stop)
    // a caller at pc 0 is shown as the last frame where gdb shows it (measured: QEMU's reset vector gives frame 1 at
    // 0x0), and not where the oracle shows none
    assert(session.unwind_after(false, false, true, 0, true) == session.unwind_last_zero)
    assert(session.unwind_after(false, false, true, 0, false) == session.unwind_stop)
    // otherwise the caller is the next frame
    assert(session.unwind_after(false, false, true, 4096, true) == session.unwind_go_on)
    print("PASS session-unwind-after")
}

fn arm64_before_row() {
    // the instruction before pc: none below 4, where a call through a null pointer stops (sniff trapped there)
    let (low, _) = session.arm64_insn_before(0)
    assert(!low)
    let (three, _) = session.arm64_insn_before(3)
    assert(!three)
    let at: u64 = 4295000904
    let (ok, before) = session.arm64_insn_before(at)
    assert(ok && before == at - 4)
    print("PASS session-arm64-insn-before")
}

fn arm64_lr_row() {
    // innermost at a pc whose instruction cannot be read: the call has just set the link register and built no
    // frame, so the caller is lr and the frame is unchanged (measured: Apple's lldb names apply as frame 1, at lr)
    assert(session.arm64_lr_rule(0, false))
    assert(!session.arm64_lr_rule(0, true))
    assert(!session.arm64_lr_rule(1, false))
    print("PASS session-arm64-lr-rule")
}

fn main() {
    after_frame_row()
    rules_row()
    nowhere_row()
    arm64_before_row()
    arm64_lr_row()
}
