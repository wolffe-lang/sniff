// `target remote`: the session over a stub (the GDB manual's Connecting node) as the third source of what a
// stopped program answers (source.lu), beside a process and a core. sniff connects over TCP only, and to one
// target: QEMU's gdbstub on a kernel, whose threads are its processors. The words
// of each refusal are the pinned gdb's, as its transcripts showed them, where the manual gives none.

use platform
use remote
use std.signal

/// The x86-64 register slots in the platform's order (Linux's user_regs_struct), by the names a target
/// description gives them: a slot the description has no register for (orig_rax) reads 0.
fn remote_slot_names() -> List[str] {
    ["r15", "r14", "r13", "r12", "rbp", "rbx", "r11", "r10", "r9", "r8", "rax", "rcx", "rdx", "rsi", "rdi", "orig_rax",
     "rip", "cs", "eflags", "rsp", "ss", "fs_base", "gs_base", "ds", "es", "fs", "gs"]
}

/// The stopped target's registers in the platform's slots, by one `g`.
fn remote_read_regs(s: Session) -> List[u64] {
    if s.rt.len == 0 { return [] }
    let (regs, unread) = remote.peek_regs(s.rt[0]) else { return [] }
    var out: List[u64] = []
    for n in remote_slot_names() {
        let v = remote.reg_in(s.rt[0], regs, unread, n) else { 0 }
        (mut out).push(v)
    }
    out
}

/// The registers, read once a stop and kept until the target runs again.
fn remote_regs(s: Session) -> List[u64] {
    if s.rt_regs_ok { return copy s.rt_regs }
    remote_read_regs(s)
}

/// Read the registers into the session's copy (after a connect or a stop).
fn remote_refresh(mut s: Session) {
    s.rt_regs = remote_read_regs(s)
    s.rt_regs_ok = s.rt_regs.len > 0
}

/// Select the CPU for subsequent reads, invalidating both register and frame caches.
fn remote_select(mut s: Session, i: int) -> bool {
    if s.rt.len == 0 || i < 0 || i >= s.thr.len { return false }
    remote.select_thread(mut s.rt[0], remote.hex_u64(s.thr[i].tid as u64)) else { return false }
    s.thr_cur = i
    s.frames_ok = false
    true
}

/// The processor that actually reported the last stop, not the one a later thread command selected.
fn remote_event_thread(s: Session) -> int {
    if s.rt.len == 0 { return 0 }
    let tid = remote.parse_hex(s.rt[0].stop.thread.bytes()) else { return 0 }
    if tid == 0 || tid > 1073741823 { return 0 }
    tid as int
}

/// n bytes at addr from the stopped target; a short read is a failed one, as a process's is.
fn remote_mem(s: Session, addr: u64, n: int) -> platform.Bytes {
    let none: List[byte] = []
    if s.rt.len == 0 { return platform.Bytes { ok: false, data: none } }
    let d = remote.read_mem(s.rt[0], addr, n) else { return platform.Bytes { ok: false, data: none } }
    platform.Bytes { ok: d.len == n, data: d }
}

/// gdb's plain target id in current-thread and switching messages.
fn remote_thread_id(s: Session, i: int) -> str { "Thread 1.{s.thr[i].tid}" }

/// The thread table alone adds the stub's extra information.
fn remote_thread_table_id(s: Session, i: int) -> str {
    if s.rt.len == 0 { return "Thread 1.{s.thr[i].tid}" }
    let id = remote.hex_u64(s.thr[i].tid as u64)
    let extra = remote.thread_extra(s.rt[0], id) else { return "Thread 1.{s.thr[i].tid}" }
    if extra.len() == 0 { return "Thread 1.{s.thr[i].tid}" }
    "Thread 1.{s.thr[i].tid} ({extra})"
}

/// The remote thread's name as the protocol carries it (`sniff --dap`'s threads): what qThreadExtraInfo names, as
/// the pinned gdb names it over QEMU's gdbstub (`CPU#0 [running]`); `Thread 1.N` when the stub names nothing.
fn remote_thread_name(s: Session, i: int) -> str {
    if s.rt.len == 0 { return "Thread 1.{s.thr[i].tid}" }
    let extra = remote.thread_extra(s.rt[0], remote.hex_u64(s.thr[i].tid as u64)) else { return "Thread 1.{s.thr[i].tid}" }
    if extra.len() == 0 { return "Thread 1.{s.thr[i].tid}" }
    extra
}

/// The first n bytes of t.
fn remote_prefix(t: str, n: int) -> str {
    let b = t.bytes()
    var out: List[byte] = []
    var i = 0
    while i < n && i < b.len { (mut out).push(b[i]); i += 1 }
    str_from_utf8(out) else { "" }
}

/// gdb's paragraph for `target remote` with no address.
fn remote_no_address() -> str {
    "To open a remote debug connection, you need to specify what\nserial device is attached to the remote system\n(e.g. /dev/ttyS0, /dev/ttya, COM1, etc.)."
}

/// `target remote ADDRESS` (Connecting): HOST:PORT, :PORT (this machine) or tcp:HOST:PORT. sniff's own words
/// refuse the forms it does not take (a serial device, a pipe to a command, udp).
fn cmd_target(mut s: Session, rest: str) -> str {
    let t = rest.trim()
    if t.len() == 0 { return "Argument required (target name)." }
    let words = t.split(" ")
    if words[0] != "remote" { return "sniff connects with `target remote HOST:PORT` only." }
    let addr = str_from(t, 6).trim()
    if addr.len() == 0 { return remote_no_address() }
    var a = addr
    if a.starts_with("tcp:") { a = str_from(a, 4) }
    if a.starts_with("|") || a.starts_with("udp:") || a.starts_with("/") {
        return "sniff connects over TCP only: `{addr}` is not HOST:PORT."
    }
    let b = a.bytes()
    var colon = -1
    var i = 0
    while i < b.len {
        if b[i] as int == 58 { colon = i }
        i += 1
    }
    if colon < 0 { return "sniff connects over TCP only: `{addr}` is not HOST:PORT." }
    var host = remote_prefix(a, colon)
    let port = str_from(a, colon + 1)
    if port.len() == 0 { return "Missing port on hostname '{addr}'" }
    if !all_digits(port) { return "sniff connects over TCP only: `{port}` is not a port number." }
    if host.len() == 0 { host = "127.0.0.1" }
    // as the pinned gdb does (measured): a port past 65535 reaches the port it wraps to
    let p = parse_number(port) % 65536
    // sniff's own: gdb asks whether to kill the program it has, which a command file cannot answer
    if s.alive { return "A program is being debugged already." }
    if s.core_on { core_drop(mut s) }
    let target = remote.connect("{host}:{p}") else |e| match e {
        refused => { return "could not connect: Connection refused." },
        timeout => { return "could not connect: Connection timed out." },
        _ => { return "could not connect: {e}." },
    }
    let (ids, selected) = remote.thread_ids(target.threads, target.current) else {
        remote.disconnect(take target) else { }
        return "could not connect: bad_reply."
    }
    s.rt = [target]
    s.remote_on = true
    s.alive = true
    s.attached = true
    s.base = 0
    s.libs = []
    s.watch_armed = false
    s.pending_signal = 0
    s.signal_given = false
    s.frames = []
    s.frames_ok = false
    s.thr = []
    for tid in ids {
        (mut s.thr).push(Thr { num: s.thr.len + 1, tid: tid, tls: 0, running: false, pending: 0 - 1, expect_stop: false })
    }
    s.thr_cur = selected
    s.thr_next = s.thr.len + 1
    s.thr_multi = s.thr.len > 1
    s.thr_prev = s.thr[selected].tid
    s.early = []
    if !remote_select(mut s, selected) { remote_forget(mut s); return "could not connect: bad_reply." }
    remote_refresh(mut s)
    emit_line(mut s, "Remote debugging using {addr}")
    // the pinned gdb reports the stop a connect finds as a signal when the last stop it reported was one (measured)
    if s.rt_signalled {
        emit_line(mut s, "")
        emit_line(mut s, "Program received signal SIGTRAP, Trace/breakpoint trap.")
    }
    print_stop_frame(mut s, true, "")
    ""
}

/// Drop the remote target from the session (its connection is closed or let go already).
fn remote_forget(mut s: Session) {
    while s.rt.len > 0 {
        let target = (mut s.rt).pop() else { break }
        remote.disconnect(take target) else { }
    }
    s.rt = []
    s.remote_on = false
    s.alive = false
    s.attached = false
    s.rt_regs = []
    s.rt_regs_ok = false
    s.thr = []
    s.frames = []
    s.frames_ok = false
}

/// `disconnect` (Connecting): close the connection and send nothing; the target stays stopped.
fn cmd_disconnect(mut s: Session, rest: str) -> str {
    if !s.remote_on {
        if s.alive { return "You can't do that when your target is `native'" }
        return "You can't do that when your target is `exec'"
    }
    let t = (mut s.rt).pop() else { return "" }
    remote.disconnect(take t) else { }
    remote_forget(mut s)
    emit_line(mut s, "Ending remote debugging.")
    ""
}

/// `detach` over a remote target: `D`, and gdb's three lines.
fn remote_detach(mut s: Session) {
    if s.tty { emit_line(mut s, "Detaching from program: {s.prog.path}, process 1") }
    let t = (mut s.rt).pop() else { return }
    remote.detach(take t) else { }
    remote_forget(mut s)
    emit_line(mut s, "Ending remote debugging.")
    emit_line(mut s, "[Inferior 1 (process 1) detached]")
}

/// `kill` over a remote target: `k`, after which the stub need not answer.
fn remote_kill(mut s: Session) {
    let t = (mut s.rt).pop() else { return }
    remote.kill(take t) else { }
    remote_forget(mut s)
    emit_line(mut s, "[Inferior 1 (process 1) killed]")
}

/// Insert a breakpoint at a: `Z0` (with the covered byte read first, which later reads show in its place), or
/// `Z1` for hbreak. False when the stub refuses it (an address it cannot map yet, as under KVM before paging).
fn remote_insert(mut s: Session, a: u64, hw: bool) -> bool {
    if s.rt.len == 0 { return false }
    var ok = true
    if hw {
        remote.insert_point(mut s.rt[0], 1, a, 1) else { ok = false }
    } else {
        remote.insert_break(mut s.rt[0], a) else { ok = false }
    }
    ok
}

/// Remove what remote_insert inserted.
fn remote_remove(mut s: Session, a: u64, hw: bool) {
    if s.rt.len == 0 { return }
    if hw {
        remote.remove_point(mut s.rt[0], 1, a, 1) else { }
    } else {
        remote.remove_break(mut s.rt[0], a) else { }
    }
}

/// Resume the remote target (one instruction when step): vCont when the stub lists it, else `c` or `s`.
/// The terminal's interrupt is heard as an event from now until the stop.
fn remote_resume(mut s: Session, step: bool) -> bool {
    if s.rt.len == 0 { return false }
    s.rt_regs_ok = false
    s.frames_ok = false
    s.rt_signalled = false
    flush_out(mut s)
    signal.listen(signal.interrupt()) else { }
    var ok = true
    remote.resume(mut s.rt[0], step) else { ok = false }
    ok
}

/// Wait for the remote target's stop, in 100 ms waits: between them a terminal interrupt (SIGINT) is sent on as
/// the interrupt byte 0x03 (Interrupts), and the wait goes on for its stop reply. Under `sniff --dap` the client is
/// heard between the waits instead (dapserve.lu's dap_poll): a pause, a disconnect or terminate, or the end of its
/// input sends the interrupt byte once. The stop as a wait status, as
/// classify() reads a process's: a signal stop is (signal << 8) | 0x7f, an exit its status << 8, a kill its
/// signal; -1 for a lost connection.
fn remote_wait(mut s: Session) -> int {
    if s.rt.len == 0 { return 0 - 1 }
    var waiting = true
    var lost = false
    var interrupted = false
    while waiting {
        var timed = false
        remote.wait_stop(mut s.rt[0], 100) else |e| match e {
            reply_timeout => { timed = true },
            _ => { lost = true },
        }
        if lost { waiting = false } else if timed {
            if s.adapter.on {
                dap_poll(mut s, 0)
                let asked = s.adapter.pause_asked || s.adapter.ending.len > 0 || s.adapter.eof
                if asked && !interrupted && s.rt.len > 0 {
                    remote.interrupt_target(s.rt[0]) else { }
                    interrupted = true
                }
            } else {
                let heard = signal.poll(signal.interrupt()) else { 0 }
                if heard != 0 { remote.interrupt_target(s.rt[0]) else { } }
            }
        } else {
            waiting = false
        }
    }
    if lost {
        remote_forget(mut s)
        return 0 - 1
    }
    let kind = s.rt[0].stop.kind
    let code = s.rt[0].stop.code
    if kind == remote.stop_signal {
        let tid = remote.parse_hex(s.rt[0].current.bytes()) else { remote_forget(mut s); return 0 - 1 }
        if tid > 1073741823 { remote_forget(mut s); return 0 - 1 }
        let at = thr_index(s, tid as int)
        if at < 0 || !remote_select(mut s, at) { remote_forget(mut s); return 0 - 1 }
    }
    remote_disarm_watches(mut s)
    remote_refresh(mut s)
    if kind == remote.stop_exited { return code * 256 }
    if kind == remote.stop_killed { return code }
    code * 256 + 127
}

/// The enabled watches as the stub's points (Packets: Z2 write, Z3 read, Z4 access, KIND the length), inserted
/// before a resumption and taken out at the stop (remote_wait). "" or sniff's words for a refused one.
fn remote_arm_watches(mut s: Session) -> str {
    if s.rt.len == 0 { return "" }
    var i = 0
    while i < s.watches.len {
        if s.watches[i].enabled {
            let kind = if s.watches[i].kind == wk_write { 2 } else if s.watches[i].kind == wk_read { 3 } else { 4 }
            let a = s.watches[i].addr
            let n = s.watches[i].len
            var ok = true
            remote.insert_point(mut s.rt[0], kind, a, n) else { ok = false }
            if !ok {
                remote_disarm_watches(mut s)
                return "Could not insert hardware watchpoint {s.watches[i].num}."
            }
            (mut s.rt_points).push(kind)
            (mut s.rt_point_addrs).push(a)
            (mut s.rt_point_lens).push(n)
        }
        i += 1
    }
    ""
}

/// Take the watches' points out of the stub.
fn remote_disarm_watches(mut s: Session) {
    var i = 0
    while i < s.rt_points.len {
        let kind = s.rt_points[i]
        let a = s.rt_point_addrs[i]
        let n = s.rt_point_lens[i]
        if s.rt.len > 0 { remote.remove_point(mut s.rt[0], kind, a, n) else { } }
        i += 1
    }
    s.rt_points = []
    s.rt_point_addrs = []
    s.rt_point_lens = []
}

/// Which enabled watch the stop reply names (its `watch`, `rwatch` or `awatch` reason and data address), counted
/// among the enabled ones as a platform's slot is; -1 when the stop was not a watchpoint's.
fn remote_watch_slot(s: Session) -> int {
    if s.rt.len == 0 { return 0 - 1 }
    let why = s.rt[0].stop.reason
    if why != "watch" && why != "rwatch" && why != "awatch" { return 0 - 1 }
    let at = s.rt[0].stop.addr
    var k = 0
    var i = 0
    while i < s.watches.len {
        if s.watches[i].enabled {
            if at >= s.watches[i].addr && at < s.watches[i].addr + (s.watches[i].len as u64) { return k }
            k += 1
        }
        i += 1
    }
    0 - 1
}
