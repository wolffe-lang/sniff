// Frames: the stack of a stopped child, innermost first, from CFI where an
// FDE covers the pc and from the frame pointer (with the standard prologue
// and epilogue cases) where none does.

use platform

/// One frame of the stack.
struct Frame {
    pub pc: u64,
    pub cfa: u64,
    pub regs: List[u64],
    pub func: int,
    pub fallback: bool,
    pub cfa_ok: bool,
    /// How this frame was unwound: "cfi", "compact", "prologue" or "frame-pointer".
    pub basis: str,
}

/// The register list in DWARF column order (platform.arch_dwarf_regs).
fn dwarf_regs(r: List[u64]) -> List[u64] { platform.arch_dwarf_regs(r) }

/// Index into prog.funcs of the DWARF function containing a file address, or -1.
fn func_at(p: Prog, addr: u64) -> int {
    var i = 0
    while i < p.funcs.len {
        if p.funcs[i].low <= addr && addr < p.funcs[i].high && p.funcs[i].low != 0 { return i }
        i += 1
    }
    -1
}

/// Whether an address lies inside an allocated section of the file.
fn in_image(p: Prog, addr: u64) -> bool {
    var i = 0
    while i < p.maps.len {
        if p.maps[i].addr <= addr && addr < p.maps[i].addr + p.maps[i].size { return true }
        i += 1
    }
    false
}

/// Whether name a sorts after name b, byte by byte (a longer name after its own prefix).
fn name_after(a: str, b: str) -> bool {
    let x = a.bytes()
    let y = b.bytes()
    var i = 0
    while i < x.len && i < y.len {
        if x[i] != y[i] { return (x[i] as int) > (y[i] as int) }
        i += 1
    }
    x.len > y.len
}

/// Index into prog.syms of the ELF function symbol containing a file address, or -1. Of several symbols
/// at one address (a C library's aliases: `__clone3` and `clone3`), the name that sorts last byte by
/// byte: the pinned gdb's choice in each of the 240 alias groups of a static glibc program, measured
/// with `info symbol` (the note's alias table).
fn sym_at(p: Prog, addr: u64) -> int {
    if !in_image(p, addr) { return -1 }
    var best = -1
    var i = 0
    while i < p.syms.len {
        let s = p.syms[i].addr
        if s <= addr && (addr < s + p.syms[i].size || (p.syms[i].size == 0 && best < 0)) {
            if best < 0 || p.syms[best].addr < s { best = i }
            else if p.syms[best].addr == s && name_after(p.syms[i].name, p.syms[best].name) { best = i }
        }
        i += 1
    }
    best
}

/// Start (file address) of the function containing addr by DWARF, else ELF symbol; 0 if unknown.
fn func_start(p: Prog, addr: u64) -> u64 {
    let f = func_at(p, addr)
    if f >= 0 { return p.funcs[f].low }
    let y = sym_at(p, addr)
    if y >= 0 { return p.syms[y].addr }
    0
}

/// The file address of the ELF symbol named main, or 0.
fn main_addr(p: Prog) -> u64 {
    var i = 0
    while i < p.syms.len {
        if p.syms[i].name == "main" { return p.syms[i].addr }
        i += 1
    }
    0
}

fn rd64(t: platform.Target, addr: u64) -> u64 ! {unreadable} {
    let r = platform.target_read(t, addr, 8)
    if !r.ok { return unreadable }
    var v: u64 = 0
    var i = 0
    while i < 8 {
        v = v | ((r.data[i] as int as u64) << (8 * i as u64))
        i += 1
    }
    v
}

fn byte_at(s: Session, addr: u64) -> int {
    let r = platform.target_read(s.target, addr, 1)
    if !r.ok { return -1 }
    r.data[0] as int
}

/// A frame whose CFA and caller registers come from the frame pointer, with
/// gdb's prologue/epilogue cases for a function with no CFI (x86-64).
fn unwind_fp_x86(s: Session, f: Frame) -> Frame ! {no_caller} {
    let rsp = f.regs[7]
    let rbp = f.regs[6]
    let pc = f.pc
    let fs = func_start(s.prog, pc - s.base) + s.base
    var cfa: u64 = rbp + 16
    var saved_rbp_at: u64 = rbp
    var rbp_saved = true
    if byte_at(s, pc) == 195 {
        // at ret: the frame is already torn down
        cfa = rsp + 8
        rbp_saved = false
    } else if fs != s.base {
        var a = fs
        if byte_at(s, a) == 243 && byte_at(s, a + 1) == 15 && byte_at(s, a + 2) == 30 && byte_at(s, a + 3) == 250 { a += 4 }
        if byte_at(s, a) == 85 {
            if pc <= a {
                cfa = rsp + 8
                rbp_saved = false
            } else if pc == a + 1 {
                cfa = rsp + 16
                saved_rbp_at = rsp
            }
        }
    }
    let ra = rd64(s.target, cfa - 8) else { return no_caller }
    var regs = copy f.regs
    if rbp_saved {
        let nb = rd64(s.target, saved_rbp_at) else { return no_caller }
        regs[6] = nb
    }
    regs[7] = cfa
    regs[16] = ra
    Frame { pc: ra, cfa: cfa, regs: regs, func: -1, fallback: true, cfa_ok: true, basis: "frame-pointer" }
}

/// The frame-pointer unwind for this machine; arm64 also uses compact unwind and its prologue analysis.
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn unwind_fp(s: Session, f: Frame, level: int) -> Frame ! {no_caller} { unwind_fp_x86(s, f) }

#[cfg(target = "aarch64-apple-darwin")]
fn unwind_fp(s: Session, f: Frame, level: int) -> Frame ! {no_caller} { unwind_arm64(s, f, level) }

/// Unwind through the CFI rules of fde. The CFA of frame f is filled in.
fn unwind_cfi(s: Session, f: Frame, fi: int, lookup: u64) -> Frame ! {no_caller} {
    let fdata = if s.cfi[fi].img { copy s.prog.img } else { copy s.prog.data }
    let r = cfi_rules(fdata, s.cfi[fi], lookup - s.base)
    let cols = platform.arch_cfi_cols()
    let ra = platform.arch_ra_col()
    let sp_col = platform.arch_sp_col()
    var cfa: u64 = 0
    if r.cfa_is_expr {
        let ctx = EvalCtx { regs: copy f.regs, frame_base: 0, has_frame_base: false, cfa: 0, has_cfa: false, base: s.base }
        let l = expr_eval(fdata, r.cfa_expr, ctx, s.target)
        if l.kind != loc_memory { return no_caller }
        cfa = l.value
    } else {
        if r.cfa_reg >= cols { return no_caller }
        cfa = add_i(f.regs[r.cfa_reg], r.cfa_off)
    }
    var regs = copy f.regs
    var i = 0
    // arm64's link register keeps its value in a leaf, so "same value" is a known return address there
    var ra_known = platform.arch_cfi_cols() > 17
    while i < cols {
        if r.kind[i] == rule_offset {
            let v = rd64(s.target, add_i(cfa, r.val[i])) else { return no_caller }
            regs[i] = v
            if i == ra { ra_known = true }
        } else if r.kind[i] == rule_val_offset {
            regs[i] = add_i(cfa, r.val[i])
        } else if r.kind[i] == rule_register {
            regs[i] = f.regs[r.val[i] as int]
        } else if r.kind[i] == rule_undefined {
            if i == ra { return no_caller }
        }
        i += 1
    }
    if !ra_known { return no_caller }
    regs[sp_col] = cfa
    regs[platform.arch_ncols() - 1] = regs[ra]
    Frame { pc: regs[ra], cfa: cfa, regs: regs, func: -1, fallback: false, cfa_ok: true, basis: "cfi" }
}

/// Compute the stack of the stopped child. Stops after the frame of main
/// (backtrace past-main off), at an undefined return address, or at 4096.
fn compute_frames(mut s: Session) {
    s.frames = []
    s.frames_ok = true
    s.sel = 0
    if !s.alive { return }
    let raw = platform.target_regs(s.target)
    let regs = dwarf_regs(raw)
    if regs.len != platform.arch_ncols() { return }
    if s.cfi.len == 0 { s.cfi = cfi_build(s.prog) }
    var f = Frame { pc: platform.arch_frame_pc(regs), cfa: 0, regs: regs, func: -1, fallback: false, cfa_ok: false, basis: "cfi" }
    let stop_at = main_addr(s.prog)
    var level = 0
    while level < 4096 {
        let lookup = if level == 0 { f.pc } else { f.pc - 1 }
        let file_pc = lookup - s.base
        f.func = func_at(s.prog, file_pc)
        let fi = cfi_find(s.cfi, file_pc)
        let start = func_start(s.prog, file_pc)
        var next_ok = true
        var caller = copy f
        if fi >= 0 {
            f.fallback = false
            f.basis = "cfi"
            caller = unwind_cfi(s, f, fi, lookup) else { next_ok = false; copy f }
        } else {
            caller = unwind_fp(s, f, level) else { next_ok = false; copy f }
            f.fallback = caller.fallback
            f.basis = caller.basis
        }
        if next_ok { f.cfa = caller.cfa; f.cfa_ok = true }
        (mut s.frames).push(copy f)
        if stop_at != 0 && start == stop_at { return }
        if !next_ok { return }
        if caller.pc == 0 { return }
        // the stack grows downward, so a caller's sp is above the callee's; at a function's first
        // instruction on arm64 the CFA equals sp, so equality is allowed when the pc moved
        let csp = caller.regs[platform.arch_sp_col()]
        let fsp = f.regs[platform.arch_sp_col()]
        if csp < fsp || (csp == fsp && caller.pc == f.pc) { return }
        if csp == fsp && platform.arch_cfi_cols() == 17 { return }
        f = caller
        level += 1
    }
}
