// Frames: the stack of a stopped child, innermost first, from CFI where an
// FDE covers the pc and from the frame pointer (with the standard prologue
// and epilogue cases) where none does.

use platform

/// One frame of the stack.
struct Frame {
    pub pc: u64,
    pub cfa: u64,
    pub regs: List[u64],
    pub func: int,
    pub fallback: bool,
    pub cfa_ok: bool,
    /// How this frame was unwound: "cfi", "compact", "prologue" or "frame-pointer".
    pub basis: str,
}

/// The register list in DWARF column order (platform.arch_dwarf_regs).
fn dwarf_regs(r: List[u64]) -> List[u64] { platform.arch_dwarf_regs(r) }

/// Index into prog.funcs of the DWARF function containing a file address, or -1.
fn func_at(p: Prog, addr: u64) -> int {
    var i = 0
    while i < p.funcs.len {
        if p.funcs[i].low <= addr && addr < p.funcs[i].high && p.funcs[i].low != 0 { return i }
        i += 1
    }
    -1
}

/// Whether an address lies inside an allocated section of the file.
fn in_image(p: Prog, addr: u64) -> bool {
    var i = 0
    while i < p.maps.len {
        if p.maps[i].addr <= addr && addr < p.maps[i].addr + p.maps[i].size { return true }
        i += 1
    }
    false
}

/// Whether name a sorts after name b, byte by byte (a longer name after its own prefix).
fn name_after(a: str, b: str) -> bool {
    let x = a.bytes()
    let y = b.bytes()
    var i = 0
    while i < x.len && i < y.len {
        if x[i] != y[i] { return (x[i] as int) > (y[i] as int) }
        i += 1
    }
    x.len > y.len
}

/// How gdb prints an ELF function symbol's name, measured with `info symbol` on the 175 names with a dot in
/// two static C library programs: a name that starts with `_` as it is; another without a compiler's final
/// clone number (`msort_with_tmp.part.0` is `msort_with_tmp.part`) and with a `.cold` part as `[cold]`
/// (`add_fdes.isra.0.cold` is `add_fdes.isra[cold]`).
fn sym_print_name(name: str) -> str {
    if name.len() == 0 || name.starts_with("_") { return name }
    var t = name
    var cold = false
    if t.ends_with(".cold") {
        t = str_upto(t, t.len() - 5)
        cold = true
    }
    let b = t.bytes()
    var i = b.len - 1
    while i >= 0 && (b[i] as int) >= 48 && (b[i] as int) <= 57 { i -= 1 }
    if i >= 0 && i < b.len - 1 && (b[i] as int) == 46 { t = str_upto(t, i) }
    if cold { t = "{t}[cold]" }
    t
}

/// Index into prog.syms of the ELF function symbol containing a file address, or -1. Of several symbols
/// at one address (a C library's aliases: `__clone3` and `clone3`), the name that sorts last byte by
/// byte: the pinned gdb's choice in each of the 240 alias groups of a static glibc program, measured
/// with `info symbol` (the note's alias table).
fn sym_at(p: Prog, addr: u64) -> int {
    if !in_image(p, addr) { return -1 }
    var best = -1
    var i = 0
    while i < p.syms.len {
        let s = p.syms[i].addr
        if s <= addr && (addr < s + p.syms[i].size || (p.syms[i].size == 0 && best < 0)) {
            if best < 0 || p.syms[best].addr < s { best = i }
            else if p.syms[best].addr == s && name_after(p.syms[i].name, p.syms[best].name) { best = i }
        }
        i += 1
    }
    best
}

/// Start (file address) of the function containing addr by DWARF, else ELF symbol; 0 if unknown.
fn func_start(p: Prog, addr: u64) -> u64 {
    let f = func_at(p, addr)
    if f >= 0 { return p.funcs[f].low }
    let y = sym_at(p, addr)
    if y >= 0 { return p.syms[y].addr }
    0
}

/// The file address of the ELF symbol named main, or 0.
fn main_addr(p: Prog) -> u64 {
    var i = 0
    while i < p.syms.len {
        if p.syms[i].name == "main" { return p.syms[i].addr }
        i += 1
    }
    0
}

fn rd64(s: Session, addr: u64) -> u64 ! {unreadable} {
    let r = src_read(s, addr, 8)
    if !r.ok { return unreadable }
    var v: u64 = 0
    var i = 0
    while i < 8 {
        v = v | ((r.data[i] as int as u64) << (8 * i as u64))
        i += 1
    }
    v
}

fn byte_at(s: Session, addr: u64) -> int {
    let r = src_read(s, addr, 1)
    if !r.ok { return -1 }
    r.data[0] as int
}

/// The frame-pointer fallback's rule (x86-64) for a frame whose return address is at the stack pointer: a
/// function's first instruction, or its ret. cfa = rsp + 8, and rbp is still the caller's.
pub const unwind_at_entry: int = 1
/// The fallback's rule just past a function's `push %rbp`: cfa = rsp + 16, the caller's rbp at rsp.
pub const unwind_after_push: int = 2
/// The fallback's rule anywhere else in a function: the frame pointer's chain, cfa = rbp + 16.
pub const unwind_frame_pointer: int = 3

/// What the unwind does after a frame (unwind_after): take the caller as the next frame,
pub const unwind_go_on: int = 10
/// stop with this frame the outermost,
pub const unwind_stop: int = 11
/// or show the caller, whose pc is 0, as the outermost frame.
pub const unwind_last_zero: int = 12

/// After a frame: stop at main (backtrace past-main) and at the function holding the program's entry point
/// (backtrace past-entry; both off by default, the GDB manual's Backtrace), before any caller; stop when there is no
/// caller; show a caller at pc 0 as the outermost frame where the oracle shows it (zero_shown: measured, the pinned
/// gdb at QEMU's reset vector shows `0x0000000000000000 in ?? ()` as frame 1), else stop there; otherwise go on.
pub fn unwind_after(at_main: bool, at_entry: bool, caller_ok: bool, caller_pc: u64, zero_shown: bool) -> int {
    if at_main || at_entry || !caller_ok { return unwind_stop }
    if caller_pc == 0 { return if zero_shown { unwind_last_zero } else { unwind_stop } }
    unwind_go_on
}

/// Whether the unwind follows the pinned gdb's rules past main's callers (the entry point's function, a caller at
/// pc 0): the Linux build, whose oracle is gdb (PAX's rows are held to gdb too).
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn gdb_unwind_rules() -> bool { true }

/// Apple's lldb is the macOS oracle: none of gdb's rules past main's callers.
#[cfg(target = "aarch64-apple-darwin")]
fn gdb_unwind_rules() -> bool { false }

/// Whether file_pc is in the function holding the program's entry point (its nearest symbol starts there).
fn in_entry_func(p: Prog, file_pc: u64) -> bool {
    if p.entry == 0 { return false }
    let k = sym_at(p, file_pc)
    k >= 0 && p.syms[k].addr == p.entry
}

/// Which rule a frame takes: whether its pc is in code the session knows (the program's image or a library's),
/// is a ret, is at or before its function's `push %rbp`, or just past it. A pc in no code (a call through a null
/// pointer stops at 0) is where a call just went: the return address is at the stack pointer and the frame pointer
/// is still the caller's (measured: the pinned gdb names the calling function as frame 1).
pub fn fallback_rule(in_code: bool, at_ret: bool, before_push: bool, after_push: bool) -> int {
    if !in_code || at_ret || before_push { return unwind_at_entry }
    if after_push { return unwind_after_push }
    unwind_frame_pointer
}

/// The address of the arm64 instruction before pc, when there is one (a pc below 4, as a call through a null
/// pointer leaves it, has none).
pub fn arm64_insn_before(pc: u64) -> (bool, u64) {
    if pc < 4 { return (false, 0) }
    (true, pc - 4)
}

/// Whether an arm64 frame takes its caller from the link register with its frame unchanged: innermost, at a pc whose
/// instruction cannot be read (a call through a null pointer: the call has set lr and built no frame; measured, Apple's
/// lldb names the calling function as frame 1, at lr).
pub fn arm64_lr_rule(level: int, readable: bool) -> bool {
    level == 0 && !readable
}

/// A frame whose CFA and caller registers come from the frame pointer, with
/// gdb's prologue/epilogue cases for a function with no CFI (x86-64).
fn unwind_fp_x86(s: Session, f: Frame, in_code: bool) -> Frame ! {no_caller} {
    let rsp = f.regs[7]
    let rbp = f.regs[6]
    let pc = f.pc
    let start = func_start(s.prog, file_or_zero(pc, s.base))
    // the address of the function's `push %rbp` (past an endbr64), 0 when its start is unknown or has none
    var push_at: u64 = 0
    if start != 0 {
        var a = start + s.base
        if byte_at(s, a) == 243 && byte_at(s, a + 1) == 15 && byte_at(s, a + 2) == 30 && byte_at(s, a + 3) == 250 { a += 4 }
        if byte_at(s, a) == 85 { push_at = a }
    }
    let at_ret = in_code && byte_at(s, pc) == 195
    let rule = fallback_rule(in_code, at_ret, push_at != 0 && pc <= push_at, push_at != 0 && pc == push_at + 1)
    var cfa: u64 = rbp + 16
    var saved_rbp_at: u64 = rbp
    var rbp_saved = true
    if rule == unwind_at_entry {
        cfa = rsp + 8
        rbp_saved = false
    } else if rule == unwind_after_push {
        cfa = rsp + 16
        saved_rbp_at = rsp
    }
    let ra = rd64(s, cfa - 8) else { return no_caller }
    var regs = copy f.regs
    if rbp_saved {
        let nb = rd64(s, saved_rbp_at) else { return no_caller }
        regs[6] = nb
    }
    regs[7] = cfa
    regs[16] = ra
    Frame { pc: ra, cfa: cfa, regs: regs, func: -1, fallback: true, cfa_ok: true, basis: "frame-pointer" }
}

/// The frame-pointer unwind for this machine; arm64 also uses compact unwind and its prologue analysis.
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn unwind_fp(s: Session, f: Frame, level: int, in_code: bool) -> Frame ! {no_caller} { unwind_fp_x86(s, f, in_code) }

#[cfg(target = "aarch64-apple-darwin")]
fn unwind_fp(s: Session, f: Frame, level: int, in_code: bool) -> Frame ! {no_caller} { unwind_arm64(s, f, level) }

/// Unwind through the CFI rules of fde. The CFA of frame f is filled in.
fn unwind_cfi(s: Session, f: Frame, fi: int, lookup: u64) -> Frame ! {no_caller} {
    let fdata = if s.cfi[fi].img { copy s.prog.img } else { copy s.prog.data }
    unwind_rules(s, f, fdata, s.cfi[fi], file_or_zero(lookup, s.base), s.base)
}

/// Unwind through the CFI rules of a shared library's fde (libs.lu).
fn unwind_lib(s: Session, f: Frame, li: int, fi: int, lookup: u64) -> Frame ! {no_caller} {
    let base = s.libs[li].base
    unwind_rules(s, f, s.libs[li].prog.data, s.libs[li].cfi[fi], file_or_zero(lookup, base), base)
}

/// Unwind frame f by the rules fde gives at file address file_pc, in a file whose load bias is base.
fn unwind_rules(s: Session, f: Frame, fdata: List[byte], fde: CfiFde, file_pc: u64, base: u64) -> Frame ! {no_caller} {
    let r = cfi_rules(fdata, fde, file_pc)
    let cols = platform.arch_cfi_cols()
    let ra = platform.arch_ra_col()
    let sp_col = platform.arch_sp_col()
    var cfa: u64 = 0
    if r.cfa_is_expr {
        let ctx = EvalCtx { regs: copy f.regs, frame_base: 0, has_frame_base: false, cfa: 0, has_cfa: false, base: base }
        let l = expr_eval(fdata, r.cfa_expr, ctx, s)
        if l.kind != loc_memory { return no_caller }
        cfa = l.value
    } else {
        if r.cfa_reg >= cols { return no_caller }
        cfa = add_i(f.regs[r.cfa_reg], r.cfa_off)
    }
    var regs = copy f.regs
    var i = 0
    // arm64's link register keeps its value in a leaf, so "same value" is a known return address there
    var ra_known = platform.arch_cfi_cols() > 17
    while i < cols {
        if r.kind[i] == rule_offset {
            let v = rd64(s, add_i(cfa, r.val[i])) else { return no_caller }
            regs[i] = v
            if i == ra { ra_known = true }
        } else if r.kind[i] == rule_val_offset {
            regs[i] = add_i(cfa, r.val[i])
        } else if r.kind[i] == rule_register {
            regs[i] = f.regs[r.val[i] as int]
        } else if r.kind[i] == rule_undefined {
            if i == ra { return no_caller }
        }
        i += 1
    }
    if !ra_known { return no_caller }
    regs[sp_col] = cfa
    regs[platform.arch_ncols() - 1] = regs[ra]
    Frame { pc: regs[ra], cfa: cfa, regs: regs, func: -1, fallback: false, cfa_ok: true, basis: "cfi" }
}

/// Compute the stack of the stopped child. Stops after the frame of main (backtrace past-main off) or of the entry
/// point's function (past-entry off), at an undefined return address, after a caller at pc 0, or at 4096.
fn compute_frames(mut s: Session) {
    s.frames = []
    s.frames_ok = true
    s.sel = 0
    if !has_stack(s) { return }
    let raw = src_regs(s)
    let regs = dwarf_regs(raw)
    if regs.len != platform.arch_ncols() { return }
    if s.cfi.len == 0 { s.cfi = cfi_build(s.prog) }
    var f = Frame { pc: platform.arch_frame_pc(regs), cfa: 0, regs: regs, func: -1, fallback: false, cfa_ok: false, basis: "cfi" }
    let stop_at = main_addr(s.prog)
    var level = 0
    while level < 4096 {
        let lookup = caller_lookup(f.pc, level)
        let file_pc = file_or_zero(lookup, s.base)
        f.func = func_at(s.prog, file_pc)
        let fi = cfi_find(s.cfi, file_pc)
        let start = func_start(s.prog, file_pc)
        var next_ok = true
        var caller = copy f
        if fi >= 0 {
            f.fallback = false
            f.basis = "cfi"
            caller = unwind_cfi(s, f, fi, lookup) else { next_ok = false; copy f }
        } else {
            // a pc in a shared library: the library's own CFI, else the frame-pointer fallback
            let li = if in_image(s.prog, file_pc) { 0 - 1 } else { lib_at(mut s, lookup) }
            let lfi = if li >= 0 { cfi_find(s.libs[li].cfi, file_or_zero(lookup, s.libs[li].base)) } else { 0 - 1 }
            if lfi >= 0 {
                f.fallback = false
                f.basis = "cfi"
                caller = unwind_lib(s, f, li, lfi, lookup) else { next_ok = false; copy f }
            } else {
                // whether the pc is in code the session knows: the program's image or a library's
                let in_code = in_image(s.prog, file_pc) || li >= 0
                caller = unwind_fp(s, f, level, in_code) else { next_ok = false; copy f }
                f.fallback = caller.fallback
                f.basis = caller.basis
            }
        }
        if next_ok { f.cfa = caller.cfa; f.cfa_ok = true }
        (mut s.frames).push(copy f)
        let gdb = gdb_unwind_rules()
        let after = unwind_after(stop_at != 0 && start == stop_at, gdb && in_entry_func(s.prog, file_pc), next_ok, caller.pc, gdb)
        if after == unwind_stop { return }
        if after == unwind_last_zero {
            // the caller at pc 0 is the outermost frame, and nothing is unwound past it
            var z = copy caller
            z.func = -1
            z.cfa_ok = false
            (mut s.frames).push(z)
            return
        }
        // the stack grows downward, so a caller's sp is above the callee's; at a function's first
        // instruction on arm64 the CFA equals sp, so equality is allowed when the pc moved
        let csp = caller.regs[platform.arch_sp_col()]
        let fsp = f.regs[platform.arch_sp_col()]
        if csp < fsp || (csp == fsp && caller.pc == f.pc) { return }
        if csp == fsp && platform.arch_cfi_cols() == 17 { return }
        f = caller
        level += 1
    }
}
