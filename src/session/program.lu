// The loaded program: sections, DIEs, line table, functions and symbols, as
// the session needs them. Everything here is a view over one ELF file read
// once; no process is involved. Addresses are file (unrelocated) addresses.

use readers

/// A compile unit's bases and names.
struct Unit {
    pub root: int,
    pub end: int,
    pub name: str,
    pub comp_dir: str,
    pub str_table: readers.DwarfIndexTable,
    pub has_str_table: bool,
    pub addr_base: u64,
    pub has_addr_base: bool,
    pub version: int,
    pub address_size: int,
    pub offset_size: int,
    pub files_first: int,
    pub files_count: int,
}

/// One line-table row, resolved to a global file index.
struct LineEnt {
    pub addr: u64,
    pub file: int,
    pub line: int,
    pub stmt: bool,
    pub prologue_end: bool,
    pub end_seq: bool,
    pub ord: int,
}

/// A subprogram with an address range.
struct Func {
    pub name: str,
    pub low: u64,
    pub high: u64,
    pub file: int,
    pub line: int,
    pub die: int,
    pub unit: int,
}

/// An ELF function symbol, for code that has no DWARF.
struct Sym {
    pub name: str,
    pub addr: u64,
    pub size: u64,
}

/// An allocated section with file bytes: where its address range lies in the file.
struct SecMap {
    pub addr: u64,
    pub off: u64,
    pub size: u64,
}

/// The loaded program.
struct Prog {
    pub err: str,
    pub path: str,
    pub data: List[byte],
    pub secs: readers.DebugSections,
    pub info: readers.DwarfInfo,
    pub has_info: bool,
    pub units: List[Unit],
    pub files: List[str],
    pub lines: List[LineEnt],
    pub funcs: List[Func],
    pub syms: List[Sym],
    pub entry: u64,
    pub pie: bool,
    pub maps: List[SecMap],
    /// The executable's own bytes when the DWARF lives in another file (a Mach-O image with its dSYM); empty for ELF.
    pub img: List[byte],
    /// The image's own sections (its __eh_frame, for Mach-O).
    pub isecs: readers.DebugSections,
    /// The file address of the image's text segment (what the slide is measured from).
    pub text_addr: u64,
    /// Where __unwind_info sits in the image: file offset and size, size 0 when absent.
    pub ui_off: int,
    pub ui_size: int,
    /// The dSYM companion's path when one was paired, else "".
    pub dsym: str,
}

/// Bytes of a span as text; invalid UTF-8 yields the empty string.
fn span_text(data: List[byte], span: readers.ByteSpan) -> str {
    var bytes: List[byte] = []
    var i: int = 0
    while i < span.length { (mut bytes).push(data[span.start + i]); i += 1 }
    str_from_utf8(bytes) else { "" }
}

fn empty_table() -> readers.DwarfIndexTable {
    readers.DwarfIndexTable { start: 0, end: 0, version: 0, offset_size: 0, address_size: 0,
        entry_size: 0, base: 0, entries_end: 0, payload_start: 0, count: 0, kind: 0 }
}

/// A failed load.
fn prog_failed(why: str) -> Prog {
    let none = readers.ByteSpan { start: 0, length: 0 }
    let sec = readers.ObjectSection { span: readers.ByteSpan { start: 0, length: 0 }, address: 0, present: false }
    Prog {
        err: why, path: "", data: [],
        secs: readers.DebugSections { format: 0, info: copy sec, abbrev: copy sec, line: copy sec, str: copy sec,
            line_str: copy sec, str_offsets: copy sec, addr: copy sec, ranges: copy sec, rnglists: copy sec,
            loc: copy sec, loclists: copy sec, frame: copy sec, eh_frame: copy sec, types: copy sec,
            has_split_dwarf: false, has_compact_unwind: false },
        info: readers.DwarfInfo { info: copy none, abbrev: copy none, units: [], entries: [], attributes: [],
            tables: [], die_count: 0, abbreviation_tables_read: 0, fuel_remaining: 0 },
        has_info: false, units: [], files: [], lines: [], funcs: [], syms: [], entry: 0, pie: false, maps: [],
        img: [], isecs: readers.DebugSections { format: 0, info: copy sec, abbrev: copy sec, line: copy sec, str: copy sec,
            line_str: copy sec, str_offsets: copy sec, addr: copy sec, ranges: copy sec, rnglists: copy sec,
            loc: copy sec, loclists: copy sec, frame: copy sec, eh_frame: copy sec, types: copy sec,
            has_split_dwarf: false, has_compact_unwind: false },
        text_addr: 0, ui_off: 0, ui_size: 0, dsym: "",
    }
}

/// Index of the attribute on entry, or -1.
fn attr_at(p: Prog, e: int, attribute: u64) -> int {
    readers.dwarf_info_find(p.info, e, attribute)
}

fn is_string_form(form: u64) -> bool {
    form == 8 || form == 14 || form == 31 || form == 26 || form >= 37 && form <= 40
}

/// A string attribute value through its form (inline, strp, line_strp, strx).
fn value_text(p: Prog, ui: int, value: readers.DwarfValue) -> str {
    let form = value.form
    if form == 8 { return span_text(p.data, value.bytes) }
    if form == 14 || form == 31 {
        let section = if form == 14 { copy p.secs.str.span } else { copy p.secs.line_str.span }
        if value.raw >= section.length as u64 { return "" }
        var c = readers.cursor(section.start + value.raw as int, section.start + section.length, 10000000)
        let span = readers.cstring(p.data, mut c) else { return "" }
        return span_text(p.data, span)
    }
    if !is_string_form(form) { return "" }
    if !p.units[ui].has_str_table { return "" }
    var work = readers.cursor(0, 0, 100000)
    let offset = readers.dwarf_index_raw(p.data, p.units[ui].str_table, value.raw, mut work) else { return "" }
    let section = copy p.secs.str.span
    if offset >= section.length as u64 { return "" }
    var c = readers.cursor(section.start + offset as int, section.start + section.length, 10000000)
    let span = readers.cstring(p.data, mut c) else { return "" }
    span_text(p.data, span)
}

/// A string attribute of entry e, or "" when absent.
fn attr_text(p: Prog, ui: int, e: int, attribute: u64) -> str {
    let at = attr_at(p, e, attribute)
    if at < 0 { return "" }
    value_text(p, ui, p.info.attributes[at].value)
}

/// An address-class value: addr, or addrx through .debug_addr.
fn value_addr(p: Prog, ui: int, value: readers.DwarfValue) -> u64 {
    if value.form == 1 { return value.raw }
    if !p.units[ui].has_addr_base { return 0 }
    var work = readers.cursor(0, 0, 100000)
    let a = readers.dwarf_index_address(p.data, p.secs.addr.span, p.units[ui].addr_base,
        value.raw, p.units[ui].offset_size, p.units[ui].address_size, mut work) else { return 0 }
    a
}

/// A constant attribute (data forms), or the default when absent.
fn attr_uint(p: Prog, e: int, attribute: u64, absent: u64) -> u64 {
    let at = attr_at(p, e, attribute)
    if at < 0 { return absent }
    p.info.attributes[at].value.raw
}

/// The entry an attribute of e refers to, or -1.
fn attr_ref(p: Prog, e: int, attribute: u64) -> int {
    let at = attr_at(p, e, attribute)
    if at < 0 { return -1 }
    var fuel: int = 1000
    let t = readers.dwarf_info_target(p.info, e, p.info.attributes[at].value, mut fuel) else { return -1 }
    t
}

/// The unit index owning entry e.
fn unit_of(p: Prog, e: int) -> int {
    p.info.entries[e].unit
}

fn join_path(dir: str, name: str) -> str {
    if name.starts_with("/") || dir.len() == 0 { return name }
    if dir.ends_with("/") { return "{dir}{name}" }
    "{dir}/{name}"
}

fn line_file_name(data: List[byte], t: readers.DwarfLineTable, u: Unit, index: int) -> str {
    // DWARF 5 numbers files from 0; DWARF 4 from 1 (0 means the CU itself).
    var k = index
    if t.version < 5 { k = index - 1 }
    if k < 0 || k >= t.files.len { return u.name }
    let entry = copy t.files[k]
    let name = span_text(data, entry.name)
    var dir = ""
    let d = entry.directory_index as int
    if t.version >= 5 {
        if d > 0 && d < t.directories.len { dir = span_text(data, t.directories[d].name) }
        if d == 0 { return join_path(u.comp_dir, name) }
    } else {
        if d == 0 { return join_path(u.comp_dir, name) }
        if d - 1 < t.directories.len { dir = span_text(data, t.directories[d - 1].name) }
    }
    if !dir.starts_with("/") { dir = join_path(u.comp_dir, dir) }
    join_path(dir, name)
}

fn intern_file(mut files: List[str], name: str) -> int {
    var i: int = 0
    while i < files.len {
        if files[i] == name { return i }
        i += 1
    }
    (mut files).push(name)
    files.len - 1
}

fn unit_bases(data: List[byte], p: Prog, ui: int, root: int) -> Unit {
    let header = copy p.info.units[ui].header
    var u = Unit {
        root: root, end: p.info.units[ui].end_entry, name: "", comp_dir: "", str_table: empty_table(),
        has_str_table: false, addr_base: 0, has_addr_base: false, version: header.version,
        address_size: header.address_size, offset_size: header.offset_size, files_first: 0, files_count: 0,
    }
    let sb = attr_at(p, root, 114)
    if sb >= 0 {
        var work = readers.cursor(0, 0, 10000000)
        let t = readers.dwarf_index_find(data, p.secs.str_offsets.span, p.info.attributes[sb].value.raw,
            readers.dwarf_index_str_offsets, header.offset_size, 0, mut work) else { return u }
        u.str_table = t
        u.has_str_table = true
    }
    let ab = attr_at(p, root, 115)
    if ab >= 0 { u.addr_base = p.info.attributes[ab].value.raw; u.has_addr_base = true }
    u
}

/// A DIE's name with its enclosing namespaces and types: a::b::name.
fn qualified_name(p: Prog, ui: int, e: int) -> str {
    var name = attr_text(p, ui, e, 3)
    var parent = p.info.entries[e].parent
    var guard = 0
    while parent >= 0 && guard < 16 {
        let tag = p.info.entries[parent].tag
        if tag == 57 || tag == 19 || tag == 2 || tag == 23 {
            let pn = attr_text(p, ui, parent, 3)
            if pn.len() > 0 { name = "{pn}::{name}" }
            parent = p.info.entries[parent].parent
        } else {
            parent = 0 - 1
        }
        guard += 1
    }
    name
}

fn line_order(a: LineEnt, b: LineEnt) -> bool {
    if a.addr != b.addr { return a.addr < b.addr }
    a.ord <= b.ord
}

/// An ascending run of line rows, keyed by its first row.
struct LineRun {
    pub addr: u64,
    pub ord: int,
    pub start: int,
    pub end: int,
}

fn run_order(a: LineRun, b: LineRun) -> bool {
    if a.addr != b.addr { return a.addr < b.addr }
    a.ord <= b.ord
}

/// Sort the rows by line_order. Rows arrive as ascending runs, one per line-table sequence
/// (3,056 runs in 129,077 rows of a large runtime's tables), so the runs are ordered by their
/// first row and laid end to end; when that is sorted, it is the answer, because (addr, ord)
/// is a total order with ord unique and the sorted list is therefore unique. Runs that
/// overlap fall back to the full sort.
fn sort_lines(mut lines: List[LineEnt]) {
    let n = lines.len
    if n < 2 { return }
    var runs: List[LineRun] = []
    var start: int = 0
    var i: int = 1
    while i <= n {
        if i == n || !line_order(lines[i - 1], lines[i]) {
            (mut runs).push(LineRun { addr: lines[start].addr, ord: lines[start].ord, start: start, end: i })
            start = i
        }
        i += 1
    }
    if runs.len == 1 { return }
    (mut runs).sort_by(run_order)
    var out: List[LineEnt] = []
    (mut out).reserve(n)
    var r: int = 0
    while r < runs.len {
        var k = runs[r].start
        while k < runs[r].end { (mut out).push(copy lines[k]); k += 1 }
        r += 1
    }
    var j: int = 1
    while j < n {
        if !line_order(out[j - 1], out[j]) {
            (mut lines).sort_by(line_order)
            return
        }
        j += 1
    }
    j = 0
    while j < n { lines[j] = copy out[j]; j += 1 }
}

/// Read the ELF file at path and build the session's view of it. A program
/// without DWARF loads with has_info false; symbols still work.
fn prog_load(path: str) -> Prog {
    let size = fs_size(path) else |err| { return prog_failed("cannot read {path}: {err}") }
    if size > 268435456 { return prog_failed("{path} is too large") }
    let data = fs_read_bytes(path) else |err| { return prog_failed("cannot read {path}: {err}") }
    if data.len >= 4 && data[0] as int == 207 && data[1] as int == 250 && data[2] as int == 237 && data[3] as int == 254 {
        return prog_load_macho(path, data)
    }
    let elf = readers.elf_read(data, 131072, 1048576, 100000000) else |err| {
        return prog_failed("{path}: not in executable format: {err}")
    }
    var p = prog_failed("")
    p.path = path
    p.entry = elf.entry
    p.pie = elf.file_type == 3
    var m: int = 0
    while m < elf.sections.len {
        let sec = copy elf.sections[m]
        if (sec.flags & 2) != 0 && sec.kind != 8 && sec.size > 0 {
            (mut p.maps).push(SecMap { addr: sec.address, off: sec.offset, size: sec.size })
        }
        m += 1
    }
    // function symbols
    var i: int = 0
    while i < elf.symbols.len {
        let s = copy elf.symbols[i]
        if (s.info & 15) == 2 && s.value != 0 && s.section_index != 0 {
            (mut p.syms).push(Sym { name: span_text(data, s.name), addr: s.value, size: s.size })
        }
        i += 1
    }
    load_dwarf(mut p, data)
    p
}

/// Read the DWARF sections of `data` (the executable for ELF, the dSYM's DWARF file for
/// Mach-O) into p: units, line table and subprograms. A file without DWARF leaves has_info false.
/// The DIE tree is moved into p, not copied: a copy duplicated every entry and attribute,
/// over 100 MB of page-faulted memory on a large runtime's DWARF.
fn load_dwarf(mut p: Prog, data: List[byte]) {
    p.data = copy data
    let secs = readers.object_sections(p.data) else |err| { return }
    p.secs = copy secs
    if !secs.info.present || secs.info.span.length == 0 { return }
    let info = readers.dwarf_info_read(p.data, secs.info.span, secs.abbrev.span, readers.dwarf_info_limits()) else |err| {
        p.err = "dwarf: {err}"
        return
    }
    p.info = info
    p.has_info = true
    var ui: int = 0
    while ui < p.info.units.len {
        let root = p.info.units[ui].first_entry
        if root >= p.info.units[ui].end_entry || p.info.entries[root].is_null {
            (mut p.units).push(unit_bases(p.data, p, ui, root))
        } else {
            var u = unit_bases(p.data, p, ui, root)
            (mut p.units).push(copy u)
            u.name = attr_text(p, ui, root, 3)
            u.comp_dir = attr_text(p, ui, root, 27)
            p.units[ui] = copy u
            let sl = attr_at(p, root, 16)
            if sl >= 0 {
                let offset = p.info.attributes[sl].value.raw
                if offset < secs.line.span.length as u64 {
                    let start = secs.line.span.start + offset as int
                    let span = readers.ByteSpan { start: start, length: secs.line.span.start + secs.line.span.length - start }
                    let table = readers.dwarf_line_read(p.data, span, u.address_size, secs.str.span, secs.line_str.span,
                        100000000, 1048576) else |err| {
                        p.err = "line table: {err}"
                        return
                    }
                    var r: int = 0
                    var prev_line: u64 = 0
                    var prev_file: u64 = 0
                    var seq_open = false
                    var has_nz = false
                    var fmap: List[int] = []
                    while r < table.rows.len {
                        let row = copy table.rows[r]
                        // each file of the table is named and interned once
                        while fmap.len <= row.file as int { (mut fmap).push(0 - 1) }
                        if fmap[row.file as int] < 0 {
                            let fname = line_file_name(p.data, table, p.units[ui], row.file as int)
                            fmap[row.file as int] = intern_file(mut p.files, fname)
                        }
                        let fi = fmap[row.file as int]
                        // gdb records a row of the same line and file as the one before it
                        // only when that line has never carried a discriminator
                        var drop = false
                        if row.end_sequence {
                            seq_open = false
                        } else {
                            let changed = !seq_open || row.line != prev_line
                            has_nz = if changed { row.discriminator != 0 } else { has_nz || row.discriminator != 0 }
                            drop = seq_open && !changed && row.file == prev_file && has_nz
                            prev_line = row.line
                            prev_file = row.file
                            seq_open = true
                        }
                        if drop { r += 1; continue }
                        (mut p.lines).push(LineEnt { addr: row.address, file: fi, line: row.line as int,
                            stmt: row.is_stmt, prologue_end: row.prologue_end, end_seq: row.end_sequence, ord: p.lines.len })
                        r += 1
                    }
                }
            }
        }
        ui += 1
    }
    sort_lines(mut p.lines)
    // subprograms with ranges
    let subs = subprogram_entries(p.info)
    var si: int = 0
    while si < subs.len {
        let e = subs[si]
        si += 1
        {
            let lo = attr_at(p, e, 17)
            let hi = attr_at(p, e, 18)
            if lo >= 0 && hi >= 0 {
                let un = p.info.entries[e].unit
                let low = value_addr(p, un, p.info.attributes[lo].value)
                let hv = copy p.info.attributes[hi].value
                var high = hv.raw
                if hv.form != 1 && hv.form != 27 && !(hv.form >= 41 && hv.form <= 44) { high = low + hv.raw }
                else { high = value_addr(p, un, hv) }
                var name = qualified_name(p, un, e)
                var file = -1
                let df = attr_uint(p, e, 58, 0)
                let line = attr_uint(p, e, 59, 0) as int
                if name.len() > 0 {
                    (mut p.funcs).push(Func { name: name, low: low, high: high, file: file, line: line, die: e, unit: un })
                }
            }
        }
    }
}

/// The non-null DW_TAG_subprogram entries, in section order. A read-only
/// walk of the entry list: indexing it through the mutable Prog cost about
/// 1,190 instructions an entry, 15% of startup on a large runtime's DWARF.
fn subprogram_entries(info: readers.DwarfInfo) -> List[int] {
    var out: List[int] = []
    var e: int = 0
    let n = info.entries.len
    while e < n {
        if !info.entries[e].is_null && info.entries[e].tag == 46 { (mut out).push(e) }
        e += 1
    }
    out
}


fn path_base_name(path: str) -> str {
    let bytes = path.bytes()
    var cut: int = 0
    var i: int = 0
    while i < bytes.len {
        if bytes[i] as int == 47 { cut = i + 1 }
        i += 1
    }
    var out: List[byte] = []
    i = cut
    while i < bytes.len { (mut out).push(bytes[i]); i += 1 }
    str_from_utf8(out) else { "" }
}

fn sym_order(a: Sym, b: Sym) -> bool { a.addr <= b.addr }

/// A thin arm64 Mach-O executable (Apple's mach-o/loader.h) and its dSYM, paired by UUID.
/// The image gives sections, symbols and the unwind data; the dSYM's DWARF file gives units,
/// lines and subprograms. A dSYM whose UUID differs is refused by name (dsym_uuid_mismatch);
/// a missing dSYM leaves the image's own debug sections, if any, and else symbols only.
fn prog_load_macho(path: str, data: List[byte]) -> Prog {
    let mach = readers.macho_read(data, 100000000) else |err| { return prog_failed("{path}: not in executable format: {err}") }
    var p = prog_failed("")
    p.path = path
    p.pie = true
    p.img = copy data
    var text_index: int = 0 - 1
    var m: int = 0
    while m < mach.sections.len {
        let sec = copy mach.sections[m]
        if sec.has_file_data && sec.size > 0 {
            (mut p.maps).push(SecMap { addr: sec.address, off: sec.file_offset, size: sec.size })
        }
        let nm = span_text(data, sec.name)
        if nm == "__text" { text_index = m }
        if nm == "__unwind_info" && sec.has_file_data { p.ui_off = sec.file_offset as int; p.ui_size = sec.size as int }
        m += 1
    }
    p.text_addr = 4294967296
    var i: int = 0
    while i < mach.symbols.len {
        let sy = copy mach.symbols[i]
        let name = span_text(data, sy.name)
        if name == "__mh_execute_header" { p.text_addr = sy.value }
        // defined in a section (N_SECT), not a debugging entry, and in __text
        if (sy.kind & 224) == 0 && (sy.kind & 14) == 14 && sy.section as int == text_index + 1 && sy.value != 0 {
            if !name.starts_with("ltmp") && !name.starts_with("l_") {
                let shown = name.strip_prefix("_") else { name }
                (mut p.syms).push(Sym { name: shown, addr: sy.value, size: 0 })
            }
        }
        i += 1
    }
    (mut p.syms).sort_by(sym_order)
    // the linker records no sizes: a symbol runs to the next one, the last to the end of __text
    var text_end: u64 = 0
    if text_index >= 0 { text_end = mach.sections[text_index].address + mach.sections[text_index].size }
    i = 0
    while i < p.syms.len {
        var next = text_end
        var k = i + 1
        while k < p.syms.len {
            if p.syms[k].addr > p.syms[i].addr { next = p.syms[k].addr; break }
            k += 1
        }
        if next > p.syms[i].addr { p.syms[i].size = next - p.syms[i].addr }
        i += 1
    }
    let isecs = readers.object_sections(data) else |err| { return prog_failed("{path}: {err}") }
    p.isecs = copy isecs
    // the companion: Apple's bundle layout, Contents/Resources/DWARF/<binary-name>
    let companion = "{path}.dSYM/Contents/Resources/DWARF/{path_base_name(path)}"
    let dsym = fs_read_bytes(companion) else |err| {
        if isecs.info.present && isecs.info.span.length > 0 { load_dwarf(mut p, data) }
        return p
    }
    let dobj = readers.macho_read(dsym, 100000000) else |err| { return prog_failed("{companion}: not in dSYM format: {err}") }
    readers.macho_match_uuid(data, mach, dsym, dobj) else |err| { return prog_failed("{path}: {err} ({companion})") }
    p.dsym = companion
    load_dwarf(mut p, dsym)
    p
}

/// n bytes of the file image at a virtual address, or fewer when it is not mapped by a section.
fn file_bytes_at(p: Prog, addr: u64, n: int) -> List[byte] {
    var out: List[byte] = []
    var i = 0
    while i < p.maps.len {
        let m = copy p.maps[i]
        if m.addr <= addr && addr < m.addr + m.size {
            var k: u64 = 0
            while k < n as u64 && addr + k < m.addr + m.size {
                let at = (m.off + (addr - m.addr) + k) as int
                if p.img.len > 0 {
                    if at < p.img.len { (mut out).push(p.img[at]) }
                } else if at < p.data.len { (mut out).push(p.data[at]) }
                k += 1
            }
            return out
        }
        i += 1
    }
    out
}

/// The text of t from byte n on (empty when n is past the end).
fn str_from(t: str, n: int) -> str {
    t.get(n..t.len()) else { "" }
}

/// The text of t before byte n.
fn str_upto(t: str, n: int) -> str {
    t.get(0..n) else { t }
}
