// print, output, x and info registers, and gdb's formats for what they show. The expressions
// themselves are eval.lu's.

use platform

fn bytes_of(v: u64, n: int) -> List[byte] {
    var out: List[byte] = []
    var i = 0
    while i < n {
        (mut out).push(((v >> (8 * i as u64)) & 255) as int as byte)
        i += 1
    }
    out
}

fn int_val(v: u64, ty: int) -> Val {
    Val { ok: true, why: "", ty: ty, bytes: bytes_of(v, 8), addr: 0, has_addr: false, reg: -1 }
}

fn as_u64(b: List[byte]) -> u64 {
    var v: u64 = 0
    var i = 0
    while i < 8 && i < b.len {
        v = v | ((b[i] as int as u64) << (8 * i as u64))
        i += 1
    }
    v
}

fn signed_of(s: Session, v: Val) -> i64 {
    let size = ty_size(s.prog, v.ty)
    let raw = as_u64(v.bytes)
    if size >= 8 || size <= 0 { return platform.bits_i64(raw) }
    let bits = (size * 8) as u64
    if raw & ((1 as u64) << (bits - 1)) != 0 { return platform.bits_i64(raw | !(((1 as u64) << bits) - 1)) }
    platform.bits_i64(raw)
}

#[cfg(target = "x86_64-unknown-linux-gnu")]
fn reg_slot(name: str) -> int {
    if name == "rax" { return platform.reg_rax }
    if name == "rbx" { return platform.reg_rbx }
    if name == "rcx" { return platform.reg_rcx }
    if name == "rdx" { return platform.reg_rdx }
    if name == "rsi" { return platform.reg_rsi }
    if name == "rdi" { return platform.reg_rdi }
    if name == "rbp" { return platform.reg_rbp }
    if name == "rsp" { return platform.reg_rsp }
    if name == "r8" { return platform.reg_r8 }
    if name == "r9" { return platform.reg_r9 }
    if name == "r10" { return platform.reg_r10 }
    if name == "r11" { return platform.reg_r11 }
    if name == "r12" { return platform.reg_r12 }
    if name == "r13" { return platform.reg_r13 }
    if name == "r14" { return platform.reg_r14 }
    if name == "r15" { return platform.reg_r15 }
    if name == "rip" || name == "pc" { return platform.reg_rip }
    if name == "sp" { return platform.reg_rsp }
    if name == "fp" { return platform.reg_rbp }
    if name == "eflags" { return platform.reg_eflags }
    if name == "cs" { return platform.reg_cs }
    if name == "ss" { return platform.reg_ss }
    if name == "ds" { return platform.reg_ds }
    if name == "es" { return platform.reg_es }
    if name == "fs" { return platform.reg_fs }
    if name == "gs" { return platform.reg_gs }
    if name == "fs_base" { return platform.reg_fs_base }
    if name == "gs_base" { return platform.reg_gs_base }
    0 - 1
}

/// The value of register `name` in the selected frame (frame 0 reads the live registers).
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn reg_value(s: Session, name: str) -> Val {
    if !s.alive { return val_fail("No registers.") }
    let slot = reg_slot(name)
    if slot < 0 { return val_fail("Invalid register `{name}'") }
    let raw = platform.target_regs(s.target)
    if raw.len != platform.arch_nregs() { return val_fail("The program has no registers now.") }
    var v = raw[slot]
    if s.sel > 0 && s.sel < s.frames.len {
        if slot == platform.reg_rip { v = s.frames[s.sel].pc }
        if slot == platform.reg_rsp { v = s.frames[s.sel].regs[7] }
        if slot == platform.reg_rbp { v = s.frames[s.sel].regs[6] }
    }
    if name == "pc" || name == "rip" { return int_val(v, ty_codep) }
    if name == "sp" || name == "rsp" || name == "fp" || name == "rbp" { return int_val(v, ty_voidp) }
    if name == "eflags" || slot >= platform.reg_cs && slot != platform.reg_fs_base && slot != platform.reg_gs_base {
        return int_val(v, ty_int)
    }
    int_val(v, ty_long)
}


/// Slot of an arm64 register by gdb's name: x0-x30, sp, pc, cpsr; fp and lr are x29 and x30.
#[cfg(target = "aarch64-apple-darwin")]
fn reg_slot(name: str) -> int {
    if name == "sp" { return 31 }
    if name == "pc" { return 32 }
    if name == "cpsr" { return 33 }
    if name == "fp" { return 29 }
    if name == "lr" { return 30 }
    if name.starts_with("x") {
        let digits = name.strip_prefix("x") else { return 0 - 1 }
        if digits.len() == 0 || digits.len() > 2 { return 0 - 1 }
        var v = 0
        for b in digits.bytes() {
            let c = b as int
            if c < 48 || c > 57 { return 0 - 1 }
            v = v * 10 + (c - 48)
        }
        if v <= 30 && ("{v}" == digits) { return v }
    }
    0 - 1
}

/// The value of register `name` in the selected frame (frame 0 reads the live registers).
#[cfg(target = "aarch64-apple-darwin")]
fn reg_value(s: Session, name: str) -> Val {
    if !s.alive { return val_fail("No registers.") }
    let slot = reg_slot(name)
    if slot < 0 { return val_fail("Invalid register `{name}'") }
    let raw = platform.target_regs(s.target)
    if raw.len != platform.arch_nregs() { return val_fail("The program has no registers now.") }
    var v = raw[slot]
    if s.sel > 0 && s.sel < s.frames.len {
        if slot == 32 { v = s.frames[s.sel].pc }
        if slot == 31 || slot == 29 || slot == 30 { v = s.frames[s.sel].regs[slot] }
    }
    if slot == 32 { return int_val(v, ty_codep) }
    if slot == 31 || slot == 29 { return int_val(v, ty_voidp) }
    if slot == 30 { return int_val(v, ty_codep) }
    if slot == 33 { return int_val(v, ty_int) }
    int_val(v, ty_long)
}

fn find_var(s: Session, name: str) -> Val {
    if !s.alive || s.sel >= s.frames.len { return val_fail("") }
    let fr = copy s.frames[s.sel]
    var tags: List[u64] = [tag_variable, tag_formal]
    var t = 0
    while t < 2 {
        let vars = visible_vars(s, fr, s.sel, tags[t])
        var i = 0
        while i < vars.len {
            let ui = s.prog.info.entries[vars[i]].unit
            if attr_text(s.prog, ui, vars[i], 3) == name { return var_val(s, fr, vars[i]) }
            i += 1
        }
        t += 1
    }
    val_fail("")
}

/// "<sym+off>" for a runtime address inside a function or symbol, else "".
fn symbolize(s: Session, addr: u64) -> str {
    let file = addr - s.base
    let f = func_at(s.prog, file)
    if f >= 0 {
        let off = file - s.prog.funcs[f].low
        if off == 0 { return "<{s.prog.funcs[f].name}>" }
        return "<{s.prog.funcs[f].name}+{off}>"
    }
    let y = sym_at(s.prog, file)
    if y >= 0 {
        let off = file - s.prog.syms[y].addr
        let name = sym_print_name(s.prog.syms[y].name)
        if off == 0 { return "<{name}>" }
        return "<{name}+{off}>"
    }
    ""
}

fn text_with_format(s: Session, v: Val, fmt: str, top: bool) -> str {
    if fmt.len() == 0 { return format_bytes(s.prog, s.target, v.ty, v.bytes, top) }
    let raw = as_u64(v.bytes)
    let size = ty_size(s.prog, v.ty)
    var u = raw
    if size > 0 && size < 8 { u = raw & (((1 as u64) << (8 * size as u64)) - 1) }
    if fmt == "x" { return "0x{u:x}" }
    if fmt == "d" { return "{signed_of(s, v)}" }
    if fmt == "u" { return "{u}" }
    if fmt == "o" { return "0{octal_of(u)}" }
    if fmt == "t" { return binary_of(u) }
    if fmt == "c" { return "{signed_of(s, v)} '{char_escape((u & 255) as int, 39)}'" }
    if fmt == "a" { return "0x{u:x}" }
    "0x{u:x}"
}

fn octal_of(n: u64) -> str {
    if n == 0 { return "0" }
    var out = ""
    var v = n
    while v > 0 {
        out = "{v % 8}{out}"
        v = v / 8
    }
    out
}

fn binary_of(n: u64) -> str {
    if n == 0 { return "0" }
    var out = ""
    var v = n
    while v > 0 {
        out = "{v % 2}{out}"
        v = v / 2
    }
    out
}

/// Split "/x expr" into the format letter(s) and the expression.
fn split_format(rest: str) -> (str, str) {
    let t = rest.trim()
    if t.starts_with("/") {
        let parts = t.splitn(" ", 2)
        let f = str_from(parts[0], 1)
        var e = ""
        if parts.len > 1 { e = parts[1] }
        return (f, e)
    }
    ("", t)
}

/// "<sym+off>" for a runtime address inside a data symbol, else "".
fn data_symbolize(s: Session, addr: u64) -> str {
    if addr < s.base { return "" }
    let file = addr - s.base
    var i = 0
    while i < s.prog.dsyms.len {
        let d = copy s.prog.dsyms[i]
        if d.addr <= file && file < d.addr + d.size {
            let off = file - d.addr
            if off == 0 { return "<{d.name}>" }
            return "<{d.name}+{off}>"
        }
        i += 1
    }
    ""
}

/// The text of a top-level value, with gdb's <sym+off> after a code or data pointer.
fn top_value_text(s: Session, v: Val, fmt: str) -> str {
    var text = text_with_format(s, v, fmt, true)
    if fmt.len() == 0 {
        if v.ty == ty_codep {
            let sym = symbolize(s, as_u64(v.bytes))
            if sym.len() > 0 { text = "{text} {sym}" }
        } else {
            let (k, _) = num_class(s, v.ty)
            if k == 5 && !is_char_pointer(s, v.ty) {
                let sym = data_symbolize(s, as_u64(v.bytes))
                if sym.len() > 0 { text = "{text} {sym}" }
            }
        }
    }
    text
}

fn is_char_pointer(s: Session, ty: int) -> bool {
    let t = pointee(s, ty)
    t >= 0 && is_char_type(s.prog, t)
}

fn show_value(mut s: Session, v: Val, fmt: str) {
    let text = top_value_text(s, v, fmt)
    (mut s.hist).push(copy v)
    emit_line(mut s, "${s.hist.len} = {text}")
}

/// print[/f] EXPR
fn cmd_print(mut s: Session, rest: str) -> str {
    let (fmt, expr) = split_format(rest)
    if expr.len() == 0 {
        if s.hist.len == 0 { return "" }
        show_value(mut s, copy s.hist[s.hist.len - 1], fmt)
        return ""
    }
    let v = eval_expr(s, expr)
    if !v.ok { return v.why }
    show_value(mut s, v, fmt)
    ""
}

/// output EXPR
fn cmd_output(mut s: Session, rest: str) -> str {
    let (fmt, expr) = split_format(rest)
    let v = eval_expr(s, expr)
    if !v.ok { return v.why }
    emit(mut s, top_value_text(s, v, fmt))
    ""
}

fn pad_left_zero(text: str, width: int) -> str {
    var t = text
    while t.len() < width { t = "0{t}" }
    t
}

/// x/NFU ADDR
fn cmd_x(mut s: Session, rest: str) -> str {
    // gdb's defaults: the format and size last used; a bare `x` also keeps the count
    var count = 1
    var fmt = "x"
    var size = 4
    if s.x_ok {
        fmt = s.x_fmt
        size = s.x_size
    }
    var addr_text = rest.trim()
    if addr_text.len() == 0 && s.x_ok { count = s.x_count }
    if addr_text.starts_with("/") {
        let parts = addr_text.splitn(" ", 2)
        let spec = str_from(parts[0], 1)
        addr_text = ""
        if parts.len > 1 { addr_text = parts[1] }
        var digits = ""
        for b in spec.bytes() {
            let c = b as int
            if c >= 48 && c <= 57 { digits = "{digits}{c - 48}" }
            else if c == 98 { size = 1 } else if c == 104 { size = 2 } else if c == 119 { size = 4 } else if c == 103 { size = 8 }
            else { fmt = char_text(c) }
        }
        if digits.len() > 0 { count = parse_uint(digits).addr as int }
    }
    if fmt == "i" { return "x/i is not implemented: sniff has no disassembler" }
    var addr: u64 = 0
    if addr_text.len() == 0 {
        // no address: the memory after the last thing x examined
        if !s.x_ok { return "Argument required (starting display address)." }
        addr = s.x_next
    } else {
        let v = eval_expr(s, addr_text)
        if !v.ok { return v.why }
        addr = as_u64(v.bytes)
        if v.has_addr && v.ty >= 0 {
            let st = ty_strip(s.prog, v.ty)
            if st >= 0 && s.prog.info.entries[st].tag == tag_array { addr = v.addr }
        }
    }
    if fmt == "c" { size = 1 }
    s.x_ok = true
    s.x_count = count
    s.x_fmt = fmt
    s.x_size = size
    if fmt == "s" {
        var n = 0
        while n < count {
            let sv = read_string_at(s, addr)
            emit_line(mut s, "0x{addr:x}{label(s, addr)}:\t{sv.0}")
            addr += sv.1 as u64
            n += 1
        }
        s.x_next = addr
        return ""
    }
    let per_line = if size == 8 { 2 } else if size == 4 { 4 } else { 8 }
    var i = 0
    while i < count {
        var line = "0x{addr:x}{label(s, addr)}:"
        var k = 0
        while k < per_line && i < count {
            let r = platform.target_read(s.target, addr, size)
            if !r.ok {
                if k > 0 { emit_line(mut s, line) }
                return "Cannot access memory at address 0x{addr:x}"
            }
            let raw = as_u64(r.data)
            var item = ""
            if fmt == "x" { item = "0x{pad_left_zero("{raw:x}", size * 2)}" }
            else if fmt == "d" { item = "{signed_raw(raw, size)}" }
            else if fmt == "u" { item = "{raw}" }
            else if fmt == "o" { item = "0{octal_of(raw)}" }
            else if fmt == "t" { item = pad_left_zero(binary_of(raw), size * 8) }
            else if fmt == "c" { item = "{signed_raw(raw, 1)} '{char_escape((raw & 255) as int, 39)}'" }
            else if fmt == "a" { item = "0x{raw:x}" }
            else { item = "0x{pad_left_zero("{raw:x}", size * 2)}" }
            line = "{line}\t{item}"
            addr += size as u64
            s.x_next = addr
            k += 1
            i += 1
        }
        emit_line(mut s, line)
    }
    ""
}

fn label(s: Session, addr: u64) -> str {
    let sym = symbolize(s, addr)
    if sym.len() == 0 { return "" }
    " {sym}"
}

fn char_text(c: int) -> str {
    let b: List[byte] = [c as byte]
    str_from_utf8(b) else { "?" }
}

fn signed_raw(raw: u64, size: int) -> i64 {
    if size >= 8 { return platform.bits_i64(raw) }
    let bits = (size * 8) as u64
    if raw & ((1 as u64) << (bits - 1)) != 0 { return platform.bits_i64(raw | !(((1 as u64) << bits) - 1)) }
    platform.bits_i64(raw)
}

fn read_string_at(s: Session, addr: u64) -> (str, int) {
    var out = "\""
    var n = 0
    while n < 200 {
        let r = platform.target_read(s.target, addr + n as u64, 1)
        if !r.ok { break }
        let c = r.data[0] as int
        n += 1
        if c == 0 { return ("{out}\"", n) }
        out = "{out}{char_escape(c, 34)}"
    }
    ("{out}\"...", n)
}

#[cfg(target = "x86_64-unknown-linux-gnu")]
fn flags_text(v: u64) -> str {
    let names = ["CF", "", "PF", "", "AF", "", "ZF", "SF", "TF", "IF", "DF", "OF", "", "", "NT", "", "RF", "VM", "AC", "VIF", "VIP", "ID"]
    var out = "["
    var i = 0
    while i < names.len {
        if names[i].len() > 0 && ((v >> i as u64) & 1) == 1 { out = "{out} {names[i]}" }
        i += 1
    }
    "{out} ]"
}

/// info registers [names]
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn cmd_info_registers(mut s: Session, rest: str) -> str {
    if !s.alive { return "The program has no registers now." }
    var names: List[str] = ["rax", "rbx", "rcx", "rdx", "rsi", "rdi", "rbp", "rsp", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15", "rip", "eflags", "cs", "ss", "ds", "es", "fs", "gs", "fs_base", "gs_base"]
    let want = rest.trim()
    if want.len() > 0 {
        names = []
        for w in want.words() { (mut names).push(w.strip_prefix("$") else { w }) }
    }
    for name in names {
        let v = reg_value(s, name)
        if !v.ok { return v.why }
        let raw = as_u64(v.bytes)
        var natural = "{signed_raw(raw, 8)}"
        if name == "rbp" || name == "rsp" || name == "sp" || name == "fp" { natural = "0x{raw:x}" }
        else if name == "rip" || name == "pc" {
            natural = "0x{raw:x}"
            let sym = symbolize(s, raw)
            if sym.len() > 0 { natural = "{natural} {sym}" }
        }
        else if name == "eflags" { natural = flags_text(raw) }
        else if name == "cs" || name == "ss" || name == "ds" || name == "es" || name == "fs" || name == "gs" { natural = "{raw}" }
        let hex = "0x{raw:x}"
        emit_line(mut s, "{name}{" ".repeat(15 - name.len())}{hex}{" ".repeat(19 - hex.len())} {natural}")
    }
    ""
}

/// aarch64 cpsr as gdb's flags type prints it: the exception level, then the set flags from the low bit up.
#[cfg(target = "aarch64-apple-darwin")]
fn cpsr_text(v: u64) -> str {
    var out = "[ EL={(v >> 2) & 3}"
    let names = ["SP", "", "", "", "nRW", "", "F", "I", "A", "D", "", "", "SSBS", "", "", "", "", "", "", "", "IL", "SS", "PAN", "UAO", "DIT", "TCO", "", "", "V", "C", "Z", "N"]
    var i = 0
    while i < names.len {
        if names[i].len() > 0 && ((v >> i as u64) & 1) == 1 { out = "{out} {names[i]}" }
        i += 1
    }
    let bt = (v >> 10) & 3
    if bt != 0 { out = "{out} BTYPE={bt}" }
    "{out} ]"
}

/// info registers [names]: x0-x30, sp, pc, cpsr, fpsr and fpcr, in gdb's aarch64 layout.
#[cfg(target = "aarch64-apple-darwin")]
fn cmd_info_registers(mut s: Session, rest: str) -> str {
    if !s.alive { return "The program has no registers now." }
    var names: List[str] = []
    var k = 0
    while k <= 30 { (mut names).push("x{k}"); k += 1 }
    (mut names).push("sp")
    (mut names).push("pc")
    (mut names).push("cpsr")
    (mut names).push("fpsr")
    (mut names).push("fpcr")
    let want = rest.trim()
    if want.len() > 0 {
        names = []
        for w in want.words() { (mut names).push(w.strip_prefix("$") else { w }) }
    }
    for name in names {
        var raw: u64 = 0
        var natural = ""
        if name == "fpsr" || name == "fpcr" {
            let fp = platform.target_fp_status(s.target)
            if fp.len != 2 { return "The program has no registers now." }
            raw = if name == "fpsr" { fp[0] } else { fp[1] }
            natural = "{raw}"
        } else {
            let v = reg_value(s, name)
            if !v.ok { return v.why }
            raw = as_u64(v.bytes)
            natural = "{signed_raw(raw, 8)}"
            let slot = reg_slot(name)
            if slot == 29 || slot == 31 { natural = "0x{raw:x}" }
            else if slot == 30 || slot == 32 {
                natural = "0x{raw:x}"
                let sym = symbolize(s, raw)
                if sym.len() > 0 { natural = "{natural} {sym}" }
            }
            else if slot == 33 { natural = cpsr_text(raw); raw = raw & 4294967295 }
        }
        let hex = "0x{raw:x}"
        emit_line(mut s, "{name}{" ".repeat(15 - name.len())}{hex}{" ".repeat(19 - hex.len())} {natural}")
    }
    ""
}
