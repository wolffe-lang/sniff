// `help`: gdb's command classes, restricted to the commands sniff implements, and each command's
// paragraph. Every names line and summary is the pinned gdb's text, and so is every paragraph that
// describes what sniff does; where gdb's paragraph describes what sniff does not have, the paragraph is
// sniff's own and says what is not implemented yet. A gdb command sniff lacks is named as such.
// Generated from the pinned gdb's help output; tests/session-rows.json's help rows hold it to gdb.

/// One command or subcommand as `help` shows it.
struct HelpCmd {
    pub name: str,
    /// The aliases gdb registers, in gdb's order (its "NAME, ALIAS..." line).
    pub aliases: List[str],
    pub class: str,
    pub summary: str,
    pub body: List[str],
}

/// sniff's commands and subcommands, in gdb's (alphabetical) order.
fn help_table() -> List[HelpCmd] {
    [
        HelpCmd { name: "attach", aliases: [], class: "running", summary: "Attach to a process or file outside of GDB.",
            body: [
                "Usage: attach PID",
                "The process stops where it is, every thread of it, and is shown where it stopped. sniff reads its",
                "program from the file named on sniff's command line. A device file, as gdb takes, is not implemented",
                "yet. sniff -p PID attaches before the command file is read.",
            ] },
        HelpCmd { name: "awatch", aliases: [], class: "breakpoints", summary: "Set an access watchpoint for EXPRESSION.",
            body: [
                "Usage: awatch EXPRESSION",
                "",
                "An access watchpoint stops execution of your program whenever the value",
                "of an expression is either read or written.",
                "sniff's watchpoints are hardware watchpoints: the place EXPRESSION names",
                "must be 1, 2, 4 or 8 bytes, aligned to its size.  -location is not implemented yet.",
            ] },
        HelpCmd { name: "backtrace", aliases: ["where", "bt"], class: "stack", summary: "Print backtrace of all stack frames, or innermost COUNT frames.",
            body: [
                "Usage: backtrace",
                "Every frame is printed, innermost first.  COUNT, -COUNT, the options",
                "(-full, -entry-values, -frame-arguments and the others) and the",
                "qualifiers are not implemented yet.",
            ] },
        HelpCmd { name: "break", aliases: ["brea", "bre", "br", "b"], class: "breakpoints", summary: "Set breakpoint at specified location.",
            body: [
                "break [LOCATION] [if CONDITION]",
                "LOCATION is one of:",
                "  FUNCTION, the function's first line past its prologue,",
                "  LINENUM, a line of the current source file,",
                "  FILE:LINENUM or FILE:FUNCTION, in the source file FILE,",
                "  *ADDRESS, an address, or a function's name and an optional +OFFSET.",
                "CONDITION is an expression: the program stops at the breakpoint only",
                "when it is true.",
                "",
                "A LOCATION is required.  Probe points, threads, explicit locations,",
                "-qualified and -force-condition are not implemented yet.",
            ] },
        HelpCmd { name: "call", aliases: [], class: "data", summary: "Call a function in the program.",
            body: [
                "Usage: call EXP",
                "sniff prints the value of EXP as \"print\" does: calling a function of the",
                "program is not implemented yet.",
            ] },
        HelpCmd { name: "condition", aliases: [], class: "breakpoints", summary: "Specify breakpoint number N to break only if COND is true.",
            body: [
                "Usage is `condition N COND', where N is an integer and COND",
                "is an expression to be evaluated whenever breakpoint N is reached.",
                "The -force option is not implemented yet.",
            ] },
        HelpCmd { name: "continue", aliases: ["fg", "c"], class: "running", summary: "Continue program being debugged, after signal or breakpoint.",
            body: [
                "Usage: continue",
                "The program runs until it stops again.  A count N (an ignore count for the",
                "breakpoint it stopped at), non-stop mode and -a are not implemented yet.",
            ] },
        HelpCmd { name: "delete", aliases: ["del", "d"], class: "breakpoints", summary: "Delete all or some breakpoints.",
            body: [
                "Usage: delete [BREAKPOINTNUM]...",
                "Arguments are breakpoint numbers with spaces in between.",
                "To delete all breakpoints and watchpoints, give no argument.",
                "",
                "\"delete display\" and gdb's other delete subcommands are not implemented yet.",
            ] },
        HelpCmd { name: "detach", aliases: [], class: "running", summary: "Detach a process or file previously attached.",
            body: [
                "Usage: detach",
                "The process is no longer traced and goes on as it was. detach checkpoint and detach inferiors are",
                "not implemented yet.",
            ] },
        HelpCmd { name: "display", aliases: [], class: "data", summary: "Print value of expression EXP each time the program stops.",
            body: [
                "Usage: display[/FMT] EXP",
                "/FMT may be used before EXP as in the \"print\" command.",
                "",
                "With no argument, display all currently requested auto-display expressions.",
                "Use \"undisplay\" to cancel display requests previously made.",
                "The \"x\" command's /i and /s formats and size letters are not implemented yet.",
            ] },
        HelpCmd { name: "down", aliases: ["dow", "do"], class: "stack", summary: "Select and print stack frame called by this one.",
            body: [
                "An argument says how many frames down to go.",
            ] },
        HelpCmd { name: "echo", aliases: [], class: "support", summary: "Print a constant string.  Give string as argument.",
            body: [
                "C escape sequences may be used in the argument.",
                "No newline is added at the end of the argument;",
                "use \"\\n\" if you want a newline to be printed.",
                "Since leading and trailing whitespace are ignored in command arguments,",
                "if you want to print some you must use \"\\\" before leading whitespace",
                "to be printed or after trailing whitespace.",
            ] },
        HelpCmd { name: "finish", aliases: ["fin"], class: "running", summary: "Execute until selected stack frame returns.",
            body: [
                "Usage: finish",
                "Upon return, the value returned is printed and put in the value history.",
            ] },
        HelpCmd { name: "frame", aliases: ["f"], class: "stack", summary: "Select and print a stack frame.",
            body: [
                "With no argument, print the selected stack frame.",
                "A single numerical argument specifies the frame to select.",
                "",
                "The frame subcommands (address, apply, function, level and view) and",
                "\"info frame\" are not implemented yet.",
            ] },
        HelpCmd { name: "handle", aliases: [], class: "running", summary: "Specify how to handle signals.",
            body: [
                "Usage: handle SIGNAL [ACTIONS]",
                "Args are signals and actions to apply to those signals.",
                "If no actions are specified, the current settings for the specified signals",
                "will be displayed instead.",
                "",
                "Symbolic signals (e.g. SIGSEGV) are recommended but numeric signals",
                "from 1-15 are allowed for compatibility with old versions of GDB.",
                "Numeric ranges may be specified with the form LOW-HIGH (e.g. 1-5).",
                "The special arg \"all\" is recognized to mean all signals except those",
                "used by the debugger, typically SIGTRAP and SIGINT.",
                "",
                "Recognized actions include \"stop\", \"nostop\", \"print\", \"noprint\",",
                "\"pass\", \"nopass\", \"ignore\", or \"noignore\".",
                "Stop means reenter debugger if this signal happens (implies print).",
                "Print means print a message if this signal happens.",
                "Pass means let program see this signal; otherwise program doesn't know.",
                "Ignore is a synonym for nopass and noignore is a synonym for pass.",
                "Pass and Stop may be combined.",
                "",
                "Multiple signals may be specified.  Signal numbers and signal names",
                "may be interspersed with actions, with the actions being performed for",
                "all signals cumulatively specified.",
            ] },
        HelpCmd { name: "help", aliases: ["h"], class: "support", summary: "Print list of commands.",
            body: [] },
        HelpCmd { name: "ignore", aliases: [], class: "breakpoints", summary: "Set ignore-count of breakpoint number N to COUNT.",
            body: [
                "Usage is `ignore N COUNT'.",
            ] },
        HelpCmd { name: "info", aliases: ["inf", "i"], class: "status", summary: "Generic command for showing things about the program being debugged.",
            body: [] },
        HelpCmd { name: "info all-registers", aliases: [], class: "status", summary: "List of all registers and their contents, for selected stack frame.",
            body: [
                "sniff prints the general registers, as \"info registers\" does: the floating",
                "point and vector registers are not implemented yet.",
            ] },
        HelpCmd { name: "info args", aliases: [], class: "status", summary: "All argument variables of current stack frame or those matching REGEXPs.",
            body: [
                "Usage: info args",
                "Prints the argument variables of the current stack frame.",
                "The -q and -t TYPEREGEXP options and NAMEREGEXP are not implemented yet.",
            ] },
        HelpCmd { name: "info breakpoints", aliases: ["info b"], class: "status", summary: "Status of specified breakpoints (all user-settable breakpoints if no argument).",
            body: [
                "The \"Type\" column is breakpoint, hw watchpoint, read watchpoint or acc watchpoint.",
                "The \"Disp\" column is \"keep\", or \"del\" for a temporary breakpoint.  The",
                "\"Address\" and \"What\" columns indicate the address and file/line number respectively.",
                "Every breakpoint and watchpoint is listed: a breakpoint number argument is not",
                "implemented yet.",
            ] },
        HelpCmd { name: "info display", aliases: [], class: "status", summary: "Expressions to display when program stops, with code numbers.",
            body: [
                "Usage: info display",
            ] },
        HelpCmd { name: "info locals", aliases: [], class: "status", summary: "All local variables of current stack frame or those matching REGEXPs.",
            body: [
                "Usage: info locals",
                "Prints the local variables of the current stack frame.",
                "The -q and -t TYPEREGEXP options and NAMEREGEXP are not implemented yet.",
            ] },
        HelpCmd { name: "info registers", aliases: ["info r"], class: "status", summary: "List of integer registers and their contents, for selected stack frame.",
            body: [
                "One or more register names as argument means describe the given registers.",
                "Register groups are not implemented yet.",
            ] },
        HelpCmd { name: "info signals", aliases: ["info handle"], class: "status", summary: "What debugger does when program gets various signals.",
            body: [
                "Specify a signal as argument to print info on that signal only.",
            ] },
        HelpCmd { name: "info threads", aliases: [], class: "status", summary: "Display currently known threads.",
            body: [
                "Usage: info threads [OPTION]... [ID]...",
                "If ID is given, it is a space-separated list of IDs of threads to display.",
                "Otherwise, all threads are displayed.",
                "The -gid option is not implemented yet.",
            ] },
        HelpCmd { name: "info watchpoints", aliases: [], class: "status", summary: "Status of specified watchpoints (all watchpoints if no argument).",
            body: [
                "Every watchpoint is listed: a watchpoint number argument is not implemented yet.",
            ] },
        HelpCmd { name: "kill", aliases: [], class: "running", summary: "Kill execution of program being debugged.",
            body: [
                "Usage: kill",
                "sniff debugs one program at a time: \"kill inferiors\" is not implemented yet.",
            ] },
        HelpCmd { name: "list", aliases: ["l"], class: "files", summary: "List specified function or line.",
            body: [
                "With no argument, lists ten more lines after or around previous listing.",
                "\"list +\" lists the ten lines following a previous ten-line listing.",
                "\"list -\" lists the ten lines before a previous ten-line listing.",
                "\"list .\" lists ten lines around the point of execution in the current frame.",
                "One argument specifies a line, and ten lines are listed around that line.",
                "Two arguments with comma between specify starting and ending lines to list.",
                "Lines can be specified in these ways:",
                "  LINENUM, to list around that line in current file,",
                "  FILE:LINENUM, to list around that line in that file,",
                "  FUNCTION, to list around beginning of that function,",
                "  FILE:FUNCTION, to distinguish among like-named static functions.",
                "  *ADDRESS, to list around the line containing that address.",
                "With two args, if one is empty, it stands for ten lines away from",
                "the other arg.",
                "",
                "sniff always lists ten lines: \"set listsize\" is not implemented yet.",
            ] },
        HelpCmd { name: "maintenance", aliases: ["mt"], class: "internals", summary: "sniff's own maintenance commands.",
            body: [] },
        HelpCmd { name: "maintenance frames", aliases: [], class: "internals", summary: "Name how each frame of the stack was unwound.",
            body: [
                "Usage: maintenance frames",
                "Each frame is named with unwind=cfi (its call frame information),",
                "unwind=frame-pointer (the frame-pointer fallback) or, for the last frame, unwind=outermost.",
                "This is sniff's own command; gdb has no maintenance command of this name.",
            ] },
        HelpCmd { name: "next", aliases: ["n"], class: "running", summary: "Step program, proceeding through subroutine calls.",
            body: [
                "Usage: next [N]",
                "Unlike \"step\", if the current source line calls a subroutine,",
                "this command does not enter the subroutine, but instead steps over",
                "the call, in effect treating it as a single source line.",
            ] },
        HelpCmd { name: "nexti", aliases: ["ni"], class: "running", summary: "Step one instruction, but proceed through subroutine calls.",
            body: [
                "Usage: nexti [N]",
                "Argument N means step N times (or till program stops for another reason).",
            ] },
        HelpCmd { name: "output", aliases: [], class: "data", summary: "Like \"print\" but don't put in value history and don't print newline.",
            body: [
                "Usage: output EXP",
                "This is useful in user-defined commands.",
            ] },
        HelpCmd { name: "print", aliases: ["inspect", "p"], class: "data", summary: "Print value of expression EXP.",
            body: [
                "Usage: print [/FMT] [EXP]",
                "",
                "Variables accessible are those of the lexical environment of the selected",
                "stack frame, plus all those whose scope is global or an entire file.",
                "A C program's frames read EXP as C, a wolf program's as wolf.",
                "",
                "$NUM gets previous value number NUM.  $ is the last value.",
                "Names starting with $ refer to registers.",
                "",
                "EXP may be preceded with /FMT, where FMT is a format letter",
                "but no count or size letter (see \"x\" command).  With no EXP, the last",
                "value is printed again.",
                "",
                "The options, $$, convenience variables, assignment, {{TYPE}}ADREXP and @",
                "are not implemented yet.",
            ] },
        HelpCmd { name: "quit", aliases: ["exit", "q"], class: "support", summary: "Exit sniff.",
            body: [
                "Usage: quit",
                "The program being debugged is killed.  An exit code EXPR is not implemented yet.",
            ] },
        HelpCmd { name: "run", aliases: ["r"], class: "running", summary: "Start debugged program.",
            body: [
                "You may specify arguments to give it, separated by spaces.  sniff passes them",
                "to the program as they are typed: there is no shell between, so \"*\" and \"[...]\"",
                "are not expanded and \">\", \"<\" and \">>\" do not redirect.",
                "",
                "With no arguments, uses arguments last specified (with \"run\" or the --args",
                "of sniff's command line).  \"set args\" is not implemented yet.",
            ] },
        HelpCmd { name: "rwatch", aliases: [], class: "breakpoints", summary: "Set a read watchpoint for EXPRESSION.",
            body: [
                "Usage: rwatch EXPRESSION",
                "",
                "A read watchpoint stops execution of your program whenever the value of",
                "an expression is read.",
                "sniff's watchpoints are hardware watchpoints: the place EXPRESSION names",
                "must be 1, 2, 4 or 8 bytes, aligned to its size.  -location is not implemented yet.",
            ] },
        HelpCmd { name: "signal", aliases: [], class: "running", summary: "Continue program with the specified signal.",
            body: [
                "Usage: signal SIGNAL",
                "The SIGNAL argument is processed the same as the handle command.",
                "",
                "An argument of \"0\" means continue the program without sending it a signal.",
                "This is useful in cases where the program stopped because of a signal,",
                "and you want to resume the program while discarding the signal.",
                "",
                "In a multi-threaded program the signal is delivered to, or discarded from,",
                "the current thread only.",
            ] },
        HelpCmd { name: "step", aliases: ["s"], class: "running", summary: "Step program until it reaches a different source line.",
            body: [
                "Usage: step [N]",
                "Argument N means step N times (or till program stops for another reason).",
            ] },
        HelpCmd { name: "stepi", aliases: ["si"], class: "running", summary: "Step one instruction exactly.",
            body: [
                "Usage: stepi [N]",
                "Argument N means step N times (or till program stops for another reason).",
            ] },
        HelpCmd { name: "tbreak", aliases: [], class: "breakpoints", summary: "Set a temporary breakpoint.",
            body: [
                "Like \"break\" except the breakpoint is only temporary,",
                "so it will be deleted when hit.",
                "",
                "tbreak [LOCATION] [if CONDITION]",
                "LOCATION and CONDITION are as for \"break\".",
            ] },
        HelpCmd { name: "thread", aliases: ["t"], class: "running", summary: "Use this command to switch between threads.",
            body: [
                "The new thread ID must be currently known.",
                "Usage: thread [ID]",
                "With no ID, the current thread is named. thread apply, thread find and thread name",
                "are not implemented yet.",
            ] },
        HelpCmd { name: "undisplay", aliases: [], class: "data", summary: "Cancel some expressions to be displayed when program stops.",
            body: [
                "Usage: undisplay [NUM]...",
                "Arguments are the code numbers of the expressions to stop displaying.",
                "No argument means cancel all automatic-display expressions.",
                "Do \"info display\" to see current list of code numbers.",
                "\"delete display\" is not implemented yet.",
            ] },
        HelpCmd { name: "until", aliases: ["u"], class: "running", summary: "Execute until past the current line or past a LOCATION.",
            body: [
                "Usage: until",
                "Execute until the program reaches a source line greater than the current",
                "within the current frame.",
                "until LOCATION is not implemented yet: an argument is read as a repeat count.",
            ] },
        HelpCmd { name: "up", aliases: [], class: "stack", summary: "Select and print stack frame that called this one.",
            body: [
                "An argument says how many frames up to go.",
            ] },
        HelpCmd { name: "watch", aliases: [], class: "breakpoints", summary: "Set a watchpoint for EXPRESSION.",
            body: [
                "Usage: watch EXPRESSION",
                "",
                "A watchpoint stops execution of your program whenever the value of",
                "an expression changes.",
                "sniff's watchpoints are hardware watchpoints: the place EXPRESSION names",
                "must be 1, 2, 4 or 8 bytes, aligned to its size.  -location is not implemented yet.",
            ] },
        HelpCmd { name: "x", aliases: [], class: "data", summary: "Examine memory: x/FMT ADDRESS.",
            body: [
                "ADDRESS is an expression for the memory address to examine.",
                "FMT is a repeat count followed by a format letter and a size letter.",
                "Format letters are o(octal), x(hex), d(decimal), u(unsigned decimal),",
                "  t(binary), a(address), c(char) and s(string).",
                "Size letters are b(byte), h(halfword), w(word), g(giant, 8 bytes).",
                "The specified number of objects of the specified size are printed",
                "according to the format.",
                "",
                "With no ADDRESS, the memory after the last thing this command examined",
                "is examined, with the count, format and size it used.",
                "f(float), i(instruction), z(hex, zero padded on the left) and negative",
                "counts are not implemented yet.",
            ] },
    ]
}

/// A class of sniff's commands: its name and gdb's description.
struct HelpClass {
    pub name: str,
    pub doc: str,
}

/// The classes of sniff's commands, in gdb's order.
fn help_classes() -> List[HelpClass] {
    [
        HelpClass { name: "breakpoints", doc: "Making program stop at certain points." },
        HelpClass { name: "data", doc: "Examining data." },
        HelpClass { name: "files", doc: "Specifying and examining files." },
        HelpClass { name: "internals", doc: "Maintenance commands." },
        HelpClass { name: "running", doc: "Running the program." },
        HelpClass { name: "stack", doc: "Examining the stack." },
        HelpClass { name: "status", doc: "Status inquiries." },
        HelpClass { name: "support", doc: "Support facilities." },
    ]
}

/// gdb's top-level commands and aliases that sniff does not implement (from the pinned gdb's `help all`).
fn gdb_only_commands() -> List[str] {
[
    "!", "+", "-", "<", ">", "actions", "add-auto-load-safe-path", "add-auto-load-scripts-directory",
    "add-inferior", "add-symbol-file", "add-symbol-file-from-memory", "advance", "agent-printf", "alias",
    "append", "apropos", "break-range", "catch", "cd", "checkpoint", "cl", "clear", "clone-inferior",
    "collect", "commands", "compare-sections", "compile", "complete", "core-file", "define", "define-prefix",
    "demangle", "directory", "dis", "disa", "disable", "disassemble", "disconnect", "document",
    "dont-repeat", "down-silently", "dprintf", "dump", "edit", "en", "enable", "end", "eval", "exec-file",
    "explore", "expression", "faas", "file", "find", "flash-erase", "fo", "focus", "forward-search", "fs",
    "ftrace", "function", "gcore", "generate-core-file", "gr", "gu", "guile", "guile-repl", "hbreak",
    "if", "inferior", "init-if-undefined", "interpreter-exec", "interrupt", "j", "jit-reader-load",
    "jit-reader-unload", "jump", "layout", "load", "macro", "make", "mem", "memory-tag", "monitor", "new-ui",
    "nosharedlibrary", "ov", "overlay", "ovly", "passcount", "path", "pi", "pipe", "po", "print-object",
    "printf", "ptype", "pwd", "py", "python", "python-interactive", "queue-signal", "rbreak", "rc", "rec",
    "record", "refresh", "remote", "remove-inferiors", "remove-symbol-file", "restart", "restore", "return",
    "rev", "reverse-continue", "reverse-finish", "reverse-next", "reverse-nexti", "reverse-search",
    "reverse-step", "reverse-stepi", "rn", "rni", "rs", "rsi", "save", "search", "section", "select-frame",
    "set", "sharedlibrary", "shell", "show", "skip", "source", "start", "starti", "stepping", "stop",
    "strace", "symbol-file", "taas", "target", "task", "tcatch", "tdump", "teval", "tfaas", "tfind",
    "thbreak", "tp", "tr", "tra", "trac", "trace", "tsave", "tstart", "tstatus", "tstop", "tty",
    "tui", "tvariable", "unset", "up-silently", "update", "w", "wh", "whatis", "while", "while-stepping",
    "winheight", "winwidth", "with", "ws", "|"
]
}

/// gdb's info subcommands and their aliases that sniff does not implement (from the pinned gdb's `help info`).
fn gdb_only_info() -> List[str] {
[
    "address", "auto-load", "auxv", "bookmarks", "checkpoints", "classes", "common", "connections", "copying",
    "dcache", "dll", "exceptions", "extensions", "f", "files", "float", "frame", "frame-filter", "functions",
    "gu", "guile", "inferiors", "line", "macro", "macros", "main", "mem", "missing-debug-handlers",
    "module", "modules", "os", "pretty-printer", "probes", "proc", "program", "rec", "record", "s", "scope",
    "selectors", "sharedlibrary", "skip", "source", "sources", "stack", "static-tracepoint-markers",
    "symbol", "target", "tasks", "terminal", "tp", "tracepoints", "tvariables", "type-printers",
    "types", "unwinder", "variables", "vector", "vtbl", "warranty", "win", "xmethod"
]
}
