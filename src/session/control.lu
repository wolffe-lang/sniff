// Run control: start, resume, wait, breakpoint insertion, the stepped-over
// original instruction, and the report of how a resume ended.

use platform

fn parse_hex(text: str) -> u64 {
    var v: u64 = 0
    for b in text.bytes() {
        let c = b as int
        var d = 0
        if c >= 48 && c <= 57 { d = c - 48 }
        else if c >= 97 && c <= 102 { d = c - 87 }
        else if c >= 65 && c <= 70 { d = c - 55 }
        else { return v }
        v = v * 16 + d as u64
    }
    v
}

/// Lowest mapping start of the file at path in /proc/PID/maps (proc(5)).
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn exe_base(pid: int, path: str) -> u64 {
    let raw = fs_read_bytes("/proc/{pid}/maps") else { return 0 }
    let text = str_from_utf8(raw) else { return 0 }
    for ln in text.lines() {
        if !ln.ends_with(path) { continue }
        let parts = ln.split("-")
        if parts.len < 2 { continue }
        return parse_hex(parts[0])
    }
    0
}

/// The load slide of the main image: the runtime address of its first byte minus the file's.
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn image_base(s: Session, t: platform.Target) -> u64 {
    if s.prog.pie { return exe_base(t.pid, s.prog.path) }
    0
}

/// The load slide of the main image: its Mach-O header is found among the task's regions.
#[cfg(target = "aarch64-apple-darwin")]
fn image_base(s: Session, t: platform.Target) -> u64 {
    let b = platform.target_image_base(t)
    if b == 0 { return 0 }
    b - s.prog.text_addr
}

/// The runtime address of a file address.
fn rt(s: Session, a: u64) -> u64 { a + s.base }

/// The bytes of a replaced instruction as one integer (little endian), at most 8.
fn pack_bytes(b: List[byte]) -> int {
    var v: int = 0
    var i = b.len
    while i > 0 {
        i -= 1
        v = v * 256 + (b[i] as int)
    }
    v
}

/// The first n bytes of v, little endian.
fn unpack_bytes(v: int, n: int) -> List[byte] {
    var out: List[byte] = []
    var x = v
    var i = 0
    while i < n {
        (mut out).push((x % 256) as byte)
        x = x / 256
        i += 1
    }
    out
}

/// The runtime address of breakpoint i: a literal address stays as typed.
fn bp_rt(s: Session, i: int) -> u64 {
    if s.bps[i].abs { return s.bps[i].addr }
    s.bps[i].addr + s.base
}

/// Start the program stopped at its exec. Returns "" or a reason.
fn start_process(mut s: Session) -> str {
    if s.alive { kill_process(mut s) }
    let t = platform.target_spawn(s.prog.path, s.args, "24", "80")
    if t.pid == 0 {
        let why = platform.target_refusal(t)
        if why.len() > 0 { return why }
        return "Cannot start {s.prog.path}"
    }
    s.target = copy t
    s.alive = true
    s.watch_armed = false
    s.pending_signal = 0
    s.base = image_base(s, t)
    ""
}

/// Kill the child and reap it. Quiet; reports are the caller's.
fn kill_process(mut s: Session) {
    if !s.alive { return }
    let _ = platform.target_kill(s.target)
    s.alive = false
    s.target = platform.target_none()
}

/// Insert every enabled breakpoint. Returns the index of one that could not be
/// placed (its address is not mapped), or -1.
fn insert_all(mut s: Session) -> int {
    var i: int = 0
    while i < s.bps.len {
        if s.bps[i].enabled && !s.bps[i].inserted {
            let a = bp_rt(s, i)
            // a second breakpoint at an address already patched shares the saved byte
            var twin = -1
            var k: int = 0
            while k < i {
                if s.bps[k].inserted && bp_rt(s, k) == a { twin = k }
                k += 1
            }
            var placed = false
            if twin >= 0 {
                s.bps[i].orig = s.bps[twin].orig
                s.bps[i].inserted = true
                placed = true
            } else {
                let insn = platform.arch_bp_insn()
                let r = platform.target_read(s.target, a, insn.len)
                if r.ok {
                    s.bps[i].orig = pack_bytes(r.data)
                    placed = platform.target_write(s.target, a, insn)
                    s.bps[i].inserted = placed
                }
            }
            if !placed && !s.bps[i].internal {
                remove_all(mut s)
                return i
            }
        }
        i += 1
    }
    0 - 1
}

fn remove_all(mut s: Session) {
    // last in, first out: the first breakpoint at an address holds the true byte
    var i: int = s.bps.len - 1
    while i >= 0 {
        if s.bps[i].inserted {
            let a = bp_rt(s, i)
            let _ = platform.target_write(s.target, a, unpack_bytes(s.bps[i].orig, platform.arch_bp_insn().len))
            s.bps[i].inserted = false
        }
        i -= 1
    }
}

/// The current pc, or 0 when no registers can be read.
fn current_pc(s: Session) -> u64 {
    let regs = platform.target_regs(s.target)
    if regs.len != platform.arch_nregs() { return 0 }
    regs[platform.arch_pc_slot()]
}

fn set_pc(s: Session, pc: u64) {
    var regs = platform.target_regs(s.target)
    if regs.len != platform.arch_nregs() { return }
    regs[platform.arch_pc_slot()] = pc
    let _ = platform.target_set_regs(s.target, regs)
}

fn bp_at(s: Session, addr: u64) -> int {
    var i: int = 0
    while i < s.bps.len {
        if s.bps[i].enabled && bp_rt(s, i) == addr { return i }
        i += 1
    }
    -1
}

fn forget_inserted(mut s: Session) {
    var i: int = 0
    while i < s.bps.len { s.bps[i].inserted = false; i += 1 }
}

fn lost() -> Event { Event { kind: ev_lost, signal: 0, code: 0, bp: 0 } }

/// A fork or vfork stop: restore the breakpoints in the new child's copy of
/// memory, detach it (S2 follows the parent only) and report it.
fn handle_fork(mut s: Session, st: int) {
    let child = platform.target_event_pid(s.target)
    if child <= 0 { return }
    let _ = platform.target_wait_pid(s.target, child)
    let ct = platform.target_with_pid(s.target, child)
    var i: int = 0
    while i < s.bps.len {
        if s.bps[i].inserted {
            let _ = platform.target_write(ct, bp_rt(s, i), unpack_bytes(s.bps[i].orig, platform.arch_bp_insn().len))
        }
        i += 1
    }
    let _ = platform.target_detach(ct, child)
    emit_line(mut s, "[Detaching after fork from child process {child}]")
}

fn is_fork_event(st: int) -> bool {
    platform.status_stopped(st) && (st >> 16) != 0 && (st >> 16) <= 3 && platform.status_stop_signal(st) == 5
}

/// Classify a raw wait status. A SIGTRAP at a breakpoint's address, plus the
/// bytes the trap leaves the pc past (one after int3, Intel SDM; none after
/// BRK, Arm ARM), is that breakpoint; the pc is wound back. A signal delivered
/// as a Unix signal (status kind 259 on macOS) is never a breakpoint.
fn classify(mut s: Session, st: int, stepping: bool) -> Event {
    if st < 0 { s.alive = false; return lost() }
    if platform.status_exited(st) {
        s.alive = false
        forget_inserted(mut s)
        return Event { kind: ev_exited, signal: 0, code: platform.status_exit_code(st), bp: 0 }
    }
    if platform.status_signaled(st) {
        s.alive = false
        forget_inserted(mut s)
        return Event { kind: ev_signaled, signal: platform.status_term_signal(st), code: 0, bp: 0 }
    }
    let sig = platform.status_stop_signal(st)
    if sig == 5 {
        let pc = current_pc(s)
        if !stepping && pc > 0 && (st >> 16) != 259 {
            let adjust = platform.arch_trap_adjust()
            let at = bp_at(s, pc - adjust)
            if at >= 0 {
                if adjust > 0 { set_pc(s, pc - adjust) }
                return Event { kind: ev_breakpoint, signal: 5, code: 0, bp: at }
            }
        }
        if stepping { return Event { kind: ev_stepped, signal: 5, code: 0, bp: -1 } }
        return Event { kind: ev_signal, signal: 5, code: 0, bp: -1 }
    }
    Event { kind: ev_signal, signal: sig, code: 0, bp: -1 }
}

fn take_signal(mut s: Session) -> int {
    let sig = s.pending_signal
    s.pending_signal = 0
    sig
}

/// Execute one instruction with breakpoints out of the way.
fn step_insn(mut s: Session) -> Event {
    flush_out(mut s)
    s.frames_ok = false
    let sig = take_signal(mut s)
    let refused = arm_watches(mut s)
    if refused.len() > 0 { s.errmsg = refused; return Event { kind: ev_error, signal: 0, code: 0, bp: -1 } }
    if platform.target_step(s.target, sig) < 0 { s.alive = false; return lost() }
    var st = platform.target_wait(s.target)
    if st >= 0 && platform.status_stopped(st) && platform.status_stop_signal(st) == 5 {
        let w = watch_hit(mut s)
        if w >= 0 { return Event { kind: ev_watch, signal: 5, code: 0, bp: w } }
    }
    if st >= 0 && is_fork_event(st) {
        handle_fork(mut s, st)
        if platform.target_step(s.target, 0) < 0 { s.alive = false; return lost() }
        st = platform.target_wait(s.target)
    }
    classify(mut s, st, true)
}

/// cont_event, but a user breakpoint with an ignore count passes silently
/// (its hit still counts), as gdb's ignore does.
fn cont_user(mut s: Session) -> Event {
    loop {
        let e = cont_event(mut s)
        if e.kind != ev_breakpoint || s.bps[e.bp].internal { return e }
        // a breakpoint whose condition is false passes silently and does not count the hit
        if !condition_holds(mut s, e.bp) { continue }
        let pc = bp_rt(s, e.bp)
        var skip = false
        var i: int = 0
        while i < s.bps.len {
            if s.bps[i].enabled && !s.bps[i].internal && bp_rt(s, i) == pc && s.bps[i].ignore > 0 {
                s.bps[i].ignore -= 1
                s.bps[i].hits += 1
                skip = true
            }
            i += 1
        }
        if !skip { return e }
    }
}

/// Continue until a breakpoint, a stopping signal or the end of the program.
/// A breakpoint at the current pc is stepped over first: its instruction runs
/// with the int3 removed, then breakpoints go back in.
fn cont_event(mut s: Session) -> Event {
    s.frames_ok = false
    let pc = current_pc(s)
    if bp_at(s, pc) >= 0 {
        let e = step_insn(mut s)
        if e.kind != ev_stepped { return e }
        // the step may itself land on a breakpoint address
        let here = current_pc(s)
        let hit = bp_at(s, here)
        if hit >= 0 { return Event { kind: ev_breakpoint, signal: 5, code: 0, bp: hit } }
    }
    loop {
        let bad = insert_all(mut s)
        if bad >= 0 {
            let at = bp_rt(s, bad)
            s.errmsg = "Warning:\nCannot insert breakpoint {s.bps[bad].num}.\nCannot access memory at address 0x{at:x}\n"
            return Event { kind: ev_error, signal: 0, code: 0, bp: bad }
        }
        flush_out(mut s)
        let sig = take_signal(mut s)
        let refused = arm_watches(mut s)
        if refused.len() > 0 {
            remove_all(mut s)
            s.errmsg = refused
            return Event { kind: ev_error, signal: 0, code: 0, bp: -1 }
        }
        if platform.target_cont(s.target, sig) < 0 { s.alive = false; return lost() }
        var st = platform.target_wait(s.target)
        if st >= 0 && is_fork_event(st) {
            handle_fork(mut s, st)
            continue
        }
        if st >= 0 && platform.status_stopped(st) {
            remove_all(mut s)
        }
        if st >= 0 && platform.status_stopped(st) && platform.status_stop_signal(st) == 5 {
            // a data watch traps after the access, with no breakpoint byte to wind back over
            let w = watch_hit(mut s)
            if w >= 0 { return Event { kind: ev_watch, signal: 5, code: 0, bp: w } }
            if w == 0 - 2 { continue }
        }
        let e = classify(mut s, st, false)
        if e.kind == ev_breakpoint && s.bps[e.bp].scope > 0 {
            if scope_ended(mut s, e.bp) { return Event { kind: ev_scope, signal: 5, code: 0, bp: -1 } }
            // a deeper call of the same function returned: step over the breakpoint and run on
            return cont_event(mut s)
        }
        if e.kind == ev_signal && e.signal != 5 {
            if !signal_stops(e.signal) {
                if signal_passes(e.signal) { s.pending_signal = e.signal }
                continue
            }
            if signal_passes(e.signal) { s.pending_signal = e.signal }
        }
        return e
    }
}
