// The gdb command language, as far as S2 covers it. Each command returns ""
// on success or the message gdb would print as an error.

use std.io


/// gdb prints an exit code as %#o: a leading zero and octal digits.
fn octal2(n: int) -> str {
    var digits = ""
    var v = n
    while v > 0 {
        let d = v % 8
        digits = "{d}{digits}"
        v = v / 8
    }
    "0{digits}"
}

/// The report line(s) for the end of a program.
fn report_end(mut s: Session, e: Event) {
    let pid = s.inferior.pid
    if e.kind == ev_exited {
        if e.code == 0 {
            emit_line(mut s, "[Inferior 1 (process {pid}) exited normally]")
        } else {
            emit_line(mut s, "[Inferior 1 (process {pid}) exited with code {octal2(e.code)}]")
        }
    } else if e.kind == ev_signaled {
        emit_line(mut s, "")
        emit_line(mut s, "Program terminated with signal {signal_name(e.signal)}, {signal_description(e.signal)}.")
        emit_line(mut s, "The program no longer exists.")
    }
}

/// Report how a resume ended.
fn report_event(mut s: Session, e: Event) {
    if e.kind == ev_watch { report_watch(mut s, e.bp); return }
    if e.kind == ev_scope { return }
    if e.kind == ev_breakpoint {
        report_bp_hit(mut s, e.bp)
        return
    }
    let _ = report_other(mut s, e)
}

fn cmd_run(mut s: Session, rest: str) -> str {
    let trimmed = rest.trim()
    if trimmed.len() > 0 { s.args = trimmed.words() }
    if s.tty {
        var line = "Starting program: {s.prog.path} "
        var i = 0
        while i < s.args.len {
            line = "{line}{if i > 0 { " " } else { "" }}{s.args[i]}"
            i += 1
        }
        emit_line(mut s, line)
    }
    let why = start_process(mut s)
    if why.len() > 0 { return why }
    s.frames = []
    s.frames_ok = false
    let e = cont_user(mut s)
    report_event(mut s, e)
    ""
}

fn cmd_continue(mut s: Session, rest: str) -> str {
    if !s.alive { return "The program is not being run." }
    if s.tty { emit_line(mut s, "Continuing.") }
    s.frames = []
    s.frames_ok = false
    let e = cont_user(mut s)
    report_event(mut s, e)
    ""
}

fn cmd_kill(mut s: Session, rest: str) -> str {
    if !s.alive { return "The program is not being run." }
    let pid = s.inferior.pid
    kill_process(mut s)
    emit_line(mut s, "[Inferior 1 (process {pid}) killed]")
    ""
}

/// The text without its leading spaces and tabs: gdb ignores them in a command's arguments.
fn skip_blanks(text: str) -> str {
    let b = text.bytes()
    var i = 0
    while i < b.len && (b[i] as int == 32 || b[i] as int == 9) { i += 1 }
    str_from(text, i)
}

fn unescape_echo(text: str) -> str {
    var out = ""
    let b = text.bytes()
    var i = 0
    while i < b.len {
        let c = b[i] as int
        if c == 92 && i + 1 < b.len {
            let n = b[i + 1] as int
            if n == 110 { out = "{out}\n" } else if n == 116 { out = "{out}\t" } else if n == 92 { out = "{out}\\" }
            else { out = "{out}{char_text(n)}" }
            i += 2
        } else {
            out = "{out}{char_text(c)}"
            i += 1
        }
    }
    out
}

fn repeat_cmd(mut s: Session, rest: str, kind: int) -> str {
    var n = 1
    let t = rest.trim()
    if t.len() > 0 {
        let v = parse_uint(t)
        if v.ok { n = v.addr as int }
    }
    // stepi N and nexti N show only where the last step stops
    if kind == 4 { return step_insns(mut s, false, n) }
    if kind == 5 { return step_insns(mut s, true, n) }
    var i = 0
    while i < n {
        if !s.alive { return "The program is not being run." }
        var err = ""
        if kind == 1 { err = step_lines(mut s, false, false) }
        else if kind == 2 { err = step_lines(mut s, true, false) }
        else { err = step_lines(mut s, true, true) }
        if err.len() > 0 { return err }
        i += 1
    }
    ""
}

/// sniff's own maintenance commands (not gdb's): `maint frames` names, per frame,
/// whether it was unwound through CFI or through the frame-pointer fallback.
fn cmd_maint(mut s: Session, rest: str) -> str {
    if rest.trim() != "frames" { return "Undefined maintenance command: \"{rest.trim()}\".  Try \"help maintenance\"." }
    if !s.alive { return "No stack." }
    var i = 0
    while i < s.frames.len {
        var how = s.frames[i].basis
        if i + 1 == s.frames.len { how = "outermost" }
        emit_line(mut s, "#{i} {frame_func_name(s, s.frames[i])} unwind={how}")
        i += 1
    }
    ""
}

fn cmd_info(mut s: Session, rest: str) -> str {
    let parts = rest.trim().splitn(" ", 2)
    let what = parts[0]
    var more = ""
    if parts.len > 1 { more = parts[1] }
    if what == "breakpoints" || what == "break" || what == "b" || what == "breakpoint" { return cmd_info_breakpoints(mut s) }
    if what == "watchpoints" || what == "wat" || what == "watch" { return cmd_info_watchpoints(mut s) }
    if what == "display" { return cmd_info_display(mut s) }
    if what == "threads" || what == "thread" { return cmd_info_threads(mut s, more) }
    if what == "signals" || what == "signal" || what == "handle" { return cmd_info_signals(mut s, more) }
    if what == "locals" || what == "lo" { return cmd_info_locals(mut s) }
    if what == "args" || what == "ar" { return cmd_info_args(mut s) }
    if what == "registers" || what == "r" || what == "reg" || what == "all-registers" { return cmd_info_registers(mut s, more) }
    if gdb_only_info_sub(what) { return not_implemented("info {what}") }
    "Undefined info command: \"{rest.trim()}\".  Try \"help info\"."
}

/// Execute one command line. Returns "" or the error message.
fn exec_line(mut s: Session, ln: str) -> str {
    let text = ln.trim()
    if text.len() == 0 || text.starts_with("#") { return "" }
    let parts = text.splitn(" ", 2)
    let word = parts[0]
    var rest = ""
    if parts.len > 1 { rest = parts[1] }
    thr_mark(mut s)
    let err = dispatch(mut s, word, rest, text)
    if s.errmsg.len() > 0 && err.len() == 0 {
        let m = s.errmsg
        s.errmsg = ""
        return m
    }
    err
}

fn dispatch(mut s: Session, word: str, rest: str, text: str) -> str {
    if word == "run" || word == "r" { return cmd_run(mut s, rest) }
    if word == "continue" || word == "c" || word == "cont" || word == "fg" { return cmd_continue(mut s, rest) }
    if word == "kill" || word == "k" { return cmd_kill(mut s, rest) }
    if word == "break" || word == "b" || word == "br" || word == "bre" || word == "brea" { return cmd_break(mut s, rest, false) }
    if word == "tbreak" || word == "tb" { return cmd_break(mut s, rest, true) }
    if word == "delete" || word == "d" || word == "del" { return cmd_delete(mut s, rest) }
    if word == "ignore" { return cmd_ignore(mut s, rest) }
    if word == "watch" || word == "wa" { return cmd_watch(mut s, rest, wk_write) }
    if word == "rwatch" { return cmd_watch(mut s, rest, wk_read) }
    if word == "awatch" { return cmd_watch(mut s, rest, wk_access) }
    if word == "condition" { return cmd_condition(mut s, rest) }
    if word == "display" || word == "disp" { return cmd_display(mut s, rest) }
    if word.starts_with("display/") { return cmd_display(mut s, "/{str_from(word, 8)} {rest}") }
    if word == "undisplay" || word == "undisp" { return cmd_undisplay(mut s, rest) }
    if word == "bt" || word == "backtrace" || word == "where" { return cmd_bt(mut s, rest) }
    if word == "frame" || word == "f" { return cmd_frame(mut s, rest) }
    if word == "thread" || word == "t" { return cmd_thread(mut s, rest) }
    if word == "handle" { return cmd_handle(mut s, rest) }
    if word == "signal" { return cmd_signal(mut s, rest) }
    if word == "up" { return cmd_up(mut s, rest) }
    if word == "down" || word == "dow" || word == "do" { return cmd_down(mut s, rest) }
    if word == "step" || word == "s" { return repeat_cmd(mut s, rest, 1) }
    if word == "next" || word == "n" { return repeat_cmd(mut s, rest, 2) }
    if word == "until" || word == "u" { return repeat_cmd(mut s, rest, 3) }
    if word == "stepi" || word == "si" { return repeat_cmd(mut s, rest, 4) }
    if word == "nexti" || word == "ni" { return repeat_cmd(mut s, rest, 5) }
    if word == "finish" || word == "fin" { return finish_frame(mut s, s.sel, false, s.tty) }
    if word == "print" || word == "p" || word == "inspect" || word == "call" { return cmd_print(mut s, rest) }
    if word.starts_with("print/") || word.starts_with("p/") || word.starts_with("output/") {
        let fmt = word.splitn("/", 2)[1]
        if word.starts_with("output/") { return cmd_output(mut s, "/{fmt} {rest}") }
        return cmd_print(mut s, "/{fmt} {rest}")
    }
    if word == "output" { return cmd_output(mut s, rest) }
    if word == "x" || word.starts_with("x/") { return cmd_x(mut s, if word == "x" { rest } else { "{str_from(word, 1)} {rest}" }) }
    if word == "quit" || word == "q" || word == "exit" { s.quit = true; return "" }
    if word == "echo" { emit(mut s, unescape_echo(skip_blanks(rest))); return "" }
    if word == "info" || word == "i" || word == "inf" { return cmd_info(mut s, rest) }
    if word == "maint" || word == "maintenance" || word == "mt" { return cmd_maint(mut s, rest) }
    if word == "list" || word == "l" { return cmd_list(mut s, rest) }
    if word == "help" || word == "h" { return cmd_help(mut s, rest) }
    if gdb_only(word) { return not_implemented(word) }
    "Undefined command: \"{word}\".  Try \"help\"."
}

/// Run a command script; the first error aborts the rest, as gdb does for -x.
fn run_script(mut s: Session, path: str) -> int {
    let raw = fs_read_bytes(path) else { 
        eprint("{path}: No such file or directory.")
        return 1
    }
    let text = str_from_utf8(raw) else { "" }
    s.script = path
    var n: int = 0
    for ln in text.lines() {
        n += 1
        s.lineno = n
        let err = exec_line(mut s, ln)
        if err.len() > 0 {
            flush_out(mut s)
            eprint("{path}:{n}: Error in sourced command file:")
            eprint(err)
            return 1
        }
    }
    flush_out(mut s)
    0
}

/// What an empty line repeats after `line` ran (err its error, "" for none), as gdb repeats it:
/// run, delete, display, undisplay, condition and quit do not repeat, and a comment repeats as
/// nothing. A `list` that printed repeats as a bare `list` (`list -` as itself), and an `x` as a bare
/// `x`, which goes on from where it stopped; one that failed repeats as typed.
fn repeat_of(line: str, err: str) -> str {
    let text = line.trim()
    if text.starts_with("#") { return "" }
    let word = text.splitn(" ", 2)[0]
    if word == "run" || word == "r" || word == "delete" || word == "d" || word == "del" || word == "display" ||
       word == "disp" || word.starts_with("display/") || word == "undisplay" || word == "undisp" ||
       word == "condition" || word == "quit" || word == "q" || word == "exit" { return "" }
    if err.len() == 0 && (word == "list" || word == "l") {
        if str_from(text, word.len()).trim() == "-" { return "list -" }
        return "list"
    }
    if err.len() == 0 && (word == "x" || word.starts_with("x/")) { return "x" }
    text
}

/// Terminal mode: prompt, read a command, run it. An error is printed and the
/// loop goes on, as in an interactive gdb. An empty line repeats the previous one.
fn run_interactive(mut s: Session) -> int {
    s.tty = true
    emit_line(mut s, "Reading symbols from {s.prog.path}...")
    while !s.quit {
        emit(mut s, "(sniff) ")
        flush_out(mut s)
        let ln = io.input_line() else { break }
        var line = ln
        if ln.trim().len() == 0 { line = s.repeat }
        let err = exec_line(mut s, line)
        if line.trim().len() > 0 { s.repeat = repeat_of(line, err) }
        flush_out(mut s)
        if err.len() > 0 { eprint(err) }
    }
    0
}

/// The debugger entry: sniff -batch -x SCRIPT PROG [--args A...].
pub fn session_main(args: List[str]) -> int {
    var script = ""
    var prog = ""
    var run_args: List[str] = []
    var i: int = 0
    while i < args.len {
        let a = args[i]
        if a == "-batch" || a == "--batch" {
        } else if a == "-x" && i + 1 < args.len {
            i += 1
            script = args[i]
        } else if a == "--args" {
            i += 1
            if i < args.len { prog = args[i] }
            i += 1
            while i < args.len { (mut run_args).push(args[i]); i += 1 }
            break
        } else if prog.len() == 0 {
            prog = a
        }
        i += 1
    }
    if prog.len() == 0 {
        eprint("usage: sniff -batch -x SCRIPT PROG [--args ARGS...]")
        return 2
    }
    let p = prog_load(prog)
    if p.err.len() > 0 && p.data.len == 0 {
        eprint(p.err)
        return 1
    }
    var s = session_new(take p)
    s.args = run_args
    var rc = 0
    if script.len() > 0 { rc = run_script(mut s, script) }
    else { rc = run_interactive(mut s) }
    if s.alive { kill_process(mut s) }
    flush_out(mut s)
    rc
}
