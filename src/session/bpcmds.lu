// break, tbreak, delete and info breakpoints.

fn hex_plain(a: u64) -> str { "0x{a:x}" }

fn break_message(s: Session, kind: str, num: int, addr: u64, abs: bool) -> str {
    let shown = if abs { addr } else { addr + s.base }
    let sal = find_sal(s.prog, if abs && addr >= s.base { addr - s.base } else { addr })
    if sal.ok && func_at(s.prog, if abs && addr >= s.base { addr - s.base } else { addr }) >= 0 {
        return "{kind} {num} at {hex_plain(shown)}: file {s.prog.files[sal.file]}, line {sal.line}."
    }
    "{kind} {num} at {hex_plain(shown)}"
}

/// break LOCATION / tbreak LOCATION
fn cmd_break(mut s: Session, rest: str, temp: bool) -> str {
    let spec = rest.trim()
    if spec.len() == 0 { return "No default breakpoint location." }
    var location = spec
    var cond = ""
    let at = spec.find(" if ") else { 0 - 1 }
    if at >= 0 {
        location = str_upto(spec, at).trim()
        cond = str_from(spec, at + 4).trim()
    }
    let r = resolve_location(s, location)
    if r.err.len() > 0 {
        flush_out(mut s)
        eprint(r.err)
        return ""
    }
    let num = s.bp_next
    s.bp_next += 1
    var i = 0
    while i < r.addrs.len {
        (mut s.bps).push(Bp { num: num, addr: r.addrs[i], hits: 0, temp: temp, enabled: true, internal: false, abs: r.abs, ignore: 0, loc: i + 1, nloc: r.addrs.len, orig: 0, inserted: false, cond: cond, scope: 0 })
        i += 1
    }
    let kind = if temp { "Temporary breakpoint" } else { "Breakpoint" }
    if r.addrs.len == 1 {
        emit_line(mut s, break_message(s, kind, num, r.addrs[0], r.abs))
    } else {
        emit_line(mut s, "{kind} {num} at {hex_plain(r.addrs[0] + s.base)}: {spec}. ({r.addrs.len} locations)")
    }
    ""
}

/// ignore N COUNT: pass the next COUNT crossings of breakpoint N silently.
fn cmd_ignore(mut s: Session, rest: str) -> str {
    let w = rest.words()
    if w.len < 2 { return "Argument required (a breakpoint number)." }
    let n = parse_uint(w[0])
    let c = parse_uint(w[1])
    if !n.ok || !c.ok { return "Bad breakpoint argument: '{rest.trim()}'" }
    var found = false
    var i = 0
    while i < s.bps.len {
        if s.bps[i].num == n.addr as int && !s.bps[i].internal { s.bps[i].ignore = c.addr as int; found = true }
        i += 1
    }
    if !found { return "No breakpoint number {w[0]}." }
    ""
}

/// delete [N...]
fn cmd_delete(mut s: Session, rest: str) -> str {
    let t = rest.trim()
    if t.len() == 0 {
        var keep: List[Bp] = []
        var i = 0
        while i < s.bps.len {
            if s.bps[i].internal && s.bps[i].scope == 0 { (mut keep).push(copy s.bps[i]) }
            i += 1
        }
        s.bps = keep
        s.watches = []
        return ""
    }
    for w in t.words() {
        let n = parse_uint(w)
        if !n.ok { return "Bad breakpoint argument: '{w}'" }
        var found = false
        var keep: List[Bp] = []
        var i = 0
        while i < s.bps.len {
            if s.bps[i].num == n.addr as int && !s.bps[i].internal { found = true } else { (mut keep).push(copy s.bps[i]) }
            i += 1
        }
        s.bps = keep
        if delete_watch(mut s, n.addr as int) { found = true }
        if !found { emit_line(mut s, "No breakpoint number {w}.") }
    }
    ""
}

fn pad_right(t: str, w: int) -> str {
    if t.len() >= w { return t }
    "{t}{" ".repeat(w - t.len())}"
}

fn hex16_plain(a: u64) -> str { addr16(a) }

fn bp_what(s: Session, addr: u64) -> str {
    let sal = find_sal(s.prog, addr)
    let f = func_at(s.prog, addr)
    if sal.ok && f >= 0 {
        return "in {s.prog.funcs[f].name} at {s.prog.files[sal.file]}:{sal.line}"
    }
    let sym = symbolize(s, addr + s.base)
    sym
}

/// info breakpoints: breakpoints and watchpoints in number order.
fn cmd_info_breakpoints(mut s: Session) -> str {
    var any = s.watches.len > 0
    var i = 0
    while i < s.bps.len {
        if !s.bps[i].internal { any = true }
        i += 1
    }
    if !any {
        emit_line(mut s, "No breakpoints, watchpoints, tracepoints, or catchpoints.")
        return ""
    }
    emit_line(mut s, "Num     Type           Disp Enb Address            What")
    var num = 1
    while num < s.bp_next {
        i = 0
        while i < s.bps.len {
            if s.bps[i].num == num && !s.bps[i].internal { bp_row(mut s, i) }
            i += 1
        }
        i = 0
        while i < s.watches.len {
            if s.watches[i].num == num { watch_row(mut s, copy s.watches[i]) }
            i += 1
        }
        num += 1
    }
    ""
}

/// The condition line and the hit count of breakpoint i, as gdb prints them under its row.
fn bp_tail(mut s: Session, cond: str, hits: int) {
    if cond.len() > 0 { emit_line(mut s, "\tstop only if {cond}") }
    if hits > 0 {
        let times = if hits == 1 { "time" } else { "times" }
        emit_line(mut s, "\tbreakpoint already hit {hits} {times}")
    }
}

fn bp_row(mut s: Session, i: int) {
    let b = copy s.bps[i]
    if b.nloc > 1 {
        if b.loc == 1 {
            let disp = if b.temp { "del" } else { "keep" }
            emit_line(mut s, "{pad_right("{b.num}", 8)}{pad_right("breakpoint", 15)}{pad_right(disp, 5)}{pad_right("y", 4)}{pad_right("<MULTIPLE>", 19)}")
            var total = 0
            var k = 0
            while k < s.bps.len { if s.bps[k].num == b.num { total += s.bps[k].hits }; k += 1 }
            bp_tail(mut s, b.cond, total)
        }
        emit_line(mut s, "{pad_right("{b.num}.{b.loc}", 28)}{pad_right("y", 4)}{pad_right(addr16(bp_rt(s, i)), 19)}{bp_what(s, b.addr)}")
        return
    }
    let disp = if b.temp { "del" } else { "keep" }
    let enb = if b.enabled { "y" } else { "n" }
    emit_line(mut s, "{pad_right("{b.num}", 8)}{pad_right("breakpoint", 15)}{pad_right(disp, 5)}{pad_right(enb, 4)}{pad_right(addr16(bp_rt(s, i)), 19)}{bp_what(s, if b.abs && b.addr >= s.base { b.addr - s.base } else { b.addr })}")
    bp_tail(mut s, b.cond, b.hits)
}
