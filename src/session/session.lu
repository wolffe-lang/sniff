// The debugging session: one program, at most one traced child, the
// breakpoint table and the command interpreter's state. Platform calls go
// through the platform module only.

use platform

const st_none: int = 0
const st_stopped: int = 1

/// One breakpoint (a single location; gdb's multi-location case is a list of these).
struct Bp {
    pub num: int,
    pub addr: u64,
    pub hits: int,
    pub temp: bool,
    pub enabled: bool,
    pub internal: bool,
    pub abs: bool,
    pub ignore: int,
    pub loc: int,
    pub nloc: int,
    pub orig: int,
    pub inserted: bool,
    /// The condition (`break X if E`, `condition N E`), "" for none.
    pub cond: str,
    /// For an internal breakpoint at a watch's scope end, that watch's number; else 0.
    pub watch_end: int,
}

/// How a resume ended.
struct Event {
    pub kind: int,
    pub signal: int,
    pub code: int,
    pub bp: int,
}

const ev_exited: int = 1
const ev_signaled: int = 2
const ev_breakpoint: int = 3
const ev_signal: int = 4
const ev_stepped: int = 5
const ev_lost: int = 6
const ev_error: int = 7
/// A watch's slot fired and it has something to report (bp is the watch's index).
const ev_watch: int = 8
/// A watch's frame returned; the deletion and the stop are already reported.
const ev_scope: int = 9

/// One thread of the program, numbered as gdb numbers threads: 1 for the first, then in the order they start.
struct Thr {
    pub num: int,
    pub tid: int,
    /// Its thread pointer (gdb's `Thread 0x...`), read at its first stop; 0 until read.
    pub tls: u64,
    pub running: bool,
    /// A stop it reported while the others were being stopped, kept to be reported first; -1 for none.
    pub pending: int,
    /// A SIGSTOP the session sent it that is still to arrive.
    pub expect_stop: bool,
}

/// All of the debugger's state.
struct Session {
    pub prog: Prog,
    /// The selected thread: registers, stepping and resuming go to it.
    pub target: platform.Target,
    /// The process (its leader thread): memory, the program's end, kill.
    pub inferior: platform.Target,
    pub thr: List[Thr],
    /// Index in thr of the selected thread.
    pub thr_cur: int,
    pub thr_next: int,
    /// Whether the program has had more than one thread: gdb then names the thread at each stop.
    pub thr_multi: bool,
    /// The thread selected when the program was last resumed; a stop in another prints `[Switching to ...]`.
    pub thr_prev: int,
    /// Stops of threads or children seen before the event that names them.
    pub early: List[platform.Waited],
    /// `handle`'s settings for each of gdb's signals, in sig_names()'s order.
    pub sig_stop: List[bool],
    pub sig_print: List[bool],
    pub sig_pass: List[bool],
    /// The pending signal was given by `signal`: it is delivered whatever `handle` says of passing it.
    pub signal_given: bool,
    pub alive: bool,
    pub base: u64,
    pub args: List[str],
    pub out: List[byte],
    pub script: str,
    pub lineno: int,
    pub bps: List[Bp],
    pub bp_next: int,
    pub pending_signal: int,
    pub cfi: List[CfiFde],
    /// The shared libraries read for frames in them (libs.lu); cleared when a program starts.
    pub libs: List[Lib],
    pub frames: List[Frame],
    pub frames_ok: bool,
    pub sel: int,
    pub src_file: List[int],
    pub src_lines: List[List[str]],
    pub src_ok: List[bool],
    pub hist: List[Val],
    pub errmsg: str,
    pub tty: bool,
    pub quit: bool,
    pub watches: List[Watch],
    /// Whether the slots hold anything (they are cleared once when the last watch goes).
    pub watch_armed: bool,
    pub disps: List[Display],
    pub disp_next: int,
    /// The last listing (`list`): its file (-1 for none), first and last lines; past the end when its
    /// file could not be read.
    pub lst_file: int,
    pub lst_first: int,
    pub lst_last: int,
    pub lst_at_end: bool,
    /// A frame's source line printed since the last listing (0 for none): a bare `list` centres on it.
    pub lst_solitary: int,
    /// Files whose missing source was warned about once.
    pub src_warned: List[int],
    /// What an empty line at the terminal runs: the previous line, as gdb repeats it ("" for nothing).
    pub repeat: str,
    /// The last `x`: where it stopped, its count, format and size (a bare `x` goes on from there).
    pub x_ok: bool,
    pub x_next: u64,
    pub x_count: int,
    pub x_fmt: str,
    pub x_size: int,
}

/// Printed text goes to standard output through one buffer, flushed before
/// the child runs and at exit so output and the child's own interleave.
fn emit(mut s: Session, text: str) {
    for b in text.bytes() { (mut s.out).push(b) }
    if s.out.len >= 65536 { flush_out(mut s) }
}

/// Emit text and a newline.
fn emit_line(mut s: Session, text: str) {
    emit(mut s, text)
    (mut s.out).push(10 as byte)
}

/// Write the buffered output.
fn flush_out(mut s: Session) {
    if s.out.len == 0 { return }
    fs_write_chunk(1, s.out) else |_| { }
    s.out = []
}

/// A session over a loaded program.
fn session_new(take p: Prog) -> Session {
    Session {
        prog: p, target: platform.target_none(), inferior: platform.target_none(), thr: [], thr_cur: 0, thr_next: 1,
        thr_multi: false, thr_prev: 0, early: [], sig_stop: sig_default_stop(), sig_print: sig_default_print(),
        sig_pass: sig_default_pass(), signal_given: false, alive: false, base: 0, args: [], out: [],
        script: "", lineno: 0, bps: [], bp_next: 1, pending_signal: 0, cfi: [], libs: [], frames: [], frames_ok: false, sel: 0, src_file: [], src_lines: [], src_ok: [], hist: [], errmsg: "", tty: false, quit: false,
        watches: [], watch_armed: false, disps: [], disp_next: 1,
        lst_file: -1, lst_first: 0, lst_last: 0, lst_at_end: false, lst_solitary: 0, src_warned: [],
        repeat: "", x_ok: false, x_next: 0, x_count: 1, x_fmt: "x", x_size: 4,
    }
}
