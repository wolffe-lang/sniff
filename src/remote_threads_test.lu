//! member: false
// Plain remote thread IDs and selection, from the GDB manual's thread-list and qC packets.
use remote

fn main() {
    let (ids, selected) = remote.thread_ids(["1", "02", "a", "f"], "0a") else { return }
    assert(ids.len == 4 && ids[0] == 1 && ids[1] == 2 && ids[2] == 10 && ids[3] == 15)
    assert(selected == 2)
    print("PASS remote-thread-identities")

    let (fallback, first) = remote.thread_ids([], "0f") else { return }
    assert(fallback.len == 1 && fallback[0] == 15 && first == 0)
    let (unknown, initial) = remote.thread_ids([], "") else { return }
    assert(unknown.len == 1 && unknown[0] == 1 && initial == 0)
    let (listed, current) = remote.thread_ids(["a", "b"], "") else { return }
    assert(listed.len == 2 && current == 0)
    print("PASS remote-thread-fallback")

    let cases: List[List[str]] = [["0"], ["no"], ["40000000"], ["01", "1"]]
    for values in cases {
        let r = remote.thread_ids(values, "1")
        assert("{r}" == "bad_reply")
    }
    let absent = remote.thread_ids(["1", "2"], "3")
    assert("{absent}" == "bad_reply")
    print("PASS remote-thread-invalid")

    var many: List[str] = []
    var i = 0
    while i < remote.thread_cap {
        (mut many).push(remote.hex_u64((i + 1) as u64))
        i += 1
    }
    let (at_cap, last) = remote.thread_ids(many, remote.hex_u64(remote.thread_cap as u64)) else { return }
    assert(at_cap.len == remote.thread_cap && last == remote.thread_cap - 1)
    (mut many).push(remote.hex_u64((remote.thread_cap + 1) as u64))
    let over = remote.thread_ids(many, "1")
    assert("{over}" == "bad_reply")
    print("PASS remote-thread-cap")
}
