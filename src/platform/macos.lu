/// Slots of the state block every Target shares (u64 each).
#[cfg(target = "aarch64-apple-darwin")]
const st_exc_port: int = 0
#[cfg(target = "aarch64-apple-darwin")]
const st_thread: int = 1
#[cfg(target = "aarch64-apple-darwin")]
const st_pending: int = 2
#[cfg(target = "aarch64-apple-darwin")]
const st_kind: int = 3
#[cfg(target = "aarch64-apple-darwin")]
const st_code0: int = 4
#[cfg(target = "aarch64-apple-darwin")]
const st_code1: int = 5
#[cfg(target = "aarch64-apple-darwin")]
const st_msg: int = 6
#[cfg(target = "aarch64-apple-darwin")]
const st_stepping: int = 7
#[cfg(target = "aarch64-apple-darwin")]
const st_exit: int = 8
#[cfg(target = "aarch64-apple-darwin")]
const st_signal: int = 9
#[cfg(target = "aarch64-apple-darwin")]
const st_msg2: int = 10
/// The session signal a faulting thread was just resumed with: its Unix signal comes back as one more exception, passed on silently.
#[cfg(target = "aarch64-apple-darwin")]
const st_autopass: int = 11

/// A forked child's first breakpoint trap, pending the session's detach: the child's task port, its pid, and
/// whether the next resume of the parent is to be skipped (the parent never stopped).
#[cfg(target = "aarch64-apple-darwin")]
const st_fork_task: int = 12
#[cfg(target = "aarch64-apple-darwin")]
const st_fork_pid: int = 13
#[cfg(target = "aarch64-apple-darwin")]
const st_fork_skip: int = 14
/// The number of watch registers (hw.optional.watchpoint), read once; 0 until then.
#[cfg(target = "aarch64-apple-darwin")]
const st_watch_slots: int = 15
/// The thread that took the pending exception (its port): the reply and a signal's delivery are its. st_thread
/// is the selected thread, whose registers the session reads.
#[cfg(target = "aarch64-apple-darwin")]
const st_event_thread: int = 16
/// 1 while the layer holds the task suspended (task_suspend at each reported stop): all-stop.
#[cfg(target = "aarch64-apple-darwin")]
const st_suspended: int = 17
/// The thread whose step bit is set, while one is.
#[cfg(target = "aarch64-apple-darwin")]
const st_step_thread: int = 18

/// Bytes of the message buffers (an exception request is 88 bytes plus a trailer).
#[cfg(target = "aarch64-apple-darwin")]
const msg_bytes: int = 1024
/// The exception kinds the layer reports.
#[cfg(target = "aarch64-apple-darwin")]
const kind_brk: int = 257
#[cfg(target = "aarch64-apple-darwin")]
const kind_step: int = 258
#[cfg(target = "aarch64-apple-darwin")]
const kind_signal: int = 259
/// A hardware fault or other exception that the kernel turns into a Unix signal if replied to with failure.
#[cfg(target = "aarch64-apple-darwin")]
const kind_fault: int = 260
/// A watch register's trap (EXC_BREAKPOINT with EXC_ARM_DA_DEBUG, the data address in the subcode).
#[cfg(target = "aarch64-apple-darwin")]
const kind_watch: int = 261

/// Heap bytes holding text and a terminating zero, for the C calls.
#[cfg(target = "aarch64-apple-darwin")]
fn cstr(s: str) -> u64 {
    let b = s.bytes()
    let n = b.len
    unsafe {
        // # Safety: the buffer is calloc'd one byte longer than the text.
        let p = c.calloc(1, (n + 1) as uint) as *u8
        var i = 0
        while i < n {
            p[i] = b[i] as int as u8
            i += 1
        }
        p as u64
    }
}

/// darwin signal number (sys/signal.h) to the session's (gdb's) numbering.
#[cfg(target = "aarch64-apple-darwin")]
fn darwin_to_session(n: int) -> int {
    if n == 10 { return 7 }
    if n == 12 { return 31 }
    if n == 16 { return 23 }
    if n == 17 { return 19 }
    if n == 18 { return 20 }
    if n == 19 { return 18 }
    if n == 20 { return 17 }
    if n == 23 { return 29 }
    if n == 30 { return 10 }
    if n == 31 { return 12 }
    if n == 7 || n == 29 { return 100 + n }
    n
}

/// The session's signal number as darwin's.
#[cfg(target = "aarch64-apple-darwin")]
fn session_to_darwin(n: int) -> int {
    if n == 7 { return 10 }
    if n == 31 { return 12 }
    if n == 23 { return 16 }
    if n == 19 { return 17 }
    if n == 20 { return 18 }
    if n == 18 { return 19 }
    if n == 17 { return 20 }
    if n == 29 { return 23 }
    if n == 10 { return 30 }
    if n == 12 { return 31 }
    if n >= 100 { return n - 100 }
    n
}

/// A stop status for the session.
#[cfg(target = "aarch64-apple-darwin")]
fn stop_status(kind: int, sig: int) -> int {
    (kind << 16) + (sig << 8) + 127
}

/// A raw darwin wait status in the session's signal numbering.
#[cfg(target = "aarch64-apple-darwin")]
fn translate_status(st: int) -> int {
    if (st & 127) == 0 { return st }
    if (st & 255) == 127 { return st }
    let sig = darwin_to_session(st & 127)
    (st & 128) + sig
}

/// No child.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_none() -> Target {
    unsafe {
        // # Safety: calloc'd blocks sized for the slots below.
        let blk = c.calloc(20, 8) as *u64
        blk[st_msg] = c.calloc(1, msg_bytes as uint) as u64
        blk[st_msg2] = c.calloc(1, msg_bytes as uint) as u64
        Target {
            pid: 0,
            memfd: -1,
            status: c.calloc(1, 8) as u64,
            regs: c.calloc(40, 8) as u64,
            word: blk as u64,
        }
    }
}

/// The reason a spawn was refused (task_for_pid, usually), or "".
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_refusal(t: Target) -> str {
    if t.memfd == -2 { return "task_for_pid refused: the target lacks the get-task-allow entitlement (sign it ad hoc with it)" }
    if t.memfd == -3 { return "posix_spawn failed" }
    if t.memfd == -4 { return "could not take the child's exceptions" }
    ""
}

/// Kill and reap a child that never became a Target.
#[cfg(target = "aarch64-apple-darwin")]
fn reap(pid: int) {
    unsafe {
        // # Safety: pid is the lane's own spawned child.
        let _ = kill(pid as i32, 9)
        let st = c.calloc(1, 8) as u64
        let _ = waitpid(pid as i32, st, 0)
    }
}

/// Send the reply for the request in buffer `msg`: ret 0 lets the thread go on,
/// 5 refuses the exception (the kernel then makes it a Unix signal).
#[cfg(target = "aarch64-apple-darwin")]
fn reply_to(msg: u64, ret: int) -> int {
    unsafe {
        // # Safety: msg is a message buffer of msg_bytes the layer owns; rp is calloc'd 40 bytes.
        let m = msg as *u32
        let rp = c.calloc(1, 40) as *u32
        rp[0] = m[0] & 31
        rp[1] = 36
        rp[2] = m[2]
        rp[3] = 0
        rp[4] = 0
        rp[5] = m[5] + 100
        rp[6] = m[13]
        rp[7] = m[14]
        rp[8] = ret as u32
        mach_msg(rp as u64, 1, 36, 0, 0, 0, 0) as int
    }
}

/// Read the exception request in msg and record it in the state block. Returns the exception kind.
#[cfg(target = "aarch64-apple-darwin")]
fn decode_exception(t: Target, msg: u64) -> int {
    unsafe {
        // # Safety: msg is a message buffer of msg_bytes the layer owns; the state block is calloc'd.
        let m = msg as *u32
        let st = t.word as *u64
        let exc = m[15] as int
        let c0 = (m[17] as u64) | ((m[18] as u64) << 32)
        let c1 = (m[19] as u64) | ((m[20] as u64) << 32)
        st[st_thread] = m[7] as u64
        st[st_event_thread] = m[7] as u64
        st[st_code0] = c0
        st[st_code1] = c1
        st[st_pending] = 1
        var kind = kind_fault
        var sig = 11
        if exc == 6 && c0 == 258 {
            // EXC_ARM_DA_DEBUG (mach/arm/exception.h): a watch register fired, before the access
            kind = kind_watch
            sig = 5
        } else if exc == 6 {
            // EXC_BREAKPOINT: the step trap has no address; a BRK carries its own
            if c1 == 0 && st[st_stepping] == 1 { kind = kind_step } else { kind = kind_brk }
            sig = 5
        } else if exc == 5 && c0 == 65539 {
            kind = kind_signal
            sig = darwin_to_session(c1 as int)
        } else if exc == 1 {
            // EXC_BAD_ACCESS: KERN_INVALID_ADDRESS is a segmentation fault; protection and alignment faults are bus errors
            sig = 11
        } else if exc == 2 { sig = 4 }
        else if exc == 3 { sig = 8 }
        else if exc == 5 { sig = 31 }
        else { sig = 5 }
        st[st_kind] = kind as u64
        st[st_signal] = sig as u64
        stop_status(kind, sig) as int
    }
}

/// The flags of ARM_DEBUG_STATE64: MDSCR_EL1 is at byte 512 (slot 64). Set or clear the step bit.
#[cfg(target = "aarch64-apple-darwin")]
fn set_single_step(t: Target, on: bool) -> int {
    unsafe {
        // # Safety: the state buffer is calloc'd 130 words; the thread port is the stopped thread's.
        let st = t.word as *u64
        var th = st[st_thread]
        if !on && st[st_step_thread] != 0 { th = st[st_step_thread] }
        let ds = c.calloc(1, 520) as *u64
        let cnt = c.calloc(1, 8) as *u32
        cnt[0] = 130
        let kr = thread_get_state(th as u32, 15, ds as u64, cnt as u64)
        if kr != 0 { return -1 }
        var v: u64 = ds[64]
        if on { v = v | 1 } else { v = v & !(1 as u64) }
        ds[64] = v
        if !on && st[st_stepping] == 1 {
            // After a step, an empty debug state goes first. While the thread's state still held a watch,
            // macOS 15 could leave the step armed after the bit was cleared: the next resume trapped at once
            // (ESR class 0x32 with ISV 0, a step with no instruction run). The empty state lets the kernel
            // drop the thread's state and load the next one afresh (notes/sn05-the-repin-and-s5.md).
            let z = c.calloc(1, 520) as *u64
            if thread_set_state(th as u32, 15, z as u64, 130) != 0 { return -1 }
        }
        let kr2 = thread_set_state(th as u32, 15, ds as u64, 130)
        if kr2 != 0 { return -1 }
        st[st_stepping] = if on { 1 } else { 0 }
        st[st_step_thread] = if on { th } else { 0 }
        0
    }
}

/// Wait for the next event of the child: an exception on the port or the end of
/// the process. Returns the synthesised status, or -1.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_wait(t: Target) -> int {
    unsafe {
        // # Safety: buffers are calloc'd and owned by the layer; the pid is the traced child.
        let st = t.word as *u64
        if st[st_exit] != 0 { return (st[st_exit] - 1) as int }
        let wst = t.status as *i32
        var odd = 0
        while true {
            let msg = st[st_msg]
            let kr = mach_msg(msg, 258, 0, msg_bytes as u32, st[st_exc_port] as u32, 5, 0)
            if kr == 0 {
                let m = msg as *u32
                if m[10] as u64 != t.memfd as u64 {
                    // another task's exception (a forked child inherited the port)
                    if fork_event(t) { return stop_status(1, 5) }
                    handle_foreign(t)
                    continue
                }
                let r = decode_exception(t, msg)
                let sg = (r >> 8) & 255
                if (r >> 16) == kind_signal && (st[st_autopass] == sg as u64 || sg == 9) {
                    // the signal a fault turned into, or one nobody can intercept: let it through
                    st[st_autopass] = 0
                    let _ = ptrace(13, t.pid as i32, st[st_event_thread], session_to_darwin(sg) as i32)
                    st[st_pending] = 0
                    let _ = reply_to(msg, 0)
                    continue
                }
                // all-stop: the other threads stop too while the session has control
                if st[st_suspended] == 0 && task_suspend(t.memfd as u32) == 0 { st[st_suspended] = 1 }
                return r
            }
            let w = waitpid(t.pid as i32, t.status, 1)
            if w == t.pid as i32 {
                let raw = wst[0] as int
                if (raw & 255) != 127 {
                    st[st_exit] = (translate_status(raw) + 1) as u64
                    return translate_status(raw)
                }
            }
            if kr != 268451843 {
                odd += 1
                if odd > 50 { return -1 }
            }
        }
        -1
    }
}

/// A forked child's breakpoint trap (the child inherited the exception port and the parent's inserted traps).
/// The request is kept, unanswered, in the second buffer; the session reports a fork event, writes the original
/// instructions into the child through target_with_pid, and target_detach then lets the child retry them.
#[cfg(target = "aarch64-apple-darwin")]
fn fork_event(t: Target) -> bool {
    unsafe {
        // # Safety: both buffers are layer-owned and msg_bytes long; pidbuf is calloc'd.
        let st = t.word as *u64
        let m = st[st_msg] as *u32
        let c0 = (m[17] as u64) | ((m[18] as u64) << 32)
        if (m[15] as int) != 6 || c0 != 1 { return false }
        let keep = st[st_msg2] as *u32
        var i = 0
        while i < 32 {
            keep[i] = m[i]
            i += 1
        }
        let pidbuf = c.calloc(1, 8) as *i32
        if pid_for_task(m[10], pidbuf as u64) != 0 { return false }
        st[st_fork_task] = m[10] as u64
        st[st_fork_pid] = pidbuf[0] as u64
        st[st_fork_skip] = 1
        true
    }
}

/// An exception from a task that is not the traced one: restore nothing here
/// (the session cannot know), refuse nothing; let the thread go on.
#[cfg(target = "aarch64-apple-darwin")]
fn handle_foreign(t: Target) {
    unsafe {
        // # Safety: the message buffer belongs to the layer.
        let st = t.word as *u64
        let m = st[st_msg] as *u32
        let c0 = (m[17] as u64) | ((m[18] as u64) << 32)
        let exc = m[15] as int
        if exc == 6 && c0 == 1 {
            // a BRK of ours in the child's copy: step the child past it is not possible without its
            // original bytes; the session's detach path handles breakpoints, so just let it fail
            let _ = reply_to(st[st_msg], 5)
        } else {
            let _ = reply_to(st[st_msg], 0)
        }
    }
}

/// Resume after the pending exception, delivering sig (the session's number; 0 for none).
#[cfg(target = "aarch64-apple-darwin")]
fn resume(t: Target, sig: int, step: bool) -> int {
    unsafe {
        // # Safety: buffers are layer-owned; the pid is the traced child.
        let st = t.word as *u64
        if st[st_fork_skip] != 0 {
            // the stop was a forked child's: the parent never stopped
            st[st_fork_skip] = 0
            return 0
        }
        if st[st_pending] == 0 { return -1 }
        let kind = st[st_kind] as int
        var ret = 0
        if kind == kind_brk {
            // a BRK that is not ours is still in memory after the session restored its own: step past it
            // (the thread that took the exception's pc, whichever thread is selected)
            let sel = st[st_thread]
            st[st_thread] = st[st_event_thread]
            let regs = target_regs(t)
            if regs.len == 34 {
                let w = target_read(t, regs[32], 4)
                if w.ok {
                    let word = (w.data[0] as int) + ((w.data[1] as int) << 8) + ((w.data[2] as int) << 16) + ((w.data[3] as int) << 24)
                    if (word & 4292870175) == 3558866944 {
                        var r2 = copy regs
                        r2[32] = regs[32] + 4
                        let _ = target_set_regs(t, r2)
                    }
                }
            }
            st[st_thread] = sel
        }
        if set_single_step(t, step) < 0 { return -1 }
        if kind == kind_signal {
            // the signal the program was about to receive: pass it (darwin's number) or drop it
            let _ = ptrace(13, t.pid as i32, st[st_event_thread], session_to_darwin(sig) as i32)
        } else if kind == kind_fault {
            if sig != 0 {
                ret = 5
                st[st_autopass] = sig as u64
            }
        }
        st[st_pending] = 0
        if st[st_suspended] == 1 {
            let _ = task_resume(t.memfd as u32)
            st[st_suspended] = 0
        }
        reply_to(st[st_msg], ret)
    }
}

/// Start path as a traced child, stopped before dyld has run. The returned
/// Target has pid 0 (and memfd naming the refusal) when anything fails.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_spawn(path: str, args: List[str], env_lines: str, env_columns: str) -> Target {
    let tgt = target_none()
    unsafe {
        // # Safety: buffers are calloc'd and sized for each call; the pid is the lane's own spawned child.
        let st = tgt.word as *u64
        let argv = c.calloc((args.len + 2) as uint, 8) as *u64
        let cpath = cstr(path)
        argv[0] = cpath
        var i = 0
        while i < args.len {
            argv[i + 1] = cstr(args[i])
            i += 1
        }
        argv[args.len + 1] = 0
        let attr = c.calloc(1, 64) as u64
        let _ = posix_spawnattr_init(attr)
        let _ = posix_spawnattr_setflags(attr, 384)
        let pidbuf = c.calloc(1, 8) as *i32
        let envp = (_NSGetEnviron() as *u64)[0]
        let rc = posix_spawn(pidbuf as u64, cpath, 0, attr, argv as u64, envp)
        if rc != 0 { return Target { pid: 0, memfd: -3, status: tgt.status, regs: tgt.regs, word: tgt.word } }
        let pid = pidbuf[0] as int
        let tbuf = c.calloc(1, 8) as *u32
        let kr = task_for_pid(mach_task_self(), pid as i32, tbuf as u64)
        if kr != 0 {
            reap(pid)
            return Target { pid: 0, memfd: -2, status: tgt.status, regs: tgt.regs, word: tgt.word }
        }
        let task = tbuf[0] as int
        let pbuf = c.calloc(1, 8) as *u32
        let _ = mach_port_allocate(mach_task_self(), 1, pbuf as u64)
        let port = pbuf[0]
        let _ = mach_port_insert_right(mach_task_self(), port, port, 20)
        st[st_exc_port] = port as u64
        // EXC_MASK_BAD_ACCESS|BAD_INSTRUCTION|ARITHMETIC|SOFTWARE|BREAKPOINT = 2+4+8+32+64
        // behaviour EXCEPTION_DEFAULT | MACH_EXCEPTION_CODES, flavor ARM_THREAD_STATE64
        let kr2 = task_set_exception_ports(task as u32, 110, port, 2147483649, 6)
        if kr2 != 0 {
            reap(pid)
            return Target { pid: 0, memfd: -4, status: tgt.status, regs: tgt.regs, word: tgt.word }
        }
        let a = ptrace(14, pid as i32, 0, 0)
        if a != 0 {
            reap(pid)
            return Target { pid: 0, memfd: -4, status: tgt.status, regs: tgt.regs, word: tgt.word }
        }
        let t = Target { pid: pid, memfd: task, status: tgt.status, regs: tgt.regs, word: tgt.word }
        let _ = kill(pid as i32, 19)
        // the attach may report its own SIGSTOP as an exception first; the stop that
        // stays pending is the SIGCONT's, at dyld's first instruction, before main's image runs
        var rounds = 0
        while rounds < 4 {
            let w = target_wait(t)
            if w < 0 || (w & 255) != 127 { reap(pid); return Target { pid: 0, memfd: -4, status: tgt.status, regs: tgt.regs, word: tgt.word } }
            if ((w >> 8) & 255) != 19 { break }
            let _ = resume(t, 0, false)
            rounds += 1
        }
        t
    }
}

/// Resume, delivering sig (0 for none).
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_cont(t: Target, sig: int) -> int {
    resume(t, sig, false)
}

/// Execute one instruction, delivering sig (0 for none).
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_step(t: Target, sig: int) -> int {
    resume(t, sig, true)
}

/// Kill the child with SIGKILL and reap it. Returns the final raw status.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_kill(t: Target) -> int {
    unsafe {
        // # Safety: the pid is the traced child; the status buffer is calloc'd.
        let wst = t.status as *i32
        let _ = kill(t.pid as i32, 9)
        var last: int = -1
        var n = 0
        while n < 200 {
            let w = waitpid(t.pid as i32, t.status, 1)
            if w == t.pid as i32 {
                last = wst[0] as int
                if (last & 255) != 127 { break }
            }
            n += 1
            if n > 20 {
                let st = t.word as *u64
                let mm = st[st_msg] as u64
                let _ = mach_msg(mm, 258, 0, msg_bytes as u32, st[st_exc_port] as u32, 10, 0)
            }
        }
        let _ = mach_port_deallocate(mach_task_self(), t.memfd as u32)
        translate_status(last)
    }
}

/// The 34 ARM_THREAD_STATE64 slots (x0-x28, fp, lr, sp, pc, cpsr), or an empty list.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_regs(t: Target) -> List[u64] {
    unsafe {
        // # Safety: the register buffer is calloc'd 40 words; the thread port is the stopped thread's.
        var out: List[u64] = []
        let st = t.word as *u64
        if st[st_thread] == 0 { return out }
        let regs = t.regs as *u64
        let cnt = c.calloc(1, 8) as *u32
        cnt[0] = 68
        let kr = thread_get_state(st[st_thread] as u32, 6, t.regs, cnt as u64)
        if kr != 0 { return out }
        var i = 0
        while i < 33 {
            (mut out).push(regs[i])
            i += 1
        }
        (mut out).push(regs[33] & 4294967295)
        out
    }
}

/// Write the 34 slots back. Returns 0 or -1.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_set_regs(t: Target, regs: List[u64]) -> int {
    unsafe {
        // # Safety: the register buffer is calloc'd 40 words; the thread port is the stopped thread's.
        if regs.len != 34 { return -1 }
        let st = t.word as *u64
        let slots = t.regs as *u64
        var i = 0
        while i < 34 {
            slots[i] = regs[i]
            i += 1
        }
        let kr = thread_set_state(st[st_thread] as u32, 6, t.regs, 68)
        if kr != 0 { return -1 }
        0
    }
}

/// Read n bytes at addr. ok is false when any of them is unreadable.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_read(t: Target, addr: u64, n: int) -> Bytes {
    unsafe {
        // # Safety: buf is calloc'd n bytes; the task port is the traced child's.
        var out: List[byte] = []
        if n <= 0 { return Bytes { ok: true, data: out } }
        let buf = c.calloc(1, n as uint) as *u8
        let got = c.calloc(1, 8) as *u64
        let kr = mach_vm_read_overwrite(t.memfd as u32, addr, n as u64, buf as u64, got as u64)
        if kr != 0 || got[0] != n as u64 { return Bytes { ok: false, data: out } }
        var i = 0
        while i < n {
            (mut out).push(buf[i] as int as byte)
            i += 1
        }
        Bytes { ok: true, data: out }
    }
}

/// The protection of the region holding addr, or -1.
#[cfg(target = "aarch64-apple-darwin")]
fn region_prot(t: Target, addr: u64) -> int {
    unsafe {
        // # Safety: buffers are calloc'd and sized for mach_vm_region's basic info (36 bytes).
        let a = c.calloc(1, 8) as *u64
        a[0] = addr
        let sz = c.calloc(1, 8) as *u64
        let info = c.calloc(1, 64) as *u32
        let cnt = c.calloc(1, 8) as *u32
        cnt[0] = 9
        let obj = c.calloc(1, 8) as *u32
        let kr = mach_vm_region(t.memfd as u32, a as u64, sz as u64, 9, info as u64, cnt as u64, obj as u64)
        if kr != 0 { return -1 }
        if a[0] > addr { return -1 }
        info[0] as int
    }
}

/// Make the instruction caches of the target's cores see freshly written code: Arm
/// requires data-cache clean and instruction-cache invalidate (Arm ARM, "Concurrent
/// modification and execution of instructions") before a modified instruction is fetched.
/// A debugger cannot run those instructions on the child's cores, so it asks the kernel:
/// mach_vm_machine_attribute(MATTR_CACHE, MATTR_VAL_ICACHE_FLUSH), both from
/// <mach/vm_attributes.h>. Without it a running child keeps executing the old bytes and
/// walks past an inserted BRK (measured: 122 of 200 runs lost the rest of the hits).
#[cfg(target = "aarch64-apple-darwin")]
fn flush_icache(t: Target, addr: u64, n: int) -> bool {
    unsafe {
        // # Safety: val is a calloc'd int the kernel reads and writes; the task port is the child's.
        let val = c.calloc(1, 8) as *i32
        val[0] = 8
        let first = addr & !(16383 as u64)
        let last = (addr + n as u64 - 1) & !(16383 as u64)
        let rc = mach_vm_machine_attribute(t.memfd as u32, first, last + 16384 - first, 1, val as u64)
        rc == 0
    }
}

/// Write bytes at addr. Text is read-only and shared: the page is made copy-on-write
/// writable (never writable and executable together), written, and restored.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_write(t: Target, addr: u64, data: List[byte]) -> bool {
    unsafe {
        // # Safety: buf is calloc'd with the data's length; the task port is the traced child's.
        let n = data.len
        if n == 0 { return true }
        let buf = c.calloc(1, n as uint) as *u8
        var i = 0
        while i < n {
            buf[i] = data[i] as int as u8
            i += 1
        }
        let prot = region_prot(t, addr)
        if prot < 0 { return false }
        if (prot & 2) != 0 {
            let wrote = mach_vm_write(t.memfd as u32, addr, buf as u64, n as u32) == 0
            if wrote && (prot & 4) != 0 { let _ = flush_icache(t, addr, n) }
            return wrote
        }
        let first = addr & !(16383 as u64)
        let last = (addr + n as u64 - 1) & !(16383 as u64)
        let len = last + 16384 - first
        if mach_vm_protect(t.memfd as u32, first, len, 0, 3 + 16) != 0 { return false }
        let ok = mach_vm_write(t.memfd as u32, addr, buf as u64, n as u32) == 0
        let _ = mach_vm_protect(t.memfd as u32, first, len, 0, prot as i32)
        if ok && (prot & 4) != 0 { let _ = flush_icache(t, addr, n) }
        ok
    }
}

/// The 16 bytes of the return-value floating register (v0 of ARM_NEON_STATE64), or none.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_xmm0(t: Target) -> List[byte] {
    unsafe {
        // # Safety: buf is calloc'd 544 bytes; the thread port is the stopped thread's.
        var out: List[byte] = []
        let st = t.word as *u64
        let buf = c.calloc(1, 544) as *u8
        let cnt = c.calloc(1, 8) as *u32
        cnt[0] = 136
        let kr = thread_get_state(st[st_thread] as u32, 17, buf as u64, cnt as u64)
        if kr != 0 { return out }
        var i = 0
        while i < 16 {
            (mut out).push(buf[i] as int as byte)
            i += 1
        }
        out
    }
}

/// The floating-point status and control registers (fpsr, fpcr) from ARM_NEON_STATE64, or none.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_fp_status(t: Target) -> List[u64] {
    unsafe {
        // # Safety: buf is calloc'd 544 bytes; the thread port is the stopped thread's.
        var out: List[u64] = []
        let st = t.word as *u64
        let buf = c.calloc(1, 544) as *u32
        let cnt = c.calloc(1, 8) as *u32
        cnt[0] = 136
        let kr = thread_get_state(st[st_thread] as u32, 17, buf as u64, cnt as u64)
        if kr != 0 { return out }
        (mut out).push(buf[128] as u64)
        (mut out).push(buf[129] as u64)
        out
    }
}

/// Mach-O header magic and file type scan: the runtime address of the main image's first byte
/// (the slide is this minus the file's text address), or 0.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_image_base(t: Target) -> u64 {
    unsafe {
        // # Safety: buffers are calloc'd and sized for mach_vm_region's basic info.
        let a = c.calloc(1, 8) as *u64
        let sz = c.calloc(1, 8) as *u64
        let info = c.calloc(1, 64) as *u32
        let cnt = c.calloc(1, 8) as *u32
        let obj = c.calloc(1, 8) as *u32
        var n = 0
        while n < 64 {
            cnt[0] = 9
            let kr = mach_vm_region(t.memfd as u32, a as u64, sz as u64, 9, info as u64, cnt as u64, obj as u64)
            if kr != 0 { return 0 }
            let hdr = target_read(t, a[0], 16)
            if hdr.ok {
                let magic = (hdr.data[0] as int) + ((hdr.data[1] as int) << 8) + ((hdr.data[2] as int) << 16) + ((hdr.data[3] as int) << 24)
                let ftype = (hdr.data[12] as int)
                if magic == 4277009103 && ftype == 2 { return a[0] }
            }
            a[0] = a[0] + sz[0]
            n += 1
        }
        0
    }
}

/// Let the forked child go on: its original instructions are back, so the trap it stopped at is retried.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_detach(t: Target, pid: int) -> int {
    unsafe {
        // # Safety: the kept request belongs to the layer; replying to it releases the child's thread.
        let st = t.word as *u64
        if st[st_fork_task] == 0 || st[st_fork_pid] != pid as u64 { return -1 }
        let r = reply_to(st[st_msg2], 0)
        st[st_fork_task] = 0
        st[st_fork_pid] = 0
        r
    }
}

/// The pid of the forked child whose trap is pending, or -1.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_event_pid(t: Target) -> int {
    unsafe {
        // # Safety: the state block is calloc'd.
        let st = t.word as *u64
        if st[st_fork_task] == 0 { return -1 }
        st[st_fork_pid] as int
    }
}

/// The child is already stopped (its thread waits for the reply).
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_wait_pid(t: Target, pid: int) -> int { 0 }

/// A handle for another pid sharing this one's scratch space.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_with_pid(t: Target, pid: int) -> Target {
    unsafe {
        // # Safety: the state block is calloc'd.
        let st = t.word as *u64
        if st[st_fork_task] != 0 && st[st_fork_pid] == pid as u64 {
            return Target { pid: pid, memfd: st[st_fork_task] as int, status: t.status, regs: t.regs, word: t.word }
        }
    }
    Target { pid: pid, memfd: -1, status: t.status, regs: t.regs, word: t.word }
}


/// The watch registers the hardware has: the hw.optional.watchpoint sysctl (sys/sysctl.h), read once.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_watch_slots(t: Target) -> int {
    unsafe {
        // # Safety: the value and its length are calloc'd; the name is a NUL-terminated buffer.
        let st = t.word as *u64
        if st[st_watch_slots] != 0 { return st[st_watch_slots] as int }
        let name = cstr("hw.optional.watchpoint")
        let v = c.calloc(1, 8) as *u32
        let n = c.calloc(1, 8) as *u64
        n[0] = 4
        if sysctlbyname(name, v as u64, n as u64, 0, 0) != 0 { return 0 }
        var k = v[0] as int
        if k > 16 { k = 16 }
        st[st_watch_slots] = k as u64
        k
    }
}

/// Read ARM_DEBUG_STATE64 (mach/arm/_structs.h: bvr[16], bcr[16], wvr[16], wcr[16], mdscr_el1) into a
/// 130-word buffer, or 0.
#[cfg(target = "aarch64-apple-darwin")]
fn debug_state(t: Target) -> u64 {
    unsafe {
        // # Safety: the buffer is calloc'd 130 words; the thread port is the stopped thread's.
        let st = t.word as *u64
        let ds = c.calloc(1, 1040) as *u64
        let cnt = c.calloc(1, 8) as *u32
        cnt[0] = 130
        if thread_get_state(st[st_thread] as u32, 15, ds as u64, cnt as u64) != 0 { return 0 }
        ds as u64
    }
}

/// Program the watch registers: addrs[i] for lens[i] bytes, kinds[i] watch_write (stores) or
/// watch_access (loads and stores). DBGWCR (Arm ARM D13): E bit 0; PAC bits 1-2 = 0b10, EL0 only;
/// LSC bits 3-4 = 0b10 store or 0b11 load and store; BAS bits 5-12, the bytes of the aligned
/// doubleword DBGWVR names. Returns "" or why.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_set_watches(t: Target, addrs: List[u64], lens: List[int], kinds: List[int]) -> str {
    let slots = target_watch_slots(t)
    if addrs.len > slots { return "too many hardware watch slots" }
    unsafe {
        // # Safety: debug_state's buffer is 130 calloc'd words; the thread port is the stopped thread's.
        let st = t.word as *u64
        let p = debug_state(t)
        if p == 0 { return "cannot read the debug state" }
        let ds = p as *u64
        var i = 0
        while i < 16 {
            ds[32 + i] = 0
            ds[48 + i] = 0
            i += 1
        }
        i = 0
        while i < addrs.len {
            let lsc: u64 = if kinds[i] == watch_write { 2 } else { 3 }
            let lane = addrs[i] & 7
            let bas: u64 = (((1 as u64) << lens[i] as u64) - 1) << lane
            ds[32 + i] = addrs[i] - lane
            ds[48 + i] = 1 | (2 << 1) | (lsc << 3) | (bas << 5)
            i += 1
        }
        if thread_set_state(st[st_thread] as u32, 15, p, 130) != 0 { return "the kernel refused the watch registers" }
        ""
    }
}

/// The slot whose register fired at this stop, or -1. arm64 traps before the access, so the
/// instruction is run here with the watch registers off (one step), then they go back: the
/// session sees the access done, as on x86-64.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_watch_hit(t: Target) -> int {
    unsafe {
        // # Safety: buffers are layer-owned; the thread port is the stopped thread's.
        let st = t.word as *u64
        if st[st_kind] != kind_watch as u64 { return 0 - 1 }
        let addr = st[st_code1]
        let p = debug_state(t)
        if p == 0 { return 0 - 1 }
        let ds = p as *u64
        var slot = 0 - 1
        var saved: List[u64] = []
        var i = 0
        while i < 16 {
            let w = ds[48 + i]
            (mut saved).push(w)
            if slot < 0 && (w & 1) == 1 && ds[32 + i] <= addr && addr < ds[32 + i] + 8 { slot = i }
            ds[48 + i] = w & !(1 as u64)
            i += 1
        }
        if thread_set_state(st[st_thread] as u32, 15, p, 130) != 0 { return slot }
        if resume(t, 0, true) < 0 { return slot }
        let _ = target_wait(t)
        let q = debug_state(t)
        if q == 0 { return slot }
        let dq = q as *u64
        i = 0
        while i < 16 { dq[48 + i] = saved[i]; i += 1 }
        let _ = thread_set_state(st[st_thread] as u32, 15, q, 130)
        slot
    }
}


/// Select a thread (its port): registers, stepping and the step bit go to it.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_thread(t: Target, tid: int) -> Target {
    unsafe {
        // # Safety: the state block is calloc'd.
        let st = t.word as *u64
        if tid > 0 { st[st_thread] = tid as u64 }
    }
    t
}

/// The next event, with the thread (its port) that reported it.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_wait_any(t: Target) -> Waited {
    let st = target_wait(t)
    unsafe {
        // # Safety: the state block is calloc'd.
        let blk = t.word as *u64
        Waited { tid: blk[st_event_thread] as int, status: st }
    }
}

/// No tgkill on macOS: the task is suspended instead.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_tgkill(t: Target, pid: int, tid: int, sig: int) -> int { 0 - 1 }

/// macOS keeps no per-thread name a debugger reads through procfs.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_thread_name(t: Target, pid: int, tid: int) -> str { "" }

/// THREAD_IDENTIFIER_INFO of a thread (its port): the system-wide thread id and the thread's handle, or
/// zeros when the kernel refuses (mach/thread_info.h).
#[cfg(target = "aarch64-apple-darwin")]
fn thread_ident(tid: int) -> List[u64] {
    unsafe {
        // # Safety: info is calloc'd 3 words (THREAD_IDENTIFIER_INFO_COUNT is 6 natural_t); tid is a thread port of ours.
        let info = c.calloc(4, 8) as *u64
        let cnt = c.calloc(1, 8) as *u32
        cnt[0] = 6
        var out: List[u64] = []
        if thread_info(tid as u32, 4, info as u64, cnt as u64) != 0 { info[0] = 0; info[1] = 0 }
        (mut out).push(info[0])
        (mut out).push(info[1])
        out
    }
}

/// The selected thread's handle (THREAD_IDENTIFIER_INFO's thread_handle).
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_thread_pointer(t: Target) -> u64 { target_thread_pointer_of(t, target_current_thread(t)) }

/// A thread's handle, the thread named by its port; the selection is not changed.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_thread_pointer_of(t: Target, tid: int) -> u64 { thread_ident(tid)[1] }

/// A thread's system-wide id (THREAD_IDENTIFIER_INFO's thread_id), the thread named by its port.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_thread_tid(t: Target, tid: int) -> u64 { thread_ident(tid)[0] }

/// The thread that took the pending exception (its port).
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_event_thread(t: Target) -> int {
    unsafe {
        // # Safety: the state block is calloc'd.
        let st = t.word as *u64
        st[st_event_thread] as int
    }
}

/// The program's threads (their ports) in the kernel's order, the order they were made (task_threads).
/// The list the kernel allocates in sniff's space is given back; the ports stay sniff's, one name each.
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_threads(t: Target) -> List[int] {
    var out: List[int] = []
    unsafe {
        // # Safety: lp and cnt are calloc'd; the kernel's array is cnt u32s, deallocated after the copy.
        let lp = c.calloc(1, 8) as *u64
        let cnt = c.calloc(1, 8) as *u32
        if task_threads(t.memfd as u32, lp as u64, cnt as u64) != 0 { return out }
        let arr = lp[0] as *u32
        let n = cnt[0] as int
        var i = 0
        while i < n {
            (mut out).push(arr[i] as int)
            i += 1
        }
        let _ = mach_vm_deallocate(mach_task_self(), lp[0], (n * 4) as u64)
    }
    out
}

/// The thread the last exception named (its port).
#[cfg(target = "aarch64-apple-darwin")]
pub fn target_current_thread(t: Target) -> int {
    unsafe {
        // # Safety: the state block is calloc'd.
        let st = t.word as *u64
        st[st_thread] as int
    }
}
