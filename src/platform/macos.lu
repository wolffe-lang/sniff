// The macOS arm64 process layer: what the session needs, reached through
// Apple's documented debugging interfaces and nothing else. The child is
// started with posix_spawn(2) suspended (POSIX_SPAWN_START_SUSPENDED), its task
// port comes from task_for_pid(2) (the target carries get-task-allow, or sniff
// the debugger entitlement), exceptions arrive on a Mach port set with
// task_set_exception_ports, and ptrace(PT_ATTACHEXC) turns Unix signals into
// exceptions as sys/ptrace.h documents. Registers are thread_get_state with
// ARM_THREAD_STATE64, memory is mach_vm_read_overwrite/mach_vm_write, and a
// single step is MDSCR_EL1.SS through ARM_DEBUG_STATE64 (Arm ARM D2).
// Constants and message layouts are those of the SDK's declarations
// (mach/message.h, mach/mach_exc.defs, mach/arm/_structs.h, sys/ptrace.h);
// the layout of the exception request was checked by a compiled probe.
//
// A Target is one traced child. pid 0 means no child; then memfd carries the
// refusal (target_refusal). memfd of a live Target is the task port.
//
// Wait statuses are synthesised in wait(2)'s shape: a stop is
// (kind << 16) | (signal << 8) | 0x7f with kind 0x101 for a BRK trap, 0x102
// for a completed single step and 0x103 for a Unix signal, and the signal
// numbers are the session's (gdb's, Linux's numbering): darwin_to_session maps.

#[cfg(target = "aarch64-apple-darwin")]
import c "stdlib.h"

#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn posix_spawnattr_init(attr: u64) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn posix_spawnattr_setflags(attr: u64, flags: i32) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn posix_spawn(pid: u64, path: u64, actions: u64, attr: u64, argv: u64, envp: u64) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn _NSGetEnviron() -> u64
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn task_for_pid(host: u32, pid: i32, task: u64) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn mach_task_self() -> u32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn mach_port_allocate(task: u32, right: i32, name: u64) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn mach_port_insert_right(task: u32, name: u32, poly: u32, kind: i32) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn mach_port_deallocate(task: u32, name: u32) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn task_set_exception_ports(task: u32, mask: u32, port: u32, behavior: u32, flavor: i32) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn mach_msg(msg: u64, option: i32, send_size: u32, rcv_size: u32, rcv_name: u32, timeout: u32, notify: u32) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn thread_get_state(thread: u32, flavor: i32, state: u64, count: u64) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn thread_set_state(thread: u32, flavor: i32, state: u64, count: u32) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn pid_for_task(task: u32, pid: u64) -> i32
#[cfg(target = "aarch64-apple-darwin")]
extern "c" fn mach_vm_read_overwrite(task: u32, addr: u64, size: u64, data: u64, outsize: u64) -> i32
#[cfg(target = "aarch64-apple-darwin")]
