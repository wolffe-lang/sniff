// Shared platform types: the traced child's handle, register slot indexes
// (user_regs_struct order, measured by tools/abi-probe.c) and wait-status
// decoding (wait(2)). No platform calls here.

/// ptrace(2) requests, options and personality flag, as measured by tools/abi-probe.c.
pub const req_traceme: int = 0
/// PTRACE_PEEKDATA.
pub const req_peekdata: int = 2
/// PTRACE_POKEDATA.
pub const req_pokedata: int = 5
/// PTRACE_PEEKUSER.
pub const req_peekuser: int = 3
/// PTRACE_POKEUSER.
pub const req_pokeuser: int = 6
/// PTRACE_CONT.
pub const req_cont: int = 7
/// PTRACE_KILL.
pub const req_kill: int = 8
/// PTRACE_SINGLESTEP.
pub const req_singlestep: int = 9
/// PTRACE_GETREGS.
pub const req_getregs: int = 12
/// PTRACE_SETREGS.
pub const req_setregs: int = 13
/// PTRACE_GETFPREGS.
pub const req_getfpregs: int = 14
/// PTRACE_DETACH.
pub const req_detach: int = 17
/// PTRACE_SETOPTIONS.
pub const req_setoptions: int = 16896
/// PTRACE_GETEVENTMSG.
pub const req_geteventmsg: int = 16897
/// PTRACE_O_TRACEFORK.
pub const opt_tracefork: int = 2
/// PTRACE_O_TRACEVFORK.
pub const opt_tracevfork: int = 4
/// PTRACE_O_EXITKILL.
pub const opt_exitkill: int = 1048576
/// personality(2) ADDR_NO_RANDOMIZE.
pub const addr_no_randomize: int = 262144
/// PTRACE_O_TRACECLONE: a new thread is traced from its start and reported by a clone event.
pub const opt_traceclone: int = 8
/// PTRACE_EVENT_CLONE, the event in a clone stop's status (status >> 16).
pub const event_clone: int = 3
/// PTRACE_EVENT_STOP, the event of a seized tracee's interrupt stop.
pub const event_stop: int = 128
/// PTRACE_ATTACH.
pub const req_attach: int = 16
/// PTRACE_GETSIGINFO.
pub const req_getsiginfo: int = 16898
/// PTRACE_SEIZE.
pub const req_seize: int = 16902
/// PTRACE_INTERRUPT.
pub const req_interrupt: int = 16903
/// wait(2)'s __WALL: every child and tracee, threads included.
pub const wait_all: int = 1073741824
/// The tgkill system call's number on x86-64 Linux.
pub const sys_tgkill: int = 234
/// The size of siginfo_t and the byte offsets of the fields read through PTRACE_GETSIGINFO.
pub const siginfo_size: int = 128
/// si_signo's offset.
pub const siginfo_signo: int = 0
/// si_code's offset.
pub const siginfo_code: int = 8
/// si_pid's offset.
pub const siginfo_pid: int = 16
/// si_addr's offset.
pub const siginfo_addr: int = 16

/// One traced child and the scratch the calls share (addresses of C buffers
/// are held as integers: the module boundary stays free of raw pointers).
pub struct Target {
    pub pid: int,
    pub memfd: int,
    status: u64,
    regs: u64,
    word: u64,
}

/// Byte offset of struct user's u_debugreg, and the size of one debug register (S5's watchpoints).
pub const user_debugreg_offset: int = 848
/// Size of one u_debugreg slot.
pub const user_debugreg_size: int = 8

/// A watch slot's condition: data writes only, or data reads and writes.
pub const watch_write: int = 1
/// Data reads or writes (x86 has no read-only data breakpoint; an rwatch is one of these).
pub const watch_access: int = 3

/// Count of user_regs_struct slots.
pub const reg_count: int = 27
/// Slot of r15 in user_regs_struct.
pub const reg_r15: int = 0
/// Slot of r14 in user_regs_struct.
pub const reg_r14: int = 1
/// Slot of r13 in user_regs_struct.
pub const reg_r13: int = 2
/// Slot of r12 in user_regs_struct.
pub const reg_r12: int = 3
/// Slot of rbp in user_regs_struct.
pub const reg_rbp: int = 4
/// Slot of rbx in user_regs_struct.
pub const reg_rbx: int = 5
/// Slot of r11 in user_regs_struct.
pub const reg_r11: int = 6
/// Slot of r10 in user_regs_struct.
pub const reg_r10: int = 7
/// Slot of r9 in user_regs_struct.
pub const reg_r9: int = 8
/// Slot of r8 in user_regs_struct.
pub const reg_r8: int = 9
/// Slot of rax in user_regs_struct.
pub const reg_rax: int = 10
/// Slot of rcx in user_regs_struct.
pub const reg_rcx: int = 11
/// Slot of rdx in user_regs_struct.
pub const reg_rdx: int = 12
/// Slot of rsi in user_regs_struct.
pub const reg_rsi: int = 13
/// Slot of rdi in user_regs_struct.
pub const reg_rdi: int = 14
/// Slot of orig_rax in user_regs_struct.
pub const reg_orig_rax: int = 15
/// Slot of rip in user_regs_struct.
pub const reg_rip: int = 16
/// Slot of cs in user_regs_struct.
pub const reg_cs: int = 17
/// Slot of eflags in user_regs_struct.
pub const reg_eflags: int = 18
/// Slot of rsp in user_regs_struct.
pub const reg_rsp: int = 19
/// Slot of ss in user_regs_struct.
pub const reg_ss: int = 20
/// Slot of fs_base in user_regs_struct.
pub const reg_fs_base: int = 21
/// Slot of gs_base in user_regs_struct.
pub const reg_gs_base: int = 22
/// Slot of ds in user_regs_struct.
pub const reg_ds: int = 23
/// Slot of es in user_regs_struct.
pub const reg_es: int = 24
/// Slot of fs in user_regs_struct.
pub const reg_fs: int = 25
/// Slot of gs in user_regs_struct.
pub const reg_gs: int = 26


/// One wait(2) answer: the thread it is about and its raw status (tid -1 when the wait failed).
pub struct Waited {
    pub tid: int,
    pub status: int,
}

/// Bytes read from the child; ok is false when the read failed.
pub struct Bytes {
    pub ok: bool,
    pub data: List[byte],
}


/// Whether the child stopped (not exited) in raw wait status st.
pub fn status_stopped(st: int) -> bool { (st & 255) == 127 }
/// Stop signal of a stopped status.
pub fn status_stop_signal(st: int) -> int { (st >> 8) & 255 }
/// Whether the child exited normally.
pub fn status_exited(st: int) -> bool { (st & 127) == 0 }
/// Exit code of an exited status.
pub fn status_exit_code(st: int) -> int { (st >> 8) & 255 }
/// Whether the child was killed by a signal.
pub fn status_signaled(st: int) -> bool { (st & 127) != 0 && (st & 255) != 127 }
/// Terminating signal of a signaled status.
pub fn status_term_signal(st: int) -> int { st & 127 }

/// The two's-complement bits of a signed value as unsigned (no trap on negatives).
pub fn bits_u64(x: i64) -> u64 {
    let w = x as wrapping[u64]
    w as u64
}

/// The bits of an unsigned value as signed (no trap above 2^63).
pub fn bits_i64(x: u64) -> i64 {
    let w = x as wrapping[i64]
    w as i64
}
