// The Linux x86-64 process layer: everything the session needs from the
// platform, and nothing else. ptrace(2), wait(2), personality(2), execve(2)
// and proc(5) are reached through wolf's C membrane. The request numbers and
// the user_regs_struct slot indexes below are the ones tools/abi-probe.c
// measured in the oracle container (R-sn02-3).
//
// A Target is one traced child. pid 0 means no child.

#[cfg(target = "x86_64-unknown-linux-gnu")]
import c "stdlib.h"

#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn fork() -> i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn execv(path: *u8, argv: *u64) -> i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn ptrace(request: i32, ...) -> i64
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn waitpid(pid: i32, status: *i32, options: i32) -> i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn personality(persona: u64) -> i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn _exit(code: i32) -> never
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn __errno_location() -> *i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn open(path: *u8, flags: i32, ...) -> i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn pread(fd: i32, buf: *u8, n: u64, off: i64) -> i64
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn close(fd: i32) -> i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn kill(pid: i32, sig: i32) -> i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn setenv(name: *u8, value: *u8, overwrite: i32) -> i32
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn getenv(name: *u8) -> *u8
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn getcwd(buf: *u8, size: u64) -> *u8
#[cfg(target = "x86_64-unknown-linux-gnu")]
extern "c" fn syscall(number: i64, ...) -> i64

/// Heap bytes holding text and a terminating zero, for the C calls.
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn cstr(s: str) -> *u8 {
    let b = s.bytes()
    let n = b.len
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        let p = c.calloc(1, (n + 1) as uint) as *u8
        var i = 0
        while i < n {
            p[i] = b[i] as int as u8
            i += 1
        }
        p
    }
}

/// No child.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_none() -> Target {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        Target {
            pid: 0,
            memfd: -1,
            status: c.calloc(1, 8) as u64,
            regs: c.calloc(27, 8) as u64,
            word: c.calloc(1, 16) as u64,
        }
    }
}

/// Start path as a traced child with ASLR off (as gdb's disable-randomization
/// does), stopped at its exec. The returned Target has pid 0 when fork or the
/// first wait fails; exec_failed is reported through the first stop never
/// arriving as a stop (the child exits 127).
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_spawn(path: str, args: List[str], env_lines: str, env_columns: str) -> Target {
    let tgt = target_none()
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        let tstatus = tgt.status as *i32
        let argv = c.calloc((args.len + 2) as uint, 8) as *u64
        let cpath = cstr(path)
        argv[0] = cpath as u64
        var i = 0
        while i < args.len {
            argv[i + 1] = cstr(args[i]) as u64
            i += 1
        }
        argv[args.len + 1] = 0
        let pid = fork()
        if pid == 0 {
            let _ = ptrace(req_traceme as i32, 0, 0 as u64, 0 as u64)
            let _ = personality(addr_no_randomize as u64)
            // gdb runs the program through a shell with LINES and COLUMNS set, and
            // the shell exports PWD: the same environment keeps stack addresses equal.
            if env_lines.bytes().len > 0 {
                let _ = setenv(cstr("LINES"), cstr(env_lines), 1)
                let _ = setenv(cstr("COLUMNS"), cstr(env_columns), 1)
                let have = getenv(cstr("PWD"))
                if have as u64 == 0 {
                    let cwd = c.calloc(1, 4096) as *u8
                    let got = getcwd(cwd, 4095)
                    if got as u64 != 0 { let _ = setenv(cstr("PWD"), cwd, 1) }
                }
            }
            let _ = execv(cpath, argv)
            _exit(127)
        }
        if pid < 0 { return tgt }
        let w = waitpid(pid, tstatus, 1073741824)
        if w != pid { return tgt }
        let st = tstatus[0] as int
        if (st & 255) != 127 {
            return tgt
        }
        let fd = open(cstr("/proc/{pid}/mem"), 0)
        // PTRACE_SETOPTIONS: EXITKILL (the child never outlives sniff), TRACEFORK and
        // TRACEVFORK (so a forked child can be detached with its breakpoints removed), and
        // TRACECLONE (every new thread traced from its start and reported by a clone event).
        let _ = ptrace(req_setoptions as i32, pid, 0 as u64, (opt_exitkill + opt_tracefork + opt_tracevfork + opt_traceclone) as u64)
        Target { pid: pid as int, memfd: fd as int, status: tgt.status, regs: tgt.regs, word: tgt.word }
    }
}

/// Wait for the next event of the child. Returns the raw wait status, or -1.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_wait(t: Target) -> int {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        let status = t.status as *i32
        let w = waitpid(t.pid as i32, status, 1073741824)
        if w != t.pid as i32 { return -1 }
        status[0] as int
    }
}

/// PTRACE_CONT, delivering sig (0 for none).
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_cont(t: Target, sig: int) -> int {
    unsafe {
        // # Safety: the pid is the traced child; every pointer argument is a calloc'd buffer sized for the request.
        ptrace(req_cont as i32, t.pid as i32, 0 as u64, sig as u64) as int
    }
}

/// PTRACE_SINGLESTEP, delivering sig (0 for none).
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_step(t: Target, sig: int) -> int {
    unsafe {
        // # Safety: the pid is the traced child; every pointer argument is a calloc'd buffer sized for the request.
        ptrace(req_singlestep as i32, t.pid as i32, 0 as u64, sig as u64) as int
    }
}

/// Kill the child with SIGKILL and reap every thread of it. Returns the leader's final raw status. A
/// leader's death is reported only after its other traced threads are waited for (wait(2), __WALL), so
/// every thread's report is collected, the leader's last.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_kill(t: Target) -> int {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        let status = t.status as *i32
        let _ = kill(t.pid as i32, 9)
        let _ = close(t.memfd as i32)
        var last: int = -1
        var n = 0
        while n < 4096 {
            let w = waitpid(0 - 1, status, wait_all as i32)
            if w <= 0 { return last }
            let st = status[0] as int
            if (st & 255) == 127 {
                // a thread caught in a stop: SIGKILL acts at once, its death follows
                let _ = ptrace(req_cont as i32, w, 0 as u64, 9 as u64)
            } else if w == t.pid as i32 {
                return st
            }
            n += 1
        }
        last
    }
}

/// A handle on one thread of the traced process: ptrace's requests go to that thread, memory through the
/// process's /proc/PID/mem, which reads the same address space from any of its threads (proc_pid_mem(5)).
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_thread(t: Target, tid: int) -> Target {
    Target { pid: tid, memfd: t.memfd, status: t.status, regs: t.regs, word: t.word }
}

/// The next event of any traced thread or child: waitpid(-1, __WALL). tid is -1 when the wait failed.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_wait_any(t: Target) -> Waited {
    unsafe {
        // # Safety: the status buffer is calloc'd; the waits are for the tracer's own tracees.
        let status = t.status as *i32
        let w = waitpid(0 - 1, status, wait_all as i32)
        if w <= 0 { return Waited { tid: 0 - 1, status: 0 - 1 } }
        Waited { tid: w as int, status: status[0] as int }
    }
}

/// tgkill(2): send sig to one thread of the process pid. Returns 0 or -1.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_tgkill(t: Target, pid: int, tid: int, sig: int) -> int {
    unsafe {
        // # Safety: the thread is one of the traced process's.
        syscall(sys_tgkill as i64, pid as i64, tid as i64, sig as i64) as int
    }
}

/// The name the kernel keeps for a thread (/proc/PID/task/TID/comm, proc_pid_comm(5)), "" when it has none
/// to read.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_thread_name(t: Target, pid: int, tid: int) -> str {
    let raw = fs_read_bytes("/proc/{pid}/task/{tid}/comm") else { return "" }
    let text = str_from_utf8(raw) else { return "" }
    text.trim()
}

/// The thread a stopped thread's registers say it is (fs_base: glibc's thread pointer, which is its
/// pthread_t), or 0.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_thread_pointer(t: Target) -> u64 {
    let r = target_regs(t)
    if r.len != reg_count { return 0 }
    r[reg_fs_base]
}

/// The 27 user_regs_struct slots, or an empty list when the child cannot be read.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_regs(t: Target) -> List[u64] {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        var out: List[u64] = []
        let regs = t.regs as *u64
        let r = ptrace(req_getregs as i32, t.pid as i32, 0 as u64, t.regs)
        if r < 0 { return out }
        var i = 0
        while i < 27 {
            (mut out).push(regs[i])
            i += 1
        }
        out
    }
}

/// Write the 27 slots back. Returns 0 or -1.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_set_regs(t: Target, regs: List[u64]) -> int {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        if regs.len != 27 { return -1 }
        let slots = t.regs as *u64
        var i = 0
        while i < 27 {
            slots[i] = regs[i]
            i += 1
        }
        ptrace(req_setregs as i32, t.pid as i32, 0 as u64, t.regs) as int
    }
}

/// Read n bytes at addr through /proc/PID/mem. ok is false on a short read.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_read(t: Target, addr: u64, n: int) -> Bytes {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        var out: List[byte] = []
        if n <= 0 { return Bytes { ok: true, data: out } }
        if addr > 9223372036854775807 { return Bytes { ok: false, data: out } }
        let buf = c.calloc(1, n as uint) as *u8
        let got = pread(t.memfd as i32, buf, n as u64, addr as i64)
        if got != n as i64 { return Bytes { ok: false, data: out } }
        var i = 0
        while i < n {
            (mut out).push(buf[i] as int as byte)
            i += 1
        }
        Bytes { ok: true, data: out }
    }
}

/// Read one 8-byte word with PTRACE_PEEKDATA. ok is false when unmapped.
#[cfg(target = "x86_64-unknown-linux-gnu")]
fn peek_word(t: Target, addr: u64) -> Bytes {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        var out: List[byte] = []
        let e = __errno_location()
        e[0] = 0
        let w = ptrace(req_peekdata as i32, t.pid as i32, addr, 0 as u64)
        if w == -1 && e[0] != 0 { return Bytes { ok: false, data: out } }
        let ww = w as wrapping[u64]
        let u = ww as u64
        var i = 0
        while i < 8 {
            (mut out).push(((u >> (8 * i as u64)) & 255) as int as byte)
            i += 1
        }
        Bytes { ok: true, data: out }
    }
}

/// Write bytes at addr with PTRACE_POKEDATA, a word at a time with
/// read-modify-write at the edges. Returns true when every word was written.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_write(t: Target, addr: u64, data: List[byte]) -> bool {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        var off = 0
        while off < data.len {
            let remain = data.len - off
            var start = addr + off as u64
            var skip = 0
            var chunk = remain
            if chunk > 8 { chunk = 8 }
            var cur = peek_word(t, start)
            if !cur.ok {
                // the word would run past the end of a mapping: end it at the last byte
                if start < 8 { return false }
                start = start - (8 - chunk) as u64
                skip = 8 - chunk
                cur = peek_word(t, start)
                if !cur.ok { return false }
            }
            var w: u64 = 0
            var j = 0
            while j < 8 {
                var b = cur.data[j] as int
                if j >= skip && j - skip < chunk { b = data[off + j - skip] as int }
                w = w | ((b as u64) << (8 * j as u64))
                j += 1
            }
            let r = ptrace(req_pokedata as i32, t.pid as i32, start, w)
            if r < 0 { return false }
            off += chunk
        }
        true
    }
}


/// The 16 bytes of xmm0 (user_fpregs_struct holds xmm0 at byte 160), or none.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_xmm0(t: Target) -> List[byte] {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        var out: List[byte] = []
        let buf = c.calloc(1, 512) as *u8
        let r = ptrace(req_getfpregs as i32, t.pid as i32, 0 as u64, buf as u64)
        if r < 0 { return out }
        var i = 0
        while i < 16 {
            (mut out).push(buf[160 + i] as int as byte)
            i += 1
        }
        out
    }
}

/// Detach from a traced pid after restoring nothing: used for forked children.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_detach(t: Target, pid: int) -> int {
    unsafe {
        // # Safety: the pid is the traced child; every pointer argument is a calloc'd buffer sized for the request.
        ptrace(req_detach as i32, pid as i32, 0 as u64, 0 as u64) as int
    }
}

/// The pid of the child a fork event stopped on (PTRACE_GETEVENTMSG).
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_event_pid(t: Target) -> int {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        let buf = c.calloc(1, 8) as *u64
        let r = ptrace(req_geteventmsg as i32, t.pid as i32, 0 as u64, buf as u64)
        if r < 0 { return 0 - 1 }
        buf[0] as int
    }
}

/// Wait for a specific pid (a fork child's first stop).
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_wait_pid(t: Target, pid: int) -> int {
    unsafe {
        // # Safety: pointers are calloc'd buffers sized for the call, and pid is the traced child.
        let status = t.status as *i32
        let w = waitpid(pid as i32, status, 1073741824)
        if w != pid as i32 { return 0 - 1 }
        status[0] as int
    }
}

/// A handle for another traced pid sharing this one's scratch space.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_with_pid(t: Target, pid: int) -> Target {
    Target { pid: pid, memfd: -1, status: t.status, regs: t.regs, word: t.word }
}

/// Why target_spawn gave no child; Linux needs no refusal text.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_refusal(t: Target) -> str { "" }

/// fpsr and fpcr exist as registers on arm64 only.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_fp_status(t: Target) -> List[u64] { [] }

/// PTRACE_PEEKUSER of debug register n (0-7), at the byte offset of struct user's u_debugreg that
/// tools/abi-probe.c measured. ptrace(2): the word is the return value, so errno tells a failure
/// from a register that holds -1. ok is false on failure.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_debugreg(t: Target, n: int) -> Bytes {
    unsafe {
        // # Safety: the pid is the traced child; errno is this thread's.
        let e = __errno_location()
        e[0] = 0
        let v = ptrace(req_peekuser as i32, t.pid as i32, (user_debugreg_offset + n * user_debugreg_size) as u64, 0 as u64)
        if v == -1 && e[0] != 0 { return Bytes { ok: false, data: [] } }
        var out: List[byte] = []
        let w = bits_u64(v as i64)
        var i = 0
        while i < 8 { (mut out).push(((w >> (8 * i) as u64) & 255) as int as byte); i += 1 }
        Bytes { ok: true, data: out }
    }
}

/// PTRACE_POKEUSER of debug register n. The kernel checks DR7 and the addresses, so a refused
/// value is -1 here, never a fault.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_set_debugreg(t: Target, n: int, v: u64) -> int {
    unsafe {
        // # Safety: the pid is the traced child.
        ptrace(req_pokeuser as i32, t.pid as i32, (user_debugreg_offset + n * user_debugreg_size) as u64, v) as int
    }
}

/// Hardware watch slots on x86-64: DR0-DR3 (Intel SDM vol. 3, 18.2).
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_watch_slots(t: Target) -> int { 4 }

/// Program the watch slots: addrs[i] watched for lens[i] bytes (1, 2, 4 or 8, aligned to itself),
/// kinds[i] watch_write or watch_access. Slots past the list are disabled. DR7 per slot i: the local
/// enable bit 2i, R/W at bits 16+4i (01 data writes, 11 data reads or writes; x86 has no read-only
/// data breakpoint) and LEN at bits 18+4i (00 one byte, 01 two, 11 four, 10 eight). Returns "" or why.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_set_watches(t: Target, addrs: List[u64], lens: List[int], kinds: List[int]) -> str {
    if addrs.len > 4 { return "too many hardware watch slots" }
    // DR7 off first, so no half-written slot can fire
    if target_set_debugreg(t, 7, 0) < 0 { return "cannot write DR7" }
    var dr7: u64 = 0
    var i = 0
    while i < addrs.len {
        var len_bits: u64 = 0
        if lens[i] == 2 { len_bits = 1 } else if lens[i] == 4 { len_bits = 3 } else if lens[i] == 8 { len_bits = 2 }
        else if lens[i] != 1 { return "a hardware watch covers 1, 2, 4 or 8 bytes" }
        let rw: u64 = if kinds[i] == watch_write { 1 } else { 3 }
        if target_set_debugreg(t, i, addrs[i]) < 0 { return "cannot write DR{i}" }
        dr7 = dr7 | ((1 as u64) << (2 * i) as u64) | (rw << (16 + 4 * i) as u64) | (len_bits << (18 + 4 * i) as u64)
        i += 1
    }
    if dr7 != 0 && target_set_debugreg(t, 7, dr7) < 0 { return "the kernel refused DR7" }
    ""
}

/// The slot whose condition fired at the last stop (DR6 B0-B3), or -1. DR6 is cleared after the
/// read, since the processor never clears it (Intel SDM vol. 3, 18.2.3).
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_watch_hit(t: Target) -> int {
    let r = target_debugreg(t, 6)
    if !r.ok { return 0 - 1 }
    let b = r.data[0] as int
    let _ = target_set_debugreg(t, 6, 0)
    var i = 0
    while i < 4 {
        if (b >> i) & 1 == 1 { return i }
        i += 1
    }
    0 - 1
}

/// The thread a handle names: on Linux the handle's own id.
#[cfg(target = "x86_64-unknown-linux-gnu")]
pub fn target_current_thread(t: Target) -> int { t.pid }
