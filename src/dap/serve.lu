// The Debug Adapter Protocol's server state before any program: the messages sniff makes (each numbered by seq), the
// capabilities it declares, and the answers it gives before a program exists: `initialize` with the capabilities it
// holds rows for, `disconnect` by ending, and any request it does not support with success: false naming it (the
// specification lets an adapter refuse a request; sniff adds no requests, events or fields of its own). The loop
// over standard input, and every request that needs a program, are the session's (session/dapserve.lu).

use std.json

/// The server's state: the last seq it used, the messages made and not yet written, and whether the client has
/// disconnected.
pub struct Session {
    pub seq: int,
    pub out: List[str],
    pub done: bool,
}

/// A session before the first message.
pub fn session() -> Session {
    let none: List[str] = []
    Session { seq: 0, out: none, done: false }
}

/// The capabilities sniff declares: exactly those its rows hold, each one the pinned gdb also declares.
pub fn capabilities() -> json.Value {
    var f = Map[str, json.Value]()
    f["supportsConfigurationDoneRequest"] = json.from_bool(true)
    f["supportsFunctionBreakpoints"] = json.from_bool(true)
    f["supportsConditionalBreakpoints"] = json.from_bool(true)
    f["supportsHitConditionalBreakpoints"] = json.from_bool(true)
    f["supportsEvaluateForHovers"] = json.from_bool(true)
    f["supportsSteppingGranularity"] = json.from_bool(true)
    f["supportsReadMemoryRequest"] = json.from_bool(true)
    f["supportsTerminateRequest"] = json.from_bool(true)
    f["supportTerminateDebuggee"] = json.from_bool(true)
    json.from_map(f)
}

/// The response to REQ, numbered next, as text (kept by the caller; `answer` queues it).
pub fn response(mut s: Session, req: Message, ok: bool, text: str, body: json.Value) -> str {
    s.seq += 1
    response_text(s.seq, req, ok, text, body)
}

/// The event NAME, numbered next, as text.
pub fn event(mut s: Session, name: str, body: json.Value) -> str {
    s.seq += 1
    event_text(s.seq, name, body)
}

fn answer(mut s: Session, req: Message, ok: bool, text: str, body: json.Value) {
    let t = response(mut s, req, ok, text, body)
    (mut s.out).push(t)
}

/// One message from the client. Its responses and events are queued on `s.out`, in order. A response or an event
/// from the client needs nothing back: sniff sends no requests of its own.
pub fn on_message(mut s: Session, m: Message) {
    if m.kind != kind_request { return }
    if m.command == "initialize" {
        answer(mut s, m, true, "", capabilities())
        return
    }
    if m.command == "disconnect" {
        answer(mut s, m, true, "", json.null())
        s.done = true
        return
    }
    answer(mut s, m, false, "sniff does not support the request {m.command}", json.null())
}
