// Standard names from DWARF 5 (2017-02-13) chapter 7 encoding tables:
// 7.2 unit types, 7.3 tags, 7.5 attributes, 7.6 forms, 7.9 operations,
// 7.10-7.30 constants and CFA instructions. Generated once from the spec
// text; lo_user/hi_user markers are omitted. Vendor names are added only in
// vendor.lu, each from labelled oracle evidence. "" means no standard name.

/// Dense code-indexed name lists, built once per run.
pub struct Names {
    pub tag: List[str],
    pub attribute: List[str],
    pub form: List[str],
    pub operation: List[str],
    pub language: List[str],
    pub encoding: List[str],
    pub cfa: List[str],
    pub lle: List[str],
    pub rle: List[str],
    pub unit_type: List[str],
    pub calling_convention: List[str],
    pub inline: List[str],
    pub accessibility: List[str],
    pub visibility: List[str],
    pub virtuality: List[str],
    pub identifier_case: List[str],
    pub decimal_sign: List[str],
    pub endianity: List[str],
    pub ordering: List[str],
    pub defaulted: List[str],
    pub line_content: List[str],
    pub line_extended: List[str],
}

/// Look a code up in one dense list; "" when it has no standard name.
pub fn name_in(names: List[str], code: u64) -> str {
    if code < names.len as u64 { return names[code as int] }
    ""
}

/// Build every standard name list once; total, no rows.
pub fn names_new() -> Names {
    Names {
        tag: [
