// The dump's failure set: every reader row it can propagate, plus its own.
// Rows are structural, so each reader's narrower set flows through `?`.

pub error DumpError = {
    invalid_bounds,
    truncated,
    unsupported_width,
    unterminated_leb128,
    leb128_overflow,
    unterminated_string,
    offset_overflow,
    resource_limit,
    reserved_dwarf_length,
    unsupported_dwarf_version,
    unsupported_address_size,
    unsupported_split_dwarf,
    unsupported_unit_type,
    invalid_dwarf_reference,
    invalid_abbreviation,
    duplicate_abbreviation,
    unsupported_dwarf_form,
    unsupported_supplementary_dwarf,
    dwarf_line_invalid_header,
    dwarf_line_invalid_string,
    dwarf_line_invalid_index,
    dwarf_line_unsupported_segment,
    dwarf_line_unsupported_opcode,
    dwarf_line_unsupported_content,
    dwarf_line_invalid_opcode,
    dwarf_line_arithmetic_overflow,
    dwarf_line_unterminated_sequence,
    unsupported_segment_selector,
    unsupported_index_kind,
    invalid_index_padding,
    invalid_index_length,
    invalid_index_count,
    invalid_index_base,
    invalid_index,
    invalid_index_table,
    invalid_index_target,
    incompatible_index_width,
    dwarf_info_invalid_abbrev_offset,
    dwarf_info_unknown_abbreviation,
    dwarf_info_invalid_tree,
    dwarf_info_invalid_reference,
    dwarf_info_not_reference,
    dwarf_info_reference_cycle,
    dwarf_expr_unknown_opcode,
    dwarf_expr_invalid_operand,
    dwarf_expr_invalid_branch,
    dwarf_expr_invalid_reference,
    dwarf_expr_invalid_structure,
    dwarf_expr_operation_limit,
    dwarf_expr_depth_limit,
    elf_bad_magic,
    elf_truncated,
    elf_offset_overflow,
    elf_invalid_header,
    elf_invalid_section,
    elf_invalid_link,
    elf_invalid_string,
    elf_invalid_symbol,
    elf_invalid_index,
    elf_resource_limit,
    elf_unsupported_class,
    elf_unsupported_endian,
    elf_unsupported_machine,
    elf_unsupported_relocatable,
    elf_unsupported_type,
    elf_unsupported_compression,
    invalid_macho_magic,
    unsupported_object_class,
    unsupported_endianness,
    unsupported_architecture,
    unsupported_fat_macho,
    unsupported_filetype,
    invalid_load_commands,
    invalid_segment,
    invalid_section,
    unsupported_compressed_section,
    duplicate_symtab,
    duplicate_uuid,
    invalid_symbol_string,
    invalid_symbol_section,
    missing_uuid,
    dsym_uuid_mismatch,
    unsupported_compact_unwind,
    unsupported_object_format,
    unsupported_debug_types,
    unsupported_dump_mode,
    dump_write_failed,
    dwarf_list_unknown_kind,
}
