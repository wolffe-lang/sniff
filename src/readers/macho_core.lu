// Mach-O core files: MH_CORE as lldb's `process save-core` writes them for macOS arm64 programs. The layouts are the
// SDK's declarations: mach-o/loader.h (mach_header_64, segment_command_64, thread_command, note_command) and
// mach/arm/thread_status.h (the ARM_THREAD_STATE64 and ARM_EXCEPTION_STATE64 flavours). tools/abi-probe-macos.c
// compiles against them and tools/check-abi.py holds the constants below to its record. Like core.lu this reads and
// never copies: segments, notes and image paths are offsets and spans into the caller's buffer, and every read is
// bounded and charged against the caller's work.
//
// Two LC_NOTE payloads have no SDK declaration. Their layouts were derived from lldb's own cores against lldb's
// `image list` over the same core and against the program's LC_UUID (tests/s7-macho-prediction.json):
//   `all image infos`: a 24-byte header (version 1, image count, the file offset of the entries, entry size 48, 0),
//     then per image its path's file offset, its UUID, its load address, its segment list's file offset, the segment
//     count and a flag; each segment-list entry is a 16-byte name, the segment's address and a word that is 0. The
//     first image is the program.
//   `addrable bits`: four 32-bit words, read as a version, the addressable bits of low memory and of high memory, 0.

/// Malformed Mach-O core layouts and the profiles this reader refuses.
pub error MachCoreError = {
    macho_core_bad_magic,
    macho_core_truncated,
    macho_core_not_core,
    macho_core_unsupported_cpu,
    macho_core_invalid_command,
    macho_core_invalid_segment,
    macho_core_invalid_thread,
    macho_core_invalid_note,
    macho_core_resource_limit,
}

// mach-o/loader.h, by tools/abi-probe-macos.c
/// MH_MAGIC_64: a 64-bit Mach-O in the host's byte order.
pub const macho_core_mh_magic_64: int = 4277009103
/// MH_CORE: the file type of a core.
pub const macho_core_mh_core: int = 4
/// CPU_TYPE_ARM64.
pub const macho_core_cpu_type_arm64: int = 16777228
/// sizeof(struct mach_header_64): the load commands start here.
pub const macho_core_header_size: int = 32
/// offsetof(struct mach_header_64, cputype).
pub const macho_core_header_cputype: int = 4
/// offsetof(struct mach_header_64, cpusubtype).
pub const macho_core_header_cpusubtype: int = 8
/// offsetof(struct mach_header_64, filetype).
pub const macho_core_header_filetype: int = 12
/// offsetof(struct mach_header_64, ncmds).
pub const macho_core_header_ncmds: int = 16
/// offsetof(struct mach_header_64, sizeofcmds).
pub const macho_core_header_sizeofcmds: int = 20
/// LC_SEGMENT_64.
pub const macho_core_lc_segment_64: int = 25
/// LC_THREAD.
pub const macho_core_lc_thread: int = 4
/// LC_NOTE.
pub const macho_core_lc_note: int = 49
/// sizeof(struct segment_command_64).
pub const macho_core_segment_size: int = 72
/// offsetof(struct segment_command_64, vmaddr).
pub const macho_core_segment_vmaddr: int = 24
/// offsetof(struct segment_command_64, vmsize).
pub const macho_core_segment_vmsize: int = 32
/// offsetof(struct segment_command_64, fileoff).
pub const macho_core_segment_fileoff: int = 40
/// offsetof(struct segment_command_64, filesize).
pub const macho_core_segment_filesize: int = 48
/// offsetof(struct segment_command_64, initprot).
pub const macho_core_segment_initprot: int = 60
/// sizeof(struct note_command).
pub const macho_core_note_size: int = 40
/// offsetof(struct note_command, data_owner).
pub const macho_core_note_owner: int = 8
/// sizeof data_owner.
pub const macho_core_note_owner_size: int = 16
/// offsetof(struct note_command, offset): the payload's file offset.
pub const macho_core_note_offset: int = 24
/// offsetof(struct note_command, size): the payload's size.
pub const macho_core_note_payload_size: int = 32

// mach/arm/thread_status.h, by tools/abi-probe-macos.c
/// ARM_THREAD_STATE64: the general registers.
pub const macho_core_thread_state64: int = 6
/// ARM_THREAD_STATE64_COUNT, in 32-bit words.
pub const macho_core_thread_state64_count: int = 68
/// ARM_EXCEPTION_STATE64: the fault address, the exception syndrome and the exception.
pub const macho_core_exception_state64: int = 7
/// ARM_EXCEPTION_STATE64_COUNT, in 32-bit words.
pub const macho_core_exception_state64_count: int = 4
/// offsetof(arm_thread_state64_t, __fp): x29, after x0-x28.
pub const macho_core_state_fp: int = 232
/// offsetof(arm_thread_state64_t, __lr).
pub const macho_core_state_lr: int = 240
/// offsetof(arm_thread_state64_t, __sp).
pub const macho_core_state_sp: int = 248
/// offsetof(arm_thread_state64_t, __pc).
pub const macho_core_state_pc: int = 256
/// offsetof(arm_thread_state64_t, __cpsr) (4 bytes).
pub const macho_core_state_cpsr: int = 264
/// offsetof(arm_exception_state64_t, __far).
pub const macho_core_exception_far: int = 0
/// offsetof(arm_exception_state64_t, __esr) (4 bytes).
pub const macho_core_exception_esr: int = 8
/// offsetof(arm_exception_state64_t, __exception) (4 bytes).
pub const macho_core_exception_exception: int = 12

// the derived layouts (above), not in any SDK header
/// The `all image infos` header: version, count, entries' offset, entry size, reserved.
pub const macho_core_images_header: int = 24
/// One `all image infos` entry.
pub const macho_core_image_entry: int = 48
/// One entry of an image's segment list.
pub const macho_core_image_segment_entry: int = 32

/// The caps a read stays inside; macho_core_caps() gives the defaults the session uses.
pub struct MachCoreCaps {
    pub commands: int,
    pub commands_bytes: int,
    pub segments: int,
    pub threads: int,
    pub flavours: int,
    pub flavour_words: int,
    pub notes: int,
    pub images: int,
    pub path_bytes: int,
    pub image_segments: int,
    pub work: int,
}

/// The default caps: 65536 load commands in at most 16 MiB, 65536 segments, 4096 threads of at most 16 flavours of
/// at most 1024 words, 64 notes, 4096 images with paths of at most 1024 bytes (MAXPATHLEN) and 256 segments each.
pub fn macho_core_caps() -> MachCoreCaps {
    MachCoreCaps {
        commands: 65536,
        commands_bytes: 16777216,
        segments: 65536,
        threads: 4096,
        flavours: 16,
        flavour_words: 1024,
        notes: 64,
        images: 4096,
        path_bytes: 1024,
        image_segments: 256,
        work: 50000000,
    }
}

/// One LC_SEGMENT_64: the memory at [vmaddr, vmaddr + vmsize), whose first filesize bytes are at fileoff.
pub struct MachCoreSegment {
    pub vmaddr: u64,
    pub vmsize: u64,
    pub fileoff: u64,
    pub filesize: u64,
    pub initprot: int,
}

/// One LC_THREAD: its 34 register slots as the macOS platform's target_regs returns them (x0-x28, fp, lr, sp, pc,
/// cpsr), and its exception state (all 0 when the thread has none).
pub struct MachCoreThread {
    pub regs: List[u64],
    pub far: u64,
    pub esr: u64,
    pub exception: u64,
}

/// One LC_NOTE: its owner's name (up to its NUL, at most 16 bytes) and its payload in the file.
pub struct MachCoreNote {
    pub owner: ByteSpan,
    pub offset: u64,
    pub size: u64,
}

/// One segment of an image in the image list: its name and address.
pub struct MachCoreImageSegment {
    pub name: ByteSpan,
    pub vmaddr: u64,
}

/// One image of `all image infos`: its path, its UUID (16 bytes), its load address and its segments.
pub struct MachCoreImage {
    pub path: ByteSpan,
    pub uuid: ByteSpan,
    pub load: u64,
    pub flag: u64,
    pub segments: List[MachCoreImageSegment],
}

/// A Mach-O core's layout. The first image is the program; addressable bits are 0 when the core does not say.
pub struct MachCoreFile {
    pub segments: List[MachCoreSegment],
    pub threads: List[MachCoreThread],
    pub notes: List[MachCoreNote],
    pub images: List[MachCoreImage],
    pub low_bits: int,
    pub high_bits: int,
}

fn mc_uint(data: List[byte], mut c: Cursor, at: int, width: int) -> u64 ! MachCoreError {
    c.pos = at
    let result = uint_le(data, mut c, width) else |failure| {
        if "{failure}" == "resource_limit" { return macho_core_resource_limit }
        return macho_core_truncated
    }
    result
}

fn mc_charge(mut c: Cursor) -> () ! MachCoreError {
    if c.fuel < 1 { return macho_core_resource_limit }
    c.fuel -= 1
}

/// A fixed-size name field: the bytes up to its first NUL, at most size.
fn mc_name(data: List[byte], at: int, size: int) -> ByteSpan {
    var len: int = 0
    while len < size && data[at + len] as int != 0 { len += 1 }
    ByteSpan { start: at, length: len }
}

/// Whether span's bytes are text.
pub fn macho_core_name_is(data: List[byte], span: ByteSpan, text: str) -> bool {
    let want = text.bytes()
    if want.len != span.length { return false }
    var i: int = 0
    while i < want.len {
        if data[span.start + i] != want[i] { return false }
        i += 1
    }
    true
}

/// [offset, offset + size) inside [lo, hi), as an index.
fn mc_inside(offset: u64, size: u64, lo: u64, hi: u64) -> bool {
    offset >= lo && offset <= hi && size <= hi - offset
}

/// One LC_THREAD's flavours, walked as (flavour, count) pairs each followed by count 32-bit words.
fn mc_thread(
    data: List[byte],
    mut c: Cursor,
    at: int,
    size: int,
    caps: MachCoreCaps,
) -> MachCoreThread ! MachCoreError {
    var t = MachCoreThread { regs: [], far: 0, esr: 0, exception: 0 }
    var k: int = at + 8
    let end = at + size
    var flavours: int = 0
    while k < end {
        mc_charge(mut c)?
        if end - k < 8 { return macho_core_invalid_thread }
        let flavour = mc_uint(data, mut c, k, 4)?
        let count = mc_uint(data, mut c, k + 4, 4)?
        if flavours >= caps.flavours { return macho_core_resource_limit }
        if count > caps.flavour_words as u64 { return macho_core_resource_limit }
        let words = k + 8
        if count * 4 > (end - words) as u64 { return macho_core_invalid_thread }
        if flavour == macho_core_thread_state64 as u64 {
            if count != macho_core_thread_state64_count as u64 || t.regs.len > 0 { return macho_core_invalid_thread }
            var r: int = 0
            while r < 33 {
                let v = mc_uint(data, mut c, words + 8 * r, 8)?
                (mut t.regs).push(v)
                r += 1
            }
            let cpsr = mc_uint(data, mut c, words + macho_core_state_cpsr, 4)?
            (mut t.regs).push(cpsr)
        } else if flavour == macho_core_exception_state64 as u64 {
            if count != macho_core_exception_state64_count as u64 { return macho_core_invalid_thread }
            t.far = mc_uint(data, mut c, words + macho_core_exception_far, 8)?
            t.esr = mc_uint(data, mut c, words + macho_core_exception_esr, 4)?
            t.exception = mc_uint(data, mut c, words + macho_core_exception_exception, 4)?
        }
        flavours += 1
        k = words + count as int * 4 - 4
    }
    if t.regs.len == 0 { return macho_core_invalid_thread }
    t
}

/// `all image infos`: the images, each inside the note's payload.
fn mc_images(
    data: List[byte],
    mut c: Cursor,
    n: MachCoreNote,
    caps: MachCoreCaps,
) -> List[MachCoreImage] ! MachCoreError {
    let lo = n.offset
    let hi = n.offset + n.size
    if n.size < macho_core_images_header as u64 { return macho_core_invalid_note }
    let at = n.offset as int
    let version = mc_uint(data, mut c, at, 4)?
    let count = mc_uint(data, mut c, at + 4, 4)?
    let entries = mc_uint(data, mut c, at + 8, 8)?
    let entry_size = mc_uint(data, mut c, at + 16, 4)?
    if version != 1 || entry_size != macho_core_image_entry as u64 { return macho_core_invalid_note }
    if count > caps.images as u64 { return macho_core_resource_limit }
    if !mc_inside(entries, count * entry_size, lo, hi) { return macho_core_invalid_note }
    var out: List[MachCoreImage] = []
    var i: int = 0
    while i < count as int {
        mc_charge(mut c)?
        let e = entries as int + i * macho_core_image_entry
        let path_at = mc_uint(data, mut c, e, 8)?
        let load = mc_uint(data, mut c, e + 24, 8)?
        let segs_at = mc_uint(data, mut c, e + 32, 8)?
        let nsegs = mc_uint(data, mut c, e + 40, 4)?
        let flag = mc_uint(data, mut c, e + 44, 4)?
        if !mc_inside(path_at, 0, lo, hi) || path_at == hi { return macho_core_invalid_note }
        var len: int = 0
        while path_at + len as u64 < hi && data[path_at as int + len] as int != 0 {
            mc_charge(mut c)?
            if len >= caps.path_bytes { return macho_core_resource_limit }
            len += 1
        }
        if path_at + len as u64 >= hi { return macho_core_invalid_note }
        if nsegs > caps.image_segments as u64 { return macho_core_resource_limit }
        if !mc_inside(segs_at, nsegs * macho_core_image_segment_entry as u64, lo, hi) { return macho_core_invalid_note }
        var segs: List[MachCoreImageSegment] = []
        var k: int = 0
        while k < nsegs as int {
            mc_charge(mut c)?
            let s = segs_at as int + k * macho_core_image_segment_entry
            let vmaddr = mc_uint(data, mut c, s + 16, 8)?
            (mut segs).push(MachCoreImageSegment { name: mc_name(data, s, 16), vmaddr: vmaddr })
            k += 1
        }
        (mut out).push(MachCoreImage {
            path: ByteSpan { start: path_at as int, length: len },
            uuid: ByteSpan { start: e + 8, length: 16 },
            load: load,
            flag: flag,
            segments: segs,
        })
        i += 1
    }
    out
}

/// Read a little-endian arm64 MH_CORE within caps: its segments, threads and notes, the image list of its
/// `all image infos` note and the addressable bits of its `addrable bits` note.
pub fn macho_core_read(data: List[byte], caps: MachCoreCaps) -> MachCoreFile ! MachCoreError {
    if caps.work < 0 || caps.work > 100000000 { return macho_core_resource_limit }
    if data.len < 4 { return macho_core_truncated }
    var c = cursor(0, data.len, caps.work)
    let magic = mc_uint(data, mut c, 0, 4)?
    if magic != macho_core_mh_magic_64 as u64 { return macho_core_bad_magic }
    if data.len < macho_core_header_size { return macho_core_truncated }
    let cpu = mc_uint(data, mut c, macho_core_header_cputype, 4)?
    let subtype = mc_uint(data, mut c, macho_core_header_cpusubtype, 4)?
    // arm64e programs sign their pointers: a new measurement before this reader accepts their cores
    if cpu != macho_core_cpu_type_arm64 as u64 || subtype & 16777215 > 1 { return macho_core_unsupported_cpu }
    let filetype = mc_uint(data, mut c, macho_core_header_filetype, 4)?
    if filetype != macho_core_mh_core as u64 { return macho_core_not_core }
    let ncmds = mc_uint(data, mut c, macho_core_header_ncmds, 4)?
    let sizeofcmds = mc_uint(data, mut c, macho_core_header_sizeofcmds, 4)?
    if ncmds > caps.commands as u64 || sizeofcmds > caps.commands_bytes as u64 { return macho_core_resource_limit }
    if sizeofcmds > (data.len - macho_core_header_size) as u64 { return macho_core_truncated }
    let end = macho_core_header_size + sizeofcmds as int
    let bound = data.len as u64
    var core = MachCoreFile { segments: [], threads: [], notes: [], images: [], low_bits: 0, high_bits: 0 }
    var at: int = macho_core_header_size
    var i: int = 0
    while i < ncmds as int {
        mc_charge(mut c)?
        if end - at < 8 { return macho_core_invalid_command }
        let cmd = mc_uint(data, mut c, at, 4)?
        let size = mc_uint(data, mut c, at + 4, 4)?
        if size < 8 || size % 4 != 0 || size > (end - at) as u64 { return macho_core_invalid_command }
        if cmd == macho_core_lc_segment_64 as u64 {
            if size < macho_core_segment_size as u64 { return macho_core_invalid_command }
            let vmaddr = mc_uint(data, mut c, at + macho_core_segment_vmaddr, 8)?
            let vmsize = mc_uint(data, mut c, at + macho_core_segment_vmsize, 8)?
            let fileoff = mc_uint(data, mut c, at + macho_core_segment_fileoff, 8)?
            let filesize = mc_uint(data, mut c, at + macho_core_segment_filesize, 8)?
            let initprot = mc_uint(data, mut c, at + macho_core_segment_initprot, 4)?
            if !mc_inside(fileoff, filesize, 0, bound) || filesize > vmsize { return macho_core_invalid_segment }
            if vmsize > 18446744073709551615 - vmaddr { return macho_core_invalid_segment }
            if core.segments.len >= caps.segments { return macho_core_resource_limit }
            (mut core.segments).push(MachCoreSegment {
                vmaddr: vmaddr,
                vmsize: vmsize,
                fileoff: fileoff,
                filesize: filesize,
                initprot: initprot as int,
            })
        } else if cmd == macho_core_lc_thread as u64 {
            if core.threads.len >= caps.threads { return macho_core_resource_limit }
            let t = mc_thread(data, mut c, at, size as int, caps)?
            (mut core.threads).push(t)
        } else if cmd == macho_core_lc_note as u64 {
            if size < macho_core_note_size as u64 { return macho_core_invalid_command }
            let offset = mc_uint(data, mut c, at + macho_core_note_offset, 8)?
            let payload = mc_uint(data, mut c, at + macho_core_note_payload_size, 8)?
            if !mc_inside(offset, payload, 0, bound) { return macho_core_invalid_note }
            if core.notes.len >= caps.notes { return macho_core_resource_limit }
            (mut core.notes).push(MachCoreNote {
                owner: mc_name(data, at + macho_core_note_owner, macho_core_note_owner_size),
                offset: offset,
                size: payload,
            })
        }
        at += size as int
        i += 1
    }
    var k: int = 0
    while k < core.notes.len {
        let n = copy core.notes[k]
        if macho_core_name_is(data, n.owner, "all image infos") {
            core.images = mc_images(data, mut c, n, caps)?
        } else if macho_core_name_is(data, n.owner, "addrable bits") {
            if n.size < 12 { return macho_core_invalid_note }
            let low = mc_uint(data, mut c, n.offset as int + 4, 4)?
            let high = mc_uint(data, mut c, n.offset as int + 8, 4)?
            if low > 64 || high > 64 { return macho_core_invalid_note }
            core.low_bits = low as int
            core.high_bits = high as int
        }
        k += 1
    }
    core
}

/// The index of the segment whose file bytes hold [addr, addr + n), or -1.
pub fn macho_core_segment_of(core: MachCoreFile, addr: u64, n: u64) -> int {
    var i: int = 0
    while i < core.segments.len {
        let s = copy core.segments[i]
        if addr >= s.vmaddr && addr - s.vmaddr < s.filesize && n <= s.filesize - (addr - s.vmaddr) { return i }
        i += 1
    }
    -1
}

/// The signal a thread's exception class means, as lldb names the stop: SIGTRAP (5) for a breakpoint (class 0x3c),
/// SIGSEGV (11) for a data or instruction abort from the program (0x24, 0x20); 0 for none (a thread in a system
/// call is class 0x15).
pub fn macho_core_signal(t: MachCoreThread) -> int {
    let class = t.esr >> 26
    if class == 60 { return 5 }
    if class == 36 || class == 32 { return 11 }
    0
}

/// The thread the core stopped in: the first whose exception class is a stop, else the first.
pub fn macho_core_stop_thread(core: MachCoreFile) -> int {
    var i: int = 0
    while i < core.threads.len {
        if macho_core_signal(copy core.threads[i]) != 0 { return i }
        i += 1
    }
    0
}
