//! member: false
// sniff-server's replies (Stop Reply Packets, General Query Packets, Target Description Format) and the protocol's
// signal numbers as the pinned gdbserver was measured to send them (tests/server-signals.tsv).
use server
use remote

fn none() -> List[remote.Annex] {
    let n: List[remote.Annex] = []
    n
}

fn signal_map_row() {
    // measured: SIGUSR1 (host 10) is 30, SIGBUS (7) is 10, SIGSYS (31) is 12, SIGSTOP (19) is 17, and SIGSTKFLT (16)
    // is 143, which gdb prints as `?, Unknown signal.`; SIGTRAP and SIGSEGV are the host's numbers
    let usr1 = server.protocol_signal(10) else |e| { print("FAIL server-signal-map {e}"); return }
    assert(usr1 == 30)
    let bus = server.protocol_signal(7) else { return }
    assert(bus == 10)
    let sys = server.protocol_signal(31) else { return }
    assert(sys == 12)
    let stop = server.protocol_signal(19) else { return }
    assert(stop == 17)
    let stkflt = server.protocol_signal(16) else { return }
    assert(stkflt == 143)
    let trap = server.protocol_signal(5) else { return }
    assert(trap == 5)
    let segv = server.protocol_signal(11) else { return }
    assert(segv == 11)
    // SIGKILL never stops; its number is the one an X reply carries (measured: X9)
    let kill = server.protocol_signal(9) else { return }
    assert(kill == 9)
    // a number the table does not hold is refused by name: none past 31, and 0 is no signal
    let past = server.protocol_signal(32)
    assert("{past}" == "unmeasured_signal")
    let zero = server.protocol_signal(0)
    assert("{zero}" == "unmeasured_signal")
    // the other way, for the client's C sig: the same table read back
    let back = server.host_signal(30) else |e| { print("FAIL server-signal-map host {e}"); return }
    assert(back == 10)
    let back_trap = server.host_signal(5) else { return }
    assert(back_trap == 5)
    let back_unknown = server.host_signal(143) else { return }
    assert(back_unknown == 16)
    let back_kill = server.host_signal(9) else { return }
    assert(back_kill == 9)
    let none = server.host_signal(99)
    assert("{none}" == "unmeasured_signal")
    print("PASS server-signal-map")
}

fn stop_reply_row() {
    // T AA, the stop's reason when it has one, then thread:TID; (Stop Reply Packets), the signal by its protocol number
    let usr1 = server.stop_reply(10, 1234, "", 0) else |e| { print("FAIL server-stop-reply {e}"); return }
    assert(usr1 == "T1ethread:4d2;")
    let sw = server.stop_reply(5, 1234, "swbreak", 0) else { return }
    assert(sw == "T05swbreak:;thread:4d2;")
    let w = server.stop_reply(5, 1234, "watch", 4210728) else { return }
    assert(w == "T05watch:404028;thread:4d2;")
    let rw = server.stop_reply(5, 1234, "rwatch", 4210728) else { return }
    assert(rw == "T05rwatch:404028;thread:4d2;")
    let aw = server.stop_reply(5, 1234, "awatch", 4210728) else { return }
    assert(aw == "T05awatch:404028;thread:4d2;")
    let unknown = server.stop_reply(16, 1234, "", 0) else { return }
    assert(unknown == "T8fthread:4d2;")
    let past = server.stop_reply(33, 1234, "", 0)
    assert("{past}" == "unmeasured_signal")
    print("PASS server-stop-reply")
}

fn end_replies_row() {
    // W AA for an exit status, X AA for the signal that ended the process (Stop Reply Packets): two hex digits, and no
    // multiprocess field, which the stub does not offer
    let three = server.exit_reply(3) else |e| { print("FAIL server-end-replies {e}"); return }
    assert(three == "W03")
    let top = server.exit_reply(255) else { return }
    assert(top == "Wff")
    let over = server.exit_reply(256)
    assert("{over}" == "bad_status")
    let killed = server.killed_reply(9) else { return }
    assert(killed == "X09")
    let segv = server.killed_reply(11) else { return }
    assert(segv == "X0b")
    let usr1 = server.killed_reply(10) else { return }
    assert(usr1 == "X1e")
    let past = server.killed_reply(40)
    assert("{past}" == "unmeasured_signal")
    print("PASS server-end-replies")
}

fn supported_row() {
    // the stub features it offers (General Query Packets): packets up to 0x4000 bytes, its description, its thread
    // list with names, no-ack mode, the actions in vCont?'s reply, and the swbreak stop reason; nothing else (no
    // multiprocess, no Host I/O)
    let s = server.supported_reply() else |e| { print("FAIL server-supported {e}"); return }
    assert(s == "PacketSize=4000;qXfer:features:read+;qXfer:threads:read+;QStartNoAckMode+;vContSupported+;swbreak+")
    print("PASS server-supported")
}

fn description_row() {
    // the stub's own description, written from the Target Description Format and i386 Features nodes, read back by
    // sniff's own description reader: the i386 core complete, the SSE feature, fs_base and gs_base, and no AVX
    let text = server.description() else |e| { print("FAIL server-description {e}"); return }
    let d = remote.parse(text, none()) else |e| { print("FAIL server-description parse {e}"); return }
    assert(d.architecture == "i386:x86-64")
    assert(remote.missing_i386_core(d).len == 0)
    assert(d.features.len == 3)
    assert(d.features[0] == "org.gnu.gdb.i386.core")
    assert(d.features[1] == "org.gnu.gdb.i386.sse")
    assert(d.features[2] == "org.gnu.gdb.i386.segments")
    assert(remote.regnum_of(d, "rax") == 0)
    assert(remote.regnum_of(d, "rip") == 16)
    assert(remote.regnum_of(d, "xmm15") >= 0)
    assert(remote.regnum_of(d, "mxcsr") >= 0)
    assert(remote.regnum_of(d, "fs_base") >= 0)
    assert(remote.regnum_of(d, "gs_base") >= 0)
    assert(remote.regnum_of(d, "ymm0h") < 0)
    print("PASS server-description")
}

fn listen_row() {
    // the default is loopback: `:PORT` and `localhost:PORT` listen on 127.0.0.1, and 127.x.y.z is loopback; any other
    // HOST must be asked for by name (--non-loopback), because whoever connects controls the program
    let any = server.listen_address(":1234", false) else |e| { print("FAIL server-listen-address {e}"); return }
    assert(any.host == "127.0.0.1" && any.port == 1234)
    let named = server.listen_address("localhost:1234", false) else { return }
    assert(named.host == "127.0.0.1")
    let lo = server.listen_address("127.1.2.3:9", false) else { return }
    assert(lo.host == "127.1.2.3" && lo.port == 9)
    let open = server.listen_address("0.0.0.0:1234", false)
    assert("{open}" == "non_loopback_refused")
    let guest = server.listen_address("10.0.2.15:1234", false)
    assert("{guest}" == "non_loopback_refused")
    let asked = server.listen_address("0.0.0.0:1234", true) else { return }
    assert(asked.host == "0.0.0.0" && asked.port == 1234)
    let no_port = server.listen_address("1234", false)
    assert("{no_port}" == "bad_address")
    let zero = server.listen_address(":0", false)
    assert("{zero}" == "bad_address")
    let past = server.listen_address(":65536", false)
    assert("{past}" == "bad_address")
    let six = server.listen_address("[::1]:1234", true)
    assert("{six}" == "bad_address")
    print("PASS server-listen-address")
}

fn requests_row() {
    // each request's kind and fields (Packets, General Query Packets); anything else is the empty reply's
    let m = server.request("m401000,4".bytes()) else |e| { print("FAIL server-requests {e}"); return }
    assert(m.kind == server.req_read && m.addr == 4198400 && m.len == 4)
    let w = server.request("M401000,2:cc90".bytes()) else { return }
    assert(w.kind == server.req_write && w.len == 2 && w.data[0] as int == 204 && w.data[1] as int == 144)
    let z = server.request("Z0,401136,1".bytes()) else { return }
    assert(z.kind == server.req_insert && z.num == 0 && z.addr == 4198710 && z.len == 1)
    let wz = server.request("z2,404028,4".bytes()) else { return }
    assert(wz.kind == server.req_remove && wz.num == 2 && wz.len == 4)
    let c = server.request("vCont;c".bytes()) else { return }
    assert(c.kind == server.req_resume && !c.step && c.sig == 0)
    let s = server.request("vCont;s:4d2;c".bytes()) else { return }
    assert(s.kind == server.req_resume && s.step && s.num == 1234)
    let sig = server.request("vCont;C1e:4d2;c".bytes()) else { return }
    assert(sig.kind == server.req_resume && !sig.step && sig.sig == 30 && sig.num == 1234)
    let plain = server.request("C0b".bytes()) else { return }
    assert(plain.kind == server.req_resume && plain.sig == 11)
    let q = server.request("vCont?".bytes()) else { return }
    assert(q.kind == server.req_vcont_query)
    let h = server.request("Hg4d2".bytes()) else { return }
    assert(h.kind == server.req_thread && h.annex == "g" && h.num == 1234)
    let alive = server.request("T4d2".bytes()) else { return }
    assert(alive.kind == server.req_alive && alive.num == 1234)
    let all = server.request("Hc-1".bytes()) else { return }
    assert(all.kind == server.req_thread && all.annex == "c" && all.num == -1)
    let p = server.request("p10".bytes()) else { return }
    assert(p.kind == server.req_reg && p.num == 16)
    let x = server.request("qXfer:features:read:target.xml:0,fff".bytes()) else { return }
    assert(x.kind == server.req_features && x.annex == "target.xml" && x.offset == 0 && x.len == 4095)
    let sup = server.request("qSupported:multiprocess+;swbreak+;vContSupported+".bytes()) else { return }
    assert(sup.kind == server.req_supported)
    let no_ack = server.request("QStartNoAckMode".bytes()) else { return }
    assert(no_ack.kind == server.req_no_ack)
    let kill = server.request("vKill;4d2".bytes()) else { return }
    assert(kill.kind == server.req_kill)
    let empty = server.request("vMustReplyEmpty".bytes()) else { return }
    assert(empty.kind == server.req_unsupported)
    let th = server.request("qXfer:threads:read::0,fff".bytes()) else { return }
    assert(th.kind == server.req_threads_xfer && th.offset == 0 && th.len == 4095)
    let th_annex = server.request("qXfer:threads:read:x:0,fff".bytes())
    assert("{th_annex}" == "bad_request")
    let svr4 = server.request("qXfer:libraries-svr4:read::0,fff".bytes()) else { return }
    assert(svr4.kind == server.req_unsupported)
    let bad = server.request("m401000".bytes())
    assert("{bad}" == "bad_request")
    let stop = server.request("vCont;t".bytes())
    assert("{stop}" == "bad_request")
    print("PASS server-requests")
}

fn threads_xml_row() {
    // Thread List Format: each thread by its id in hex, with its name where it has one, the name's markup escaped
    let none: List[int] = []
    let no_names: List[str] = []
    assert(server.threads_xml(none, no_names) == "<?xml version=\"1.0\"?>\n<threads>\n</threads>\n")
    let x = server.threads_xml([1234, 1235], ["prog", ""])
    assert(x == "<?xml version=\"1.0\"?>\n<threads>\n<thread id=\"4d2\" name=\"prog\"/>\n<thread id=\"4d3\"/>\n</threads>\n")
    let odd = server.threads_xml([1], ["a<b&\"c\">"])
    assert(odd == "<?xml version=\"1.0\"?>\n<threads>\n<thread id=\"1\" name=\"a&lt;b&amp;&quot;c&quot;&gt;\"/>\n</threads>\n")
    print("PASS server-threads-xml")
}

fn fxsave(swd: int, ftw: int) -> List[byte] {
    var b: List[byte] = []
    var i: int = 0
    while i < 512 { (mut b).push(0 as byte); i += 1 }
    b[2] = (swd & 255) as byte
    b[3] = ((swd >> 8) & 255) as byte
    b[4] = ftw as byte
    b
}

fn x87_tag_row() {
    // the Intel SDM's FXSAVE: the abridged byte, one bit a register (0 empty), and the full word, two bits a register
    // in physical order (00 valid, 01 zero, 10 special, 11 empty), its classes from each register's value (Table 1-41)
    assert(server.x87_full_tag(fxsave(0, 0)) == 65535)
    assert(server.x87_abridged_tag(65535) == 0)
    assert(server.x87_abridged_tag(16383) == 128)
    // R7 in use and holding zero (exponent and significand all zero): its tag is zero, 01
    assert(server.x87_full_tag(fxsave(0, 128)) == 32767)
    // one value pushed (TOP 7): ST0 is R7, and 1.0 (exponent 0x3fff, the J bit set) is valid, 00
    var one = fxsave(7 << 11, 128)
    one[39] = 128 as byte
    one[40] = 255 as byte
    one[41] = 63 as byte
    assert(server.x87_full_tag(one) == 16383)
    // an infinity (exponent all ones) is special, 10
    var inf = fxsave(7 << 11, 128)
    inf[39] = 128 as byte
    inf[40] = 255 as byte
    inf[41] = 127 as byte
    assert(server.x87_full_tag(inf) == 49151)
    // a denormal (exponent zero, a nonzero significand) is special too
    var den = fxsave(7 << 11, 128)
    den[32] = 1 as byte
    assert(server.x87_full_tag(den) == 49151)
    // too short to be an FXSAVE area: every register empty
    let short: List[byte] = []
    assert(server.x87_full_tag(short) == 65535)
    print("PASS server-x87-tag")
}

fn main() {
    signal_map_row()
    stop_reply_row()
    end_replies_row()
    supported_row()
    description_row()
    listen_row()
    requests_row()
    threads_xml_row()
    x87_tag_row()
}
