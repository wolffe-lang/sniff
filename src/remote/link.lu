// The transport: one TCP connection to a stub (Connecting: `target remote HOST:PORT`), carrying the
// packet layer's frames with its acknowledgments, resends and reply time (Overview, Packet
// Acknowledgment), and the interrupt byte (Interrupts). Bytes read but not yet scanned stay in the
// link between calls, so a reply that arrives with its acknowledgment is never lost. The socket is held as
// its descriptor (the `[os.net]` builtins std.net wraps), so a link is a plain value: `ask` serves a
// stopped target's reads from a borrowed link, with no exclusive access to the session.

/// Refusals of the transport: the socket's own, and the packet layer's, each by name.
pub error LinkError = {
    refused,
    timeout,
    closed,
    io,
    invalid,
    packet_too_long,
    reply_too_long,
    unescaped_byte,
    bad_hex,
    bad_escape,
    bad_run_length,
    notification_refused,
    resend_limit,
    reply_timeout,
}

/// One connection: its socket's descriptor, its acknowledgment state, the bytes read and not yet
/// scanned, the milliseconds it waits for an acknowledgment or a reply (reply_ms; a unit row sets
/// less), and the most data it sends in one packet.
pub struct Link {
    pub fd: int,
    pub ack: Ack,
    pub pending: List[byte],
    pub wait_ms: int,
    pub cap: int,
}

/// Connect to ADDR (`HOST:PORT`): a connection nobody answers is `refused`.
pub fn open(addr: str) -> Link ! LinkError {
    let fd = net_connect(addr)?
    let none: List[byte] = []
    Link { fd: fd, ack: ack_state(), pending: none, wait_ms: reply_ms, cap: send_cap_floor }
}

/// Close the connection, sending nothing (Connecting: `disconnect`).
pub fn shut(l: Link) -> () ! LinkError {
    net_close(l.fd)?
}

fn drop_front(mut l: Link, n: int) {
    var rest: List[byte] = []
    var i = n
    while i < l.pending.len { (mut rest).push(l.pending[i]); i += 1 }
    l.pending = rest
}

/// Read one byte within ms (no limit when ms <= 0) onto the pending bytes. Returns false when the time
/// passed with nothing read. One byte at a time, so a link never holds bytes past the packet it is
/// reading: once a reply is read nothing is pending, and a borrowed link (`ask`) starts where it is.
fn fill(mut l: Link, ms: int) -> bool ! LinkError {
    net_deadline(l.fd, ms)?
    let got = net_read_bytes(l.fd, 1) else |e| match e {
        timeout => {
            return false
        },
        closed => {
            return closed
        },
        io => {
            return io
        },
    }
    for x in got { (mut l.pending).push(x) }
    true
}

/// Whether the pending bytes can be scanned: a byte outside a packet, or a packet's `#` and its two
/// checksum digits (`#` never appears in a packet's data: Overview). A packet is scanned once, when
/// whole, not once a byte.
fn ready(l: Link) -> bool {
    if l.pending.len == 0 { return false }
    if l.pending[0] as int != 36 { return true }
    l.pending.len >= 4 && l.pending[l.pending.len - 3] as int == 35
}

/// The next acknowledgment: 1 for `+`, 2 for `-`, 0 when wait_ms passed without one. A packet that
/// comes first is left pending and counts as `+`. Bytes outside any packet are skipped.
fn next_ack(mut l: Link) -> int ! LinkError {
    var more = true
    while more {
        var looking = true
        while looking && ready(l) {
            let sc = scan(l.pending, 0)?
            if sc.kind == scan_need {
                looking = false
            } else if sc.kind == scan_packet {
                return 1
            } else {
                drop_front(mut l, sc.used)
                if sc.kind == scan_ack { return 1 }
                if sc.kind == scan_nack { return 2 }
            }
        }
        more = fill(mut l, l.wait_ms)?
    }
    0
}

/// Send one packet. With acknowledgments on, wait for `+`; after a `-`, or wait_ms with nothing, send
/// it again, at most resend_cap times; then the command fails with resend_limit.
pub fn send(mut l: Link, data: str) -> () ! LinkError {
    let f = frame(data, l.cap)?
    net_write_bytes(l.fd, f)?
    if !wants_ack(l.ack) { return }
    var waiting = true
    while waiting {
        let got = next_ack(mut l)?
        if got == 1 {
            acked(mut l.ack)
            waiting = false
        } else {
            resend(mut l.ack)?
            net_write_bytes(l.fd, f)?
        }
    }
}

/// The next packet's data as framed (escapes and runs not yet undone), acknowledged with `+`; one with
/// a wrong checksum is answered `-` and waited for again, at most resend_cap times. ms <= 0 waits with
/// no limit (a stop reply after a resumption); otherwise ms passing is reply_timeout.
pub fn receive(mut l: Link, ms: int) -> List[byte] ! LinkError {
    var bad: int = 0
    var more = true
    while more {
        var looking = true
        while looking && ready(l) {
            let sc = scan(l.pending, 0)?
            if sc.kind == scan_need {
                looking = false
            } else {
                drop_front(mut l, sc.used)
                if sc.kind == scan_packet {
                    if sc.sum_ok || !wants_ack(l.ack) {
                        if wants_ack(l.ack) { net_write_bytes(l.fd, [43 as byte])? }
                        return sc.data
                    }
                    if bad >= resend_cap { return resend_limit }
                    bad += 1
                    net_write_bytes(l.fd, [45 as byte])?
                }
            }
        }
        more = fill(mut l, ms)?
    }
    reply_timeout
}

/// Send a packet and return its reply's data with runs expanded (a text or hex reply).
pub fn request(mut l: Link, data: str) -> List[byte] ! LinkError {
    send(mut l, data)?
    let raw = receive(mut l, l.wait_ms)?
    decode(raw, false)?
}

/// Send a packet and return its reply's data with runs expanded and escapes undone (binary data, as in
/// qXfer's replies).
pub fn request_binary(mut l: Link, data: str) -> List[byte] ! LinkError {
    send(mut l, data)?
    let raw = receive(mut l, l.wait_ms)?
    decode(raw, true)?
}

/// Write the interrupt byte 0x03, outside any packet (Interrupts).
pub fn interrupt(l: Link) -> () ! LinkError {
    net_write_bytes(l.fd, interrupt_byte())?
}

/// A request from a borrowed link: send DATA and return its reply, as `request` (or `request_binary`)
/// does, with acknowledgment counts of its own. For a stopped target, where nothing else is in flight
/// and nothing is pending (fill reads one byte at a time).
pub fn ask(l: Link, data: str, binary: bool) -> List[byte] ! LinkError {
    let none: List[byte] = []
    var x = Link { fd: l.fd, ack: Ack { no_ack: l.ack.no_ack, resends: 0 }, pending: none, wait_ms: l.wait_ms, cap: l.cap }
    if binary { return request_binary(mut x, data)? }
    request(mut x, data)?
}
