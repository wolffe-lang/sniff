#!/usr/bin/env bash
# The digest-bound SMP kernel rows: six judged sessions and one explicitly unjudged observation.
# tools/gate-remote-smp PAXTREE KERNEL.elf IMAGE.iso QEMU SNIFF OUTDIR
set -uo pipefail
[ "$#" = 6 ] || { printf 'usage: gate-remote-smp PAXTREE KERNEL IMAGE QEMU SNIFF OUTDIR\n'; exit 2; }
root=$(cd "$(dirname "$0")/.." && pwd)
pax=$1 kernel=$2 image=$3 qemu=$4 sniff=$5 out=$6
mkdir -p "$out"
rc=0
source "$root/tools/gate-remote"
step remote-smp-harness-unit python3 -I "$root/tests/test_remote_smp.py"
gdb=$(command -v gdb || true)
step remote-smp-oracle-pin python3 -I - "$root/sniff-oracle.toml" "$gdb" <<'PY'
import hashlib, subprocess, sys, tomllib
from pathlib import Path
try:
    want=tomllib.loads(Path(sys.argv[1]).read_text())['gdb']['sha256']
    p=Path(sys.argv[2]).resolve()
    got=hashlib.sha256(p.read_bytes()).hexdigest()
    if got != want:
        raise ValueError('gdb digest differs from pin')
    version=subprocess.run([str(p),'--version'],capture_output=True,text=True,check=True,timeout=30).stdout.splitlines()[0]
    print('PASS remote-smp-oracle-pin gdb=%r sha256=%s' % (version,got))
except (OSError, ValueError, IndexError, subprocess.SubprocessError) as e:
    print('FAIL remote-smp-oracle-pin input: '+str(e))
    raise SystemExit(1)
PY
[ "$rc" = 0 ] || exit "$rc"
common=(--kernel "$kernel" --image "$image" --pax "$pax" --qemu "$qemu" --rows "$root/tests/remote-smp-rows.json")
for accel in kvm tcg; do
    kernel_step "$accel" "remote-smp-oracle-$accel" python3 -I "$root/tools/session-remote.py" gdb-check "${common[@]}" --gdb "$gdb" --accel "$accel" --out "$out/oracle-$accel"
    kernel_step "$accel" "remote-smp-$accel" python3 -I "$root/tools/session-remote.py" check "${common[@]}" --sniff "$sniff" --accel "$accel" --out "$out/sniff-$accel"
done
exit "$rc"
