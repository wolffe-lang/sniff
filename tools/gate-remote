#!/usr/bin/env bash
# The S8 kernel rows on the record host: sniff over QEMU's gdbstub on PAX's console image at one processor, held to
# the pinned gdb's goldens, under KVM and then under TCG as a step of its own, so both accelerators' answers are on
# record by name. Every END is a real child exit.
#   tools/gate-remote PAXTREE KERNEL.elf IMAGE.iso QEMU SNIFF OUTDIR SERVER-IMAGE FIXTURES
# SERVER-IMAGE is tools/gate-pax's server-image (sniff-server's PAX rows), booted once under KVM; FIXTURES are the static
# session fixtures, for gdb on this host and for the pinned gdbserver on Linux, the rows' oracle.
# Sourced (the harness units), it defines its step functions over the caller's $out and $rc and runs nothing.
set -uo pipefail
step() { # name cmd...: what it passes on to the record is also kept in $out/NAME.passed
  local name=$1 start=$SECONDS r=0; shift
  printf 'START %s\n' "$name"
  "$@" > "$out/$name.log" 2>&1 || r=$?
  # ORACLES names gdbserver and gdb by version and digest; IMAGE the server rows' image, its stub and its kernel
  grep -E '^(PASS|FAIL|SKIP|OWN|QEMU version=|ORACLES|IMAGE|remote rows)' "$out/$name.log" |
    sed -E 's/^(PASS|SKIP|OWN|QEMU version=|ORACLES|IMAGE|remote rows)/  \1/' | tee "$out/$name.passed"
  printf 'END %s exit=%s secs=%s\n' "$name" "$r" "$((SECONDS-start))"
  [ "$r" = 0 ] || rc=1
}
kernel_step() { # accel name cmd...: a step of kernel rows, which must pass on its QEMU line for that accelerator
  local accel=$1; shift
  step "$@"
  grep -q -E "^  QEMU version=.* accel=$accel( |\$)" "$out/$1.passed" ||
    { echo "FAIL remote-qemu-line accel=$accel (step $1 passed on no QEMU line for its accelerator)"; rc=1; }
}
[ "${BASH_SOURCE[0]}" = "$0" ] || return 0
[ $# -eq 8 ] || { echo 'usage: gate-remote PAXTREE KERNEL IMAGE QEMU SNIFF OUTDIR SERVER-IMAGE FIXTURES'; exit 2; }
root=$(cd "$(dirname "$0")/.." && pwd)
pax=$1 kernel=$2 image=$3 qemu=$4 sniff=$5 out=$6 server_image=$7 fixtures=$8
mkdir -p "$out"
rc=0
step remote-identity bash -c 'echo "PASS remote-identity kernel_sha256=$(sha256sum "$0" | cut -c1-64) image_sha256=$(sha256sum "$1" | cut -c1-64) qemu=$("$2" --version | head -1)"' "$kernel" "$image" "$qemu"
step remote-harness-unit python3 -I "$root/tools/session-remote.py" selftest
kernel_step kvm remote-kernel-kvm python3 -I "$root/tools/session-remote.py" check --kernel "$kernel" --image "$image" --pax "$pax" --qemu "$qemu" --sniff "$sniff" --accel kvm --out "$out/kvm"
kernel_step tcg remote-kernel-tcg python3 -I "$root/tools/session-remote.py" check --kernel "$kernel" --image "$image" --pax "$pax" --qemu "$qemu" --sniff "$sniff" --accel tcg --out "$out/tcg"
kernel_step kvm remote-server-pax python3 -I "$root/tools/session-remote.py" server-pax --image "$server_image" --pax "$pax" --kernel "$kernel" --qemu "$qemu" --fixtures "$fixtures" --accel kvm --out "$out/server-pax"
exit "$rc"
