#!/usr/bin/env bash
# Every END is a real child exit, including pipeline-independent failures.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"
mode=${1:-unit}
mkdir -p target/gate target/home target/tmp
export HOME="$root/target/home"
export XDG_CACHE_HOME="$HOME/cache"
export XDG_CONFIG_HOME="$HOME/config"
export TMPDIR="$root/target/tmp"
export LC_ALL=C TZ=UTC TERM=dumb
source "$root/tools/gate-steps.sh"
step pin-metadata python3 -I tools/check-pins.py
step harness-unit python3 -I tests/test_harness.py
step census-unit python3 -I tests/test_census.py
step symbol-oracle-unit python3 -I tests/test_symbol_oracle.py
step gate-switch-unit python3 -I tests/test_gate_switch.py
step reader-runner-unit python3 -I tests/test_reader_runner.py
step tier-planner python3 -I ci/tiers-test.py
step session-harness-unit python3 -I tests/test_session.py
step session-rows-inventory python3 -I tools/session.py verify
step pax-rows-inventory python3 -I tools/session.py --set pax verify
step pax-harness-unit python3 -I tools/session-pax.py selftest
step abi-constants python3 -I tools/check-abi.py check
for platform in macos linux; do
  if [ -f "tests/evidence/$platform-session/record.json" ]; then
    step "$platform-replay" python3 -I tools/transcript.py compare "tests/evidence/$platform-session/expected.json" "tests/evidence/$platform-session/record.json"
    step "$platform-mutations" python3 -I tools/transcript.py selftest "tests/evidence/$platform-session/expected.json" "tests/evidence/$platform-session/record.json"
    step "$platform-values" python3 -I tools/value-join.py --session "tests/evidence/$platform-session/record.json" --values "tests/evidence/$platform/values.json"
  fi
done
[ "$mode" != unit ] || exit 0
case "$mode" in macos|linux) ;; *) echo 'FAIL gate-mode'; exit 2 ;; esac
oracle_step symbol-oracle-pin python3 -I tools/check-symbol-oracle.py --platform "$mode"
stage=${SNIFF_TOOLCHAIN_DIR:-$root/.wolf-bin}
fetch=(python3 -I tools/fetch-toolchain.py --out "$stage")
if [ -n "${SNIFF_ARCHIVES:-}" ]; then fetch+=(--archive-dir "$SNIFF_ARCHIVES"); fi
step toolchain "${fetch[@]}"
wolf=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["tools"]["wolf"]["root"]+"/wolf")' "$stage/manifest.json")
lupin=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["tools"]["lupin"]["root"]+"/lupin")' "$stage/manifest.json")
step reader-unit python3 -I tools/test-readers.py --wolf "$wolf"
step sniff-build "$wolf" build src/main.lu --no-cache -o "$root/target/sniff"
compilers=(clang)
[ "$mode" != linux ] || compilers+=(gcc)
step fixture-builds python3 -I tools/build-fixtures.py --wolf "$wolf" --out "$root/target/fixtures" --compilers "${compilers[@]}"
if [ "$mode" = linux ]; then
  seeds=(--seed target/fixtures/c/inlining/gcc-O2/prog --seed target/fixtures/c/threads/clang-O2/prog)
else
  seeds=(--seed target/fixtures/c/threads/clang-O2/prog.dSYM/Contents/Resources/DWARF/prog --seed target/fixtures/c/threads/clang-O2/prog)
fi
step hostile-inputs python3 -I tools/test-hostile.py --sniff "$root/target/sniff" "${seeds[@]}" --out "$root/target/hostile"
oracle_step dump-matrix python3 -I tools/dump-matrix.py --sniff "$root/target/sniff" --platform "$mode" --fixtures "$root/target/fixtures"
if [ "$mode" = macos ]; then
  dwarfdump=$(xcrun --find llvm-dwarfdump)
  debugger=$(xcrun --find lldb)
  oracle=lldb
  mkdir -p target/session
  cp target/fixtures/wolf/scalars/wolf-debug/prog target/session/prog
  rm -rf target/session/prog.dSYM
  cp -R target/fixtures/wolf/scalars/wolf-debug/prog.dSYM target/session/prog.dSYM
  oracle_dependent_step target-sign codesign --force --sign - --entitlements tests/get-task-allow.plist target/session/prog
  binary="$root/target/session/prog"
else
  dwarfdump=$(command -v llvm-dwarfdump-18)
  debugger=$(command -v gdb)
  oracle=gdb
  binary="$root/target/fixtures/wolf/scalars/wolf-debug/prog"
fi
oracle_step dwarf-census python3 -I tools/census.py capture --builds target/fixtures/builds.json --dwarfdump "$dwarfdump" --out target/census
oracle_step live-transcript python3 -I tools/transcript.py capture --spec tests/scalars-session.json --oracle "$oracle" --debugger "$debugger" --binary "$binary" --out target/session --root "$root"
oracle_dependent_step live-mutations python3 -I tools/transcript.py selftest target/session/expected.json target/session/record.json
step lupin-values python3 -I tools/lupin-values.py --lupin "$lupin" --out target/values
oracle_dependent_step true-value-join python3 -I tools/value-join.py --session target/session/record.json --values target/values/values.json
if [ "$mode" = linux ]; then
  # S2: the core on Linux x86-64. Every step below needs a Linux process and the pinned gdb
  # (the container's, not the macOS oracle that oracle_step guards).
  step session-fixtures python3 -I tools/build-session.py --wolf "$wolf" --out "$root/target/session-fixtures"
  step abi-probe-stable python3 -I tools/check-abi.py capture --compare
  step platform-live bash -c "'$wolf' build src/live_platform.lu --no-cache -o '$root/target/live_platform' && '$root/target/live_platform' '$root/target/session-fixtures/c/exits/gcc-O0/prog'"
  step session-oracle-stable python3 -I tools/session.py oracle
  step session-rows python3 -I tools/session.py check
  step session-lupin-join python3 -I tools/session-values.py --sniff "$root/target/sniff" --values target/values/values.json --fixtures "$root/target/session-fixtures"
  step session-expr-join python3 -I tools/session-exprs.py --sniff "$root/target/sniff" --values target/values/values.json --fixtures "$root/target/session-fixtures"
  step session-unwind-basis python3 -I tools/session-unwind.py --sniff "$root/target/sniff"
  step session-perf python3 -I tools/session-perf.py --sniff "$root/target/sniff"
  # S4: the same rows on the static builds PAX loads, held to the pinned gdb on those builds. Here sniff runs on
  # Linux; tools/gate-pax runs it on PAX under KVM (it needs the PAX tree, a kernel and QEMU, not this image).
  step pax-fixtures python3 -I tools/build-session.py --wolf "$wolf" --out "$root/target/pax-fixtures" --static
  find "$root/target/pax-fixtures" -type f -exec touch {} +
  step pax-rows-linux python3 -I tools/session.py --set pax check --sniff "$root/target/sniff" --fixtures "$root/target/pax-fixtures" --work "$root"
  step pax-sniff-static bash tools/build-static-sniff.sh "$wolf" "$root/target/sniff-static"
else
  # S3: the macOS arm64 backend. The rows need a task port and, for the oracle rows, the pinned lldb.
  step session-fixtures python3 -I tools/build-session.py --wolf "$wolf" --out "$root/target/session-fixtures"
  step platform-live bash -c "'$wolf' build src/live_platform.lu --no-cache -o '$root/target/live_platform' && '$root/target/live_platform' '$root/target/session-fixtures/c/exits/clang-O0/prog'"
  mkdir -p target/s3 target/s3u target/s3v target/s3p
  step macos-rows-inventory python3 -I tools/session-mac.py verify
  step macos-lldb-replay python3 -I tools/session-mac.py replay
  mac_live_step macos-rows bash -c "mkdir -p target/s3 && python3 -I tools/session-mac.py check --sniff '$root/target/sniff' --fixtures '$root/target/session-fixtures' --work '$root/target/s3'"
  mac_live_step bp-stress bash tools/bp-stress.sh "$root/target/sniff" "$root/target/session-fixtures" "$root/target/s3" 200
  mac_live_step session-lupin-join python3 -I tools/session-values.py --sniff "$root/target/sniff" --values target/values/values.json --fixtures "$root/target/session-fixtures" --work "$root/target/s3v" --cwd "$root"
  mac_live_step session-expr-join python3 -I tools/session-exprs.py --sniff "$root/target/sniff" --values target/values/values.json --fixtures "$root/target/session-fixtures" --work "$root/target/s3v" --cwd "$root"
  mac_live_step session-unwind-basis python3 -I tools/session-unwind.py --sniff "$root/target/sniff" --fixtures "$root/target/session-fixtures" --work "$root/target/s3u" --platform macos --cwd "$root"
  mac_live_step session-perf python3 -I tools/session-perf.py --sniff "$root/target/sniff" --lldb "$debugger" --fixtures "$root/target/session-fixtures" --work "$root/target/s3p" --cwd "$root"
fi
