{
  "about": "Four-CPU remote sessions over the recorded SMP kernel. Every row fixes its CPU count; input s8b binds the kernel, image and source declarations to s8b-prediction.json. The AP condition is derived from that source. CPU identity, registers and frames are compared literally. The reconnect row runs at reset because another processor's incidental start-up frame is not a debugger discrepancy.",
  "rows": [
    {"name": "remote-smp1-threads", "smp": 1, "input": "s8b", "script": ["target remote 127.0.0.1:@PORT@", "info threads", "kill"]},
    {"name": "remote-smp4-threads", "smp": 4, "input": "s8b", "script": ["target remote 127.0.0.1:@PORT@", "info threads", "kill"]},
    {"name": "remote-smp4-select", "smp": 4, "input": "s8b", "script": ["target remote 127.0.0.1:@PORT@", "stepi", "info threads", "thread 2", "info registers rip cs gs_base", "thread 1", "info registers rip cs gs_base", "thread 4", "thread 3", "thread 5", "thread", "kill"]},
    {"name": "remote-smp4-ap-break", "capture_boots": 5, "smp": 4, "input": "s8b", "script": ["target remote 127.0.0.1:@PORT@", "hbreak kmain", "continue", "delete", "break pax_ap_main if rec == @AP_RECORD@", "continue", "thread", "info registers rip rsp rbp gs_base", "bt 1", "kill"]},
    {"name": "remote-smp4-step-selected", "capture_boots": 5, "smp": 4, "input": "s8b", "script": ["target remote 127.0.0.1:@PORT@", "hbreak kmain", "continue", "delete", "break pax_ap_main if rec == @AP_RECORD@", "continue", "stepi", "thread", "info registers rip rsp rbp gs_base", "bt 1", "kill"]},
    {"name": "remote-smp4-reconnect", "capture_boots": 5, "smp": 4, "input": "s8b", "script": ["target remote 127.0.0.1:@PORT@", "stepi", "thread 2", "disconnect", "target remote 127.0.0.1:@PORT@", "info threads", "thread", "info registers rip cs gs_base", "kill"]},
    {"name": "remote-smp4-reconnect-startup", "smp": 4, "input": "s8b", "observe": true, "script": ["target remote 127.0.0.1:@PORT@", "hbreak kmain", "continue", "delete", "break pax_ap_main if rec == @AP_RECORD@", "continue", "disconnect", "target remote 127.0.0.1:@PORT@", "info threads", "thread", "kill"]}
  ]
}
