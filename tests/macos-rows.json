  {
   "name": "step-clang-calls",
   "kind": "linux",
   "script": [
    "break main",
    "run",
    "step",
    "step",
    "bt",
    "step",
    "step",
    "next",
    "bt",
    "finish",
    "finish",
    "next",
    "step",
    "next",
    "next",
    "until",
    "until",
    "until",
    "until",
    "until",
    "info locals",
    "next",
    "next"
   ],
   "drop": [
    {
     "match": "^15\\t    \\}$",
     "why": "arm64 clang gives the loop body's closing brace its own line-table row; until goes forward to it (lldb next does too: lldb-until-loop)"
    },
    {
     "match": "^0xA in \\?\\? \\(\\)( from .*)?$",
     "why": "the caller of main: Linux names libc ('??' from libc.so.6), lldb names dyld`start; sniff does not symbolicate system images until S6"
    }
   ]
  },
