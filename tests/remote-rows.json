{
 "about": "S8's kernel rows (tools/session-remote.py): one boot of PAX's console image each, at one processor, frozen at reset; the pinned gdb's transcript under KVM is the golden",
 "rows": [
  {
   "name": "remote-kernel-connect",
   "script": [
    "target remote 127.0.0.1:@PORT@",
    "info threads",
    "kill"
   ]
  },
  {
